{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kl.dev/schemas/plugin/manifest-v1.schema.json",
  "title": "KL sidecar plugin manifest v1",
  "type": "object",
  "required": ["id", "version", "api", "kind", "entrypoint"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "version": { "type": "string" },
    "api": { "const": 1 },
    "kind": { "enum": ["provider", "tool"] },
    "entrypoint": { "type": "string" },
    "runtime": { "const": "sidecar" },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "permissions": {
      "type": "object",
      "properties": {
        "network": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "array", "items": { "type": "string" } },
        "fs_read": { "type": "array", "items": { "type": "string" } },
        "fs_write": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "tool_name": { "type": "string" },
    "tool_parameters": { "type": "object" },
    "models": { "type": "array", "items": { "type": "string" } },
    "config_path": { "type": "string" },
    "health_timeout_ms": { "type": "integer", "minimum": 100 },
    "drain_timeout_ms": { "type": "integer", "minimum": 100 }
  },
  "additionalProperties": false
}
