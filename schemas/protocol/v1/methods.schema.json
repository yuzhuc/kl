{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kl.dev/schemas/protocol/v1/methods.schema.json",
  "title": "KL protocol v1 method payloads",
  "$defs": {
    "handshakeParams": {
      "type": "object",
      "required": ["client_name", "client_version", "protocol_versions"],
      "properties": {
        "client_name": { "type": "string" },
        "client_version": { "type": "string" },
        "protocol_versions": { "type": "array", "items": { "type": "integer" } },
        "features": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "handshakeResult": {
      "type": "object",
      "required": [
        "server_name",
        "server_version",
        "protocol_version",
        "min_protocol_version",
        "features"
      ],
      "properties": {
        "server_name": { "const": "kl-core" },
        "server_version": { "type": "string" },
        "protocol_version": { "const": 1 },
        "min_protocol_version": { "type": "integer" },
        "features": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "pingParams": {
      "type": "object",
      "properties": { "nonce": { "type": "string" } },
      "additionalProperties": false
    },
    "pingResult": {
      "type": "object",
      "required": ["pong", "server_time_unix_ms"],
      "properties": {
        "pong": { "const": true },
        "nonce": { "type": "string" },
        "server_time_unix_ms": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "doctorCheck": {
      "type": "object",
      "required": ["name", "ok", "detail"],
      "properties": {
        "name": { "type": "string" },
        "ok": { "type": "boolean" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "doctorResult": {
      "type": "object",
      "required": ["ok", "core_version", "protocol_version", "checks"],
      "properties": {
        "ok": { "type": "boolean" },
        "core_version": { "type": "string" },
        "protocol_version": { "const": 1 },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/doctorCheck" } }
      },
      "additionalProperties": false
    },
    "providerModelSummary": {
      "type": "object",
      "required": [
        "provider",
        "model",
        "protocol",
        "url",
        "context_window",
        "compact_threshold",
        "max_output_tokens",
        "enabled",
        "key_configured",
        "available",
        "detail"
      ],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "protocol": {
          "enum": [
            "openai-chat",
            "anthropic",
            "openai-responses",
            "scripted",
            "plugin"
          ]
        },
        "url": { "type": "string", "format": "uri" },
        "context_window": { "type": "integer", "minimum": 1 },
        "compact_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "enabled": { "type": "boolean" },
        "key_configured": { "type": "boolean" },
        "available": { "type": "boolean" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "providerListResult": {
      "type": "object",
      "required": ["active_provider", "active_model", "models"],
      "properties": {
        "active_provider": { "type": "string" },
        "active_model": { "type": "string" },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/providerModelSummary" }
        }
      },
      "additionalProperties": false
    },
    "providerProtocolUrls": {
      "type": "object",
      "properties": {
        "openai-chat": { "type": "string" },
        "anthropic": { "type": "string" },
        "openai-responses": { "type": "string" }
      },
      "additionalProperties": false
    },
    "providerModelInput": {
      "type": "object",
      "required": [
        "id",
        "protocol",
        "context_window",
        "compact_threshold",
        "max_output_tokens"
      ],
      "properties": {
        "id": { "type": "string" },
        "protocol": {
          "enum": ["openai-chat", "anthropic", "openai-responses"]
        },
        "context_window": { "type": "integer", "minimum": 1 },
        "compact_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "providerUpsertParams": {
      "type": "object",
      "required": ["id", "protocols", "models", "enabled"],
      "properties": {
        "id": { "type": "string" },
        "protocols": { "$ref": "#/$defs/providerProtocolUrls" },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/providerModelInput" }
        },
        "enabled": { "type": "boolean" },
        "api_key_env": { "type": "string" }
      },
      "additionalProperties": false
    },
    "providerUpsertResult": {
      "type": "object",
      "required": ["provider", "path", "models", "enabled"],
      "properties": {
        "provider": { "type": "string" },
        "path": { "type": "string" },
        "models": { "type": "integer", "minimum": 1 },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "providerSetApiKeyParams": {
      "type": "object",
      "required": ["id", "key"],
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "providerKeyResult": {
      "type": "object",
      "required": ["provider", "key_configured"],
      "properties": {
        "provider": { "type": "string" },
        "key_configured": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "providerSetEnabledParams": {
      "type": "object",
      "required": ["id", "enabled"],
      "properties": {
        "id": { "type": "string" },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "providerEnabledResult": {
      "type": "object",
      "required": ["provider", "enabled"],
      "properties": {
        "provider": { "type": "string" },
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "setDefaultModelParams": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" }
      },
      "additionalProperties": false
    },
    "defaultModelResult": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sessionCreateParams": {
      "type": "object",
      "required": ["workspace"],
      "properties": {
        "workspace": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sessionRenameParams": {
      "type": "object",
      "required": ["session_id", "name"],
      "properties": {
        "session_id": { "type": "string" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 }
      },
      "additionalProperties": false
    },
    "sessionHistoryParams": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": { "type": "string" },
        "limit": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sessionHistoryToolSummary": {
      "type": "object",
      "required": ["name", "ok", "summary"],
      "properties": {
        "name": { "type": "string" },
        "ok": { "type": "boolean" },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sessionHistoryEntry": {
      "type": "object",
      "required": ["role", "text"],
      "properties": {
        "role": { "enum": ["user", "assistant", "tool"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "seq": { "type": "integer", "minimum": 0 },
        "tool": { "$ref": "#/$defs/sessionHistoryToolSummary" }
      },
      "additionalProperties": false
    },
    "sessionHistoryResult": {
      "type": "object",
      "required": ["session_id", "messages"],
      "properties": {
        "session_id": { "type": "string" },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/sessionHistoryEntry" }
        }
      },
      "additionalProperties": false
    },
    "sessionDeleteParams": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sessionDeleteResult": {
      "type": "object",
      "required": ["deleted"],
      "properties": {
        "deleted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "sessionInfo": {
      "type": "object",
      "required": [
        "session_id",
        "workspace",
        "provider",
        "model",
        "created_at",
        "updated_at",
        "message_count",
        "reasoning_effort"
      ],
      "properties": {
        "session_id": { "type": "string" },
        "workspace": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "message_count": { "type": "integer", "minimum": 0 },
        "reasoning_effort": { "type": "string" },
        "status": { "type": "string" },
        "task": { "type": "string" },
        "prompt": { "type": "string" },
        "last_message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "turnStartParams": {
      "type": "object",
      "required": ["session_id", "prompt"],
      "properties": {
        "session_id": { "type": "string" },
        "prompt": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "quality": { "enum": ["fast", "balanced", "deep"] },
        "agent": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "reviewRunParams": {
      "type": "object",
      "required": ["workspace"],
      "properties": {
        "workspace": { "type": "string" },
        "base": { "type": "string" },
        "mode": { "enum": ["quick", "standard", "strict"] },
        "strict": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "reviewFinding": {
      "type": "object",
      "required": [
        "rule",
        "source",
        "file",
        "line",
        "severity",
        "confidence",
        "evidence",
        "recommendation",
        "introduced",
        "low_confidence"
      ],
      "properties": {
        "rule": { "type": "string" },
        "source": { "type": "string" },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "string" },
        "recommendation": { "type": "string" },
        "introduced": { "type": "boolean" },
        "low_confidence": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "reviewResult": {
      "type": "object",
      "required": ["mode", "summary", "changed_files", "findings"],
      "properties": {
        "mode": { "enum": ["quick", "standard", "strict"] },
        "summary": { "type": "string" },
        "changed_files": { "type": "integer", "minimum": 0 },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/reviewFinding" }
        }
      },
      "additionalProperties": false
    },
    "approvalMode": {
      "enum": ["ask", "plan", "acceptEdits", "dontAsk", "auto", "read-only"]
    },
    "reasoningEffort": {
      "enum": ["default", "low", "medium", "high"]
    },
    "sandboxCapabilitiesSummary": {
      "type": "object",
      "required": [
        "os_isolation",
        "filesystem_read_restriction",
        "filesystem_write_restriction",
        "child_process_containment",
        "network_isolation",
        "notes"
      ],
      "properties": {
        "os_isolation": { "type": "boolean" },
        "filesystem_read_restriction": { "type": "boolean" },
        "filesystem_write_restriction": { "type": "boolean" },
        "child_process_containment": { "type": "boolean" },
        "network_isolation": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "sandboxSummary": {
      "type": "object",
      "required": ["backend", "strict", "capabilities"],
      "properties": {
        "backend": { "type": "string" },
        "strict": { "type": "boolean" },
        "capabilities": { "$ref": "#/$defs/sandboxCapabilitiesSummary" }
      },
      "additionalProperties": false
    },
    "sessionStatusParams": {
      "type": "object",
      "properties": {
        "session_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sessionStatusResult": {
      "type": "object",
      "required": [
        "session_id",
        "workspace",
        "provider",
        "model",
        "context_window",
        "compact_threshold",
        "max_output_tokens",
        "turn_active",
        "approval_mode",
        "sandbox"
      ],
      "properties": {
        "session_id": { "type": "string" },
        "workspace": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "context_window": { "type": "integer", "minimum": 1 },
        "compact_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "turn_active": { "type": "boolean" },
        "approval_mode": { "$ref": "#/$defs/approvalMode" },
        "sandbox": { "$ref": "#/$defs/sandboxSummary" }
      },
      "additionalProperties": false
    },
    "permissionsGetParams": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "permissionsResult": {
      "type": "object",
      "required": ["approval_mode", "policy_summary", "sandbox"],
      "properties": {
        "approval_mode": { "$ref": "#/$defs/approvalMode" },
        "policy_summary": { "type": "string" },
        "sandbox": { "$ref": "#/$defs/sandboxSummary" }
      },
      "additionalProperties": false
    },
    "permissionsSetParams": {
      "type": "object",
      "required": ["approval_mode"],
      "properties": {
        "approval_mode": { "$ref": "#/$defs/approvalMode" }
      },
      "additionalProperties": false
    },
    "sessionCompactParams": {
      "type": "object",
      "properties": {
        "session_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sessionCompactResult": {
      "type": "object",
      "required": [
        "omitted_messages",
        "estimated_tokens",
        "context_window",
        "compact_threshold"
      ],
      "properties": {
        "omitted_messages": { "type": "integer", "minimum": 0 },
        "estimated_tokens": { "type": "integer", "minimum": 0 },
        "context_window": { "type": "integer", "minimum": 1 },
        "compact_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "workspaceInitParams": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "force": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "workspaceInitResult": {
      "type": "object",
      "required": ["path", "created"],
      "properties": {
        "path": { "type": "string" },
        "created": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "agentConfigGetParams": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "agentConfigResult": {
      "type": "object",
      "required": ["reasoning_effort"],
      "properties": {
        "reasoning_effort": { "$ref": "#/$defs/reasoningEffort" }
      },
      "additionalProperties": false
    },
    "agentConfigSetParams": {
      "type": "object",
      "required": ["reasoning_effort"],
      "properties": {
        "reasoning_effort": { "$ref": "#/$defs/reasoningEffort" }
      },
      "additionalProperties": false
    },
    "agentInfo": {
      "type": "object",
      "required": ["id", "name", "description", "policy", "source", "built_in"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "policy": { "enum": ["full", "read-only", "verify-only"] },
        "source": { "type": "string" },
        "built_in": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "agentListResult": {
      "type": "object",
      "required": ["agents"],
      "properties": {
        "agents": { "type": "array", "items": { "$ref": "#/$defs/agentInfo" } }
      },
      "additionalProperties": false
    },
    "pluginInstallParams": {
      "type": "object",
      "required": ["path"],
      "properties": { "path": { "type": "string" } },
      "additionalProperties": false
    },
    "pluginIdParams": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string" } },
      "additionalProperties": false
    },
    "pluginInfo": {
      "type": "object",
      "required": ["id", "version", "kind", "enabled", "healthy"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "kind": { "enum": ["provider", "tool"] },
        "enabled": { "type": "boolean" },
        "healthy": { "type": "boolean" },
        "tool_name": { "type": "string" },
        "models": { "type": "array", "items": { "type": "string" } },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pluginListResult": {
      "type": "object",
      "required": ["plugins"],
      "properties": {
        "plugins": { "type": "array", "items": { "$ref": "#/$defs/pluginInfo" } }
      },
      "additionalProperties": false
    },
    "serverInfoParams": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "serverInfoResult": {
      "type": "object",
      "required": [
        "server_name",
        "server_version",
        "protocol_version",
        "transport",
        "endpoint",
        "pid",
        "started_at_unix_ms"
      ],
      "properties": {
        "server_name": { "type": "string" },
        "server_version": { "type": "string" },
        "protocol_version": { "const": 1 },
        "transport": { "type": "string" },
        "endpoint": { "type": "string" },
        "pid": { "type": "integer", "minimum": 1 },
        "started_at_unix_ms": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "sessionAttachParams": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": { "type": "string" },
        "after_seq": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sessionAttachResult": {
      "type": "object",
      "required": ["session_id", "replay", "last_seq", "lease_held"],
      "properties": {
        "session_id": { "type": "string" },
        "replay": { "type": "array", "items": { "$ref": "#/$defs/eventRecord" } },
        "last_seq": { "type": "integer", "minimum": 0 },
        "lease_held": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "sessionDetachParams": {
      "type": "object",
      "required": ["session_id"],
      "properties": { "session_id": { "type": "string" } },
      "additionalProperties": false
    },
    "sessionDetachResult": {
      "type": "object",
      "required": ["session_id", "detached"],
      "properties": {
        "session_id": { "type": "string" },
        "detached": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "sessionLeaseParams": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": { "type": "string" },
        "lease_ms": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "sessionLeaseResult": {
      "type": "object",
      "required": ["session_id", "expires_at_unix_ms"],
      "properties": {
        "session_id": { "type": "string" },
        "expires_at_unix_ms": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "eventRecord": {
      "type": "object",
      "required": ["session_id", "seq", "event"],
      "properties": {
        "session_id": { "type": "string" },
        "seq": { "type": "integer", "minimum": 1 },
        "event": { "$ref": "#/$defs/coreEvent" }
      },
      "additionalProperties": false
    },
    "memoryListParams": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": { "type": "string" },
        "scope": { "enum": ["workspace", "user"] }
      },
      "additionalProperties": false
    },
    "memoryListResult": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/memoryEntryInfo" }
        }
      },
      "additionalProperties": false
    },
    "memoryEntryInfo": {
      "type": "object",
      "required": ["name", "scope", "size_bytes"],
      "properties": {
        "name": { "type": "string" },
        "scope": { "enum": ["workspace", "user"] },
        "size_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "memoryReadParams": {
      "type": "object",
      "required": ["session_id", "name"],
      "properties": {
        "session_id": { "type": "string" },
        "name": { "type": "string" },
        "scope": { "enum": ["workspace", "user"] }
      },
      "additionalProperties": false
    },
    "memoryReadResult": {
      "type": "object",
      "required": ["name", "scope", "content"],
      "properties": {
        "name": { "type": "string" },
        "scope": { "enum": ["workspace", "user"] },
        "content": { "type": "string" }
      },
      "additionalProperties": false
    },
    "memoryWriteParams": {
      "type": "object",
      "required": ["session_id", "name", "content"],
      "properties": {
        "session_id": { "type": "string" },
        "name": { "type": "string" },
        "content": { "type": "string" },
        "scope": { "enum": ["workspace", "user"] }
      },
      "additionalProperties": false
    },
    "memoryWriteResult": {
      "type": "object",
      "required": ["name", "scope", "size_bytes"],
      "properties": {
        "name": { "type": "string" },
        "scope": { "enum": ["workspace", "user"] },
        "size_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "memoryDeleteParams": {
      "type": "object",
      "required": ["session_id", "name"],
      "properties": {
        "session_id": { "type": "string" },
