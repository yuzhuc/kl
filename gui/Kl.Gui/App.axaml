        <!-- Pressed feedback + glyph centering for every button -->
        <Style Selector="Button.icon Path, Button.sidebar-icon Path, Button.row-action Path,
                         Button.session-actions Path, Button.more-menu-pin Path,
                         Button.message-action Path, Button.attach Path, Button.send Path,
                         Button.stop Path, Button.activity-row Path, Button.titlebar-icon Path,
                         Button.caption Path, Button.recent-toggle Path">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.rail Viewbox, Button.rail StackPanel, Button.rail Path">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.row Path, Button.session-row Path, Button.nav Path,
                         Button.mode-menu-item Path, Button.more-menu-item Path,
                         Button.product-menu-toggle Path, Button.section-header Path">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource PressedFill}" />
        </Style>
        <Style Selector="Button.rail:pressed">
            <Setter Property="Background" Value="{DynamicResource PressedFill}" />
        </Style>
        <Style Selector="Button.rail.active:pressed">
            <Setter Property="Background" Value="{DynamicResource PressedFillStrong}" />
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="#3C7FD6" />
        </Style>
        <Style Selector="Button.send:pressed">
            <Setter Property="Background" Value="#D9D9DE" />
        </Style>
        <Style Selector="Button.row:pressed, Button.session-row:pressed, Button.nav:pressed,
                         Button.more-menu-item:pressed, Button.mode-menu-item:pressed,
                         Button.activity-row:pressed, Button.chip:pressed, Button.filter:pressed,
                         Button.route-menu:pressed">
            <Setter Property="Background" Value="{DynamicResource PressedFill}" />
        </Style>
        <Style Selector="Button.product-menu-toggle:pressed">
            <Setter Property="Background" Value="{DynamicResource PressedFill}" />
        </Style>
        <Style Selector="Button.titlebar-menu:pressed, Button.titlebar-icon:pressed, Button.caption:pressed">
            <Setter Property="Background" Value="{DynamicResource PressedFill}" />
        </Style>
        <Style Selector="Button.subtle:pressed, Button.secondary:pressed">
            <Setter Property="Background" Value="{DynamicResource PressedFillStrong}" />
        </Style>

        <!-- Notifications bell active state + command palette rows -->
        <Style Selector="Button.icon.active, Button.sidebar-icon.active">
            <Setter Property="Background" Value="{DynamicResource SidebarHoverFill}" />
        </Style>
        <Style Selector="Button.icon.active Path, Button.sidebar-icon.active Path">
            <Setter Property="Stroke" Value="{DynamicResource SidebarTextHover}" />
        </Style>
        <Style Selector="Button.palette-row">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>
        <Style Selector="Button.palette-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource ElevatedHover}" />
        </Style>
        <Style Selector="Button.palette-row Path">
            <Setter Property="Stroke" Value="{DynamicResource SidebarLabel}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Codex-subtle scrollbars: 6px soft thumb, transparent track, no arrows -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="#1F1F20" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Background" Value="#2D2D2E" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="ScrollBar:vertical:pointerover /template/ Thumb">
            <Setter Property="Background" Value="#3A3A3D" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ RepeatButton">
            <Setter Property="Height" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Background" Value="#1F1F20" />
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ Thumb">
            <Setter Property="Background" Value="#2D2D2E" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="MinWidth" Value="24" />
        </Style>
        <Style Selector="ScrollBar:horizontal:pointerover /template/ Thumb">
            <Setter Property="Background" Value="#3A3A3D" />
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ RepeatButton">
            <Setter Property="Width" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- Inputs -->
        <Style Selector="TextBox.composer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="PlaceholderForeground" Value="#7E7F82" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBlue}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
        <Style Selector="TextBox.composer /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="PlaceholderForeground" Value="#727275" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBlue}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="TextBox.search /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="TextBox.field">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Background" Value="{DynamicResource ElevatedHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBlue}" />
            <Setter Property="SelectionBrush" Value="#39466B" />
            <Setter Property="SelectionForegroundBrush" Value="#FFFFFF" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ElevatedHover}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="TextBox.dialog-plain">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#E3E4E6" />
            <Setter Property="SelectionBrush" Value="#39466B" />
            <Setter Property="SelectionForegroundBrush" Value="#FFFFFF" />
            <Setter Property="CaretBrush" Value="#E3E4E6" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="TextBox.dialog-plain /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ComboBox.field">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource ElevatedHover}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Common text / surface classes -->
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        </Style>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardFill}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
    </Application.Styles>
</Application>
