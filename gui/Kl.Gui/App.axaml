                    <BrushTransition Property="Stroke" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.row-action:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource SidebarTextHover}" />
        </Style>
        <Style Selector="Button.row-action.pinned Path">
            <Setter Property="Stroke" Value="{DynamicResource SidebarTextHover}" />
            <Setter Property="Fill" Value="{DynamicResource SidebarTextHover}" />
        </Style>

        <!-- Collapsible sidebar section headers (项目 / 最近 / 已归档) -->
        <Style Selector="Button.section-header">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.section-header Path.section-chevron">
            <Setter Property="Stroke" Value="{DynamicResource SidebarLabel}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
