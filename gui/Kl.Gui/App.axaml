            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.activity-row">
        <Setter Property="MinHeight" Value="27" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="-6,0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="#8E8F91" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
        <Style Selector="Button.activity-row:pointerover">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.activity-row Path.activity-chevron">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.activity-row:pointerover Path.activity-chevron">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.activity-row.expanded">
        <Setter Property="Background" Value="#1D1D1F" />
    </Style>
    <Style Selector="Button.activity-row.expanded Path.activity-chevron">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <Style Selector="Button.jump-bottom">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#2E2E31" />
        <Setter Property="Background" Value="#202022" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="RenderTransform" Value="translate(0px,6px)" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.jump-bottom:pointerover">
        <Setter Property="Background" Value="#2A2A2E" />
    </Style>
    <Style Selector="Button.jump-bottom Path">
        <Setter Property="Stroke" Value="#C6C7C9" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
    </Style>
        <Style Selector="Button.activity-row Path">
            <Setter Property="Stroke" Value="{DynamicResource TextTertiary}" />
            <Setter Property="StrokeThickness" Value="1.35" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
