<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kl.Gui.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="BgBase" Color="#0F0F11" />
        <SolidColorBrush x:Key="SidebarRailFill" Color="#0D0D0F" />
        <SolidColorBrush x:Key="SidebarFill" Color="#0F0F10" />
        <SolidColorBrush x:Key="ElevatedFill" Color="#262729" />
        <SolidColorBrush x:Key="ElevatedHover" Color="#292A2D" />
        <SolidColorBrush x:Key="Line" Color="#242427" />
        <SolidColorBrush x:Key="LineStrong" Color="#3A3B40" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F4F5" />
        <SolidColorBrush x:Key="TextSecondary" Color="#C8C9CC" />
        <SolidColorBrush x:Key="TextTertiary" Color="#96979B" />
        <SolidColorBrush x:Key="TextCaption" Color="#707176" />
        <SolidColorBrush x:Key="AccentBlue" Color="#66A3FF" />
        <SolidColorBrush x:Key="BlueHover" Color="#80B2FF" />
        <SolidColorBrush x:Key="BubbleFill" Color="#262729" />
        <SolidColorBrush x:Key="HoverFill" Color="#202024" />
        <SolidColorBrush x:Key="RailIcon" Color="#8B8C90" />
        <SolidColorBrush x:Key="RailIconHover" Color="#D2D3D5" />
        <SolidColorBrush x:Key="RailIconActive" Color="#E6E7E9" />
        <SolidColorBrush x:Key="RailHoverFill" Color="#18181A" />
        <SolidColorBrush x:Key="RailActiveFill" Color="#1C1C1E" />
        <SolidColorBrush x:Key="MenuFill" Color="#202022" />
        <SolidColorBrush x:Key="MenuRowHoverFill" Color="#28282A" />
        <SolidColorBrush x:Key="MenuRowPressedFill" Color="#303134" />
        <x:Double x:Key="ChatContentFontSize">14</x:Double>
        <x:Double x:Key="ChatContentLineHeight">24</x:Double>
        <x:Double x:Key="ChatSecondaryFontSize">13</x:Double>
        <x:Double x:Key="ChatSecondaryLineHeight">20</x:Double>
        <StreamGeometry x:Key="PlusIcon">M12 4V20 M4 12H20</StreamGeometry>
        <StreamGeometry x:Key="EditIcon">M4 20L8.5 19L20 7.5L16.5 4L5 15.5Z M14.5 6L18 9.5</StreamGeometry>
        <StreamGeometry x:Key="ChatIcon">M5 5H19V17H10L5 21V5Z</StreamGeometry>
        <StreamGeometry x:Key="RailChatIcon">M10 20V14H14V20H19V12H22L12 3L2 12H5V20Z</StreamGeometry>
        <StreamGeometry x:Key="PluginIcon">M4 4H10V10H4Z M14 4H20V10H14Z M9 14H15V20H9Z</StreamGeometry>
        <StreamGeometry x:Key="RailPluginIcon">M7 4A2 2 0 1 0 7 8A2 2 0 1 0 7 4 M7 8V16 M7 16A2 2 0 1 0 7 20A2 2 0 1 0 7 16 M13 6H15C17 6 18 7 18 9V16 M18 16A2 2 0 1 0 18 20A2 2 0 1 0 18 16</StreamGeometry>
        <StreamGeometry x:Key="AutomationIcon">M20 8A9 9 0 1 0 21 15 M20 3V8H15</StreamGeometry>
        <StreamGeometry x:Key="RailAutomationIcon">M21 12A9 9 0 1 1 12 3A9 9 0 0 1 21 12Z M12 7V12L15.5 14</StreamGeometry>
        <StreamGeometry x:Key="FolderIcon">M3 5H9L11 7H21V19H3Z</StreamGeometry>
        <StreamGeometry x:Key="AddProjectIcon">M3 5H9L11 7H21V19H3Z M12 10V16 M9 13H15</StreamGeometry>
        <StreamGeometry x:Key="CodeReviewIcon">M7 4A2 2 0 1 0 7 8A2 2 0 1 0 7 4 M7 8V16 M7 16A2 2 0 1 0 7 20A2 2 0 1 0 7 16 M13 6H15C17 6 18 7 18 9V16 M18 16A2 2 0 1 0 18 20A2 2 0 1 0 18 16</StreamGeometry>
        <StreamGeometry x:Key="PinIcon">M16 12V4H17V2H7V4H8V12L6 14V16H11.2V22H12.8V16H18V14L16 12Z</StreamGeometry>
        <StreamGeometry x:Key="SearchIcon">M10.5 4A6.5 6.5 0 1 0 10.5 17A6.5 6.5 0 1 0 10.5 4 M15.5 15.5L21 21</StreamGeometry>
        <StreamGeometry x:Key="MoreIcon">M5 12A1.5 1.5 0 1 0 8 12A1.5 1.5 0 1 0 5 12 M10.5 12A1.5 1.5 0 1 0 13.5 12A1.5 1.5 0 1 0 10.5 12 M16 12A1.5 1.5 0 1 0 19 12A1.5 1.5 0 1 0 16 12</StreamGeometry>
        <StreamGeometry x:Key="PanelIcon">M4 4H20V20H4Z M9 4V20</StreamGeometry>
        <StreamGeometry x:Key="SettingsIcon">M12 2L14 4L17 3L18 6L21 7L20 10L22 12L20 14L21 17L18 18L17 21L14 20L12 22L10 20L7 21L6 18L3 17L4 14L2 12L4 10L3 7L6 6L7 3L10 4Z M12 8A4 4 0 1 0 12 16A4 4 0 1 0 12 8</StreamGeometry>
        <StreamGeometry x:Key="ChevronDownIcon">M7 9L12 14L17 9</StreamGeometry>
        <StreamGeometry x:Key="ChevronUpIcon">M7 15L12 10L17 15</StreamGeometry>
        <StreamGeometry x:Key="SendIcon">M12 19V5 M6 11L12 5L18 11</StreamGeometry>
        <StreamGeometry x:Key="ThoughtIcon">M12 3L13.4 8.6L19 10L13.4 11.4L12 17L10.6 11.4L5 10L10.6 8.6Z</StreamGeometry>
        <StreamGeometry x:Key="ToolIcon">M4 5H20V19H4Z M7 9L10 12L7 15 M12 15H17</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="Transitions" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ElevatedFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Border.more-menu-row">
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.more-menu-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource MenuRowHoverFill}" />
        </Style>
        <Style Selector="Border.more-menu-row:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource RailIconActive}" />
        </Style>
        <Style Selector="Border.more-menu-row:pointerover Path.more-menu-icon">
            <Setter Property="Stroke" Value="{DynamicResource RailIconActive}" />
        </Style>
        <Style Selector="Border.more-menu-row:pointerover Path.more-menu-pin-icon">
            <Setter Property="Fill" Value="{DynamicResource RailIconHover}" />
        </Style>
        <Style Selector="Button.more-menu-item">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.more-menu-item:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.more-menu-item:pressed">
            <Setter Property="Background" Value="{DynamicResource MenuRowPressedFill}" />
        </Style>
        <Style Selector="Button.more-menu-pin">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.more-menu-pin:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.icon:pointerover">
            <Setter Property="Background" Value="{DynamicResource ElevatedHover}" />
        </Style>

        <Style Selector="Button.new-session">
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ElevatedFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
            <Setter Property="BorderThickness" Value="0.5" />
        </Style>
        <Style Selector="Button.new-session:pointerover">
            <Setter Property="Background" Value="{DynamicResource ElevatedHover}" />
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverFill}" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource ElevatedHover}" />
        </Style>
        <Style Selector="Button.nav.active Path">
            <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.nav.active TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="Button.session-row">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.session-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverFill}" />
        </Style>
        <Style Selector="Button.session-row.active">
            <Setter Property="Background" Value="{DynamicResource ElevatedHover}" />
        </Style>

        <Style Selector="Button.activity-header">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.activity-header:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverFill}" />
        </Style>

        <Style Selector="Button.send">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.send:pointerover">
            <Setter Property="Background" Value="#E7E7E7" />
        </Style>
        <Style Selector="Button.send:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="Button.attach">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="#353536" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.attach:pointerover">
            <Setter Property="Background" Value="#43454A" />
        </Style>

        <Style Selector="TextBox.composer">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8,12,4" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBlue}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="TextBox.composer /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>
