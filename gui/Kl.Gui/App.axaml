    <Style Selector="StackPanel.chat-user:pointerover StackPanel.chat-user-actions">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.ruler-preview">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
