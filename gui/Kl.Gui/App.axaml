        <Style Selector="Button.section-header Path.section-chevron.collapsed">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
        </Style>

        <!-- Product / interaction-mode switcher (Codex-style header menu) -->
        <Style Selector="Button.product-menu-toggle">
            <Setter Property="Padding" Value="6,2" />
