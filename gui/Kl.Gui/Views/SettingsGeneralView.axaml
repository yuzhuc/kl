                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding TranslucentSidebar, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Height="44" Margin="16,0,16,0">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.4cbc7532}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider x:Name="ContrastSlider" Width="140" Minimum="0" Maximum="100" Value="{Binding Contrast, Mode=TwoWay}"
                                     PointerReleased="OnContrastCommitted" KeyUp="OnContrastKeyUp" LostFocus="OnContrastLostFocus" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                            <TextBlock Classes="settings-value" Text="{Binding #ContrastSlider.Value, StringFormat={}{0:0}}" Width="26" TextAlignment="Right" TextWrapping="NoWrap" VerticalAlignment="Center" />
                            </StackPanel>
                            </Grid>
                            </StackPanel>
                            </Border>
                            <Border Classes="settings-card">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,10,16,9">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.6a904ba4}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.ed68ea17}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="filter" Classes.active="{Binding IsDiffColorMode}" Content="{DynamicResource S.070a8016}" Tag="color" Click="OnDiffMarkerModeClicked" />
                            <Button Classes="filter" Classes.active="{Binding IsDiffMarkers}" Content="+/-" Tag="markers" Click="OnDiffMarkerModeClicked" />
