<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kl.Gui.ViewModels"
             xmlns:controls="using:Kl.Gui.Controls"
             x:Class="Kl.Gui.Views.SettingsGeneralView"
             x:DataType="vm:MainWindowViewModel">
    <StackPanel>
                            <StackPanel IsVisible="{Binding IsSettingsGeneral}" Spacing="50" Classes="settings-pane">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.978cbca6}" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.3f8f3ea0}" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="600" Text="{DynamicResource S.cab9e0fa}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding SettingsFullAccess, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.40fae00b}" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.7349a15b}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.408ce7af}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding KlHomeDirectory}" FontSize="11.5" Foreground="{DynamicResource TextCaption}" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Classes="secondary settings-button" Content="{DynamicResource S.c771248e}" Click="OnOpenKlHomeClicked" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.e367e163}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.4871613a}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding FileOpenTargetIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.04b77083}" />
                            <ComboBoxItem Content="VS Code" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.7005deaf}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.ee609787}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding TerminalShellIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="PowerShell" />
                            <ComboBoxItem Content="{DynamicResource S.c8a8b2de}" />
                            <ComboBoxItem Content="Git Bash" />
                            </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.fc88eb78}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.07cea44b}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding CloseWindowActionIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.b90c7258}" />
                            <ComboBoxItem Content="{DynamicResource S.0f782a19}" />
                            <ComboBoxItem Content="{DynamicResource S.ab274251}" />
                            </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.0716a5f3}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.9eaa4ecd}" HorizontalAlignment="Left" MaxWidth="650" />
                            <TextBlock Text="{Binding LaunchAtLoginStatus}" IsVisible="{Binding HasLaunchAtLoginStatus}"
                                       FontSize="11.5" Foreground="{DynamicResource TextCaption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.e02966b3}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.97617a49}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding RestoreLastSession, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.d2e45c95}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.238eb1d9}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding ShowTerminalPanelControl, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.2cd1f341}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.20f0def4}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Button Classes="segment" Classes.active="{Binding IsTerminalBottom}" Content="{DynamicResource S.3f049887}" Tag="bottom" Click="OnTerminalPositionClicked" />
                            <Button Classes="segment" Classes.active="{Binding IsTerminalRight}" Content="{DynamicResource S.1cf1d4d0}" Tag="right" Click="OnTerminalPositionClicked" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.3c026145}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.b7803384}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding AutoArchiveIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.bf2431e3}" />
                            <ComboBoxItem Content="{DynamicResource S.38eefacb}" />
                            <ComboBoxItem Content="{DynamicResource S.84ad2952}" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.3537d57d}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.ace4ea4b}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding CompressHistory, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.6cda64b3}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.67b8f642}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="{DynamicResource S.bb6d9957}" VerticalAlignment="Center" Click="OnOpenModelsSettingsClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.e806fbbe}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.651d71ae}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding PluginsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.3b7f5965}" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.78040844}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.c2dbfda5}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding ShowContextUsage, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.5a29940b}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.8ba59ae0}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding SendShortcutIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.c6d8df5b}" />
                            <ComboBoxItem Content="Ctrl+Enter" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.c8a5fb8e}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.242f705b}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Button Classes="segment" Classes.active="{Binding IsFollowUpQueue}" Content="{DynamicResource S.117c113c}" Tag="queue" Click="OnFollowUpModeClicked" />
                            <Button Classes="segment" Classes.active="{Binding IsFollowUpSteer}" Content="{DynamicResource S.4084045d}" Tag="steer"
                                    Click="OnFollowUpModeClicked" IsEnabled="False" ToolTip.Tip="{DynamicResource S.914d29f0}" />
                            </StackPanel>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsSettingsNotifications}" Spacing="50" Classes="settings-pane">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.4b6ded8a}" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.9238a5be}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.9fedfb54}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding TurnNotificationIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.f5945047}" />
                            <ComboBoxItem Content="{DynamicResource S.0f782a19}" />
                            <ComboBoxItem Content="{DynamicResource S.ab274251}" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.7017ff8d}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.c5f9bd71}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding ApprovalNotifications, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.34fe78ad}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.b47874e0}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding QuestionNotifications, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.55920a97}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.20f7682e}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding NotificationSoundIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.844b8cc8}" />
                            <ComboBoxItem Content="{DynamicResource S.3fd47edc}" />
                            </ComboBox>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsSettingsImport}" Spacing="50" Classes="settings-pane">
                            <Border IsVisible="{Binding IsRemoteCore}" Classes="settings-card" Margin="0,0,0,0">
                            <TextBlock Text="{Binding RemoteCoreNotice}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                       Margin="16,12" />
                            </Border>
                                                        <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.18042e31}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.005a7747}" HorizontalAlignment="Left" MaxWidth="650" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <TextBlock Text="{Binding ImportStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="secondary settings-button" Content="{DynamicResource S.c12e7500}" Click="OnOpenImportSourceClicked" />
                            <Button Classes="secondary settings-button" Content="{DynamicResource S.daf5103f}" Click="OnScanImportsClicked" IsEnabled="{Binding !IsRemoteCore}" />
                            <Button Classes="primary settings-button" Content="{DynamicResource S.673ea337}" Click="OnImportSelectedClicked" IsEnabled="{Binding CanImportSelected}" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" IsVisible="{Binding HasImportCandidates}" />
                            <ItemsControl ItemsSource="{Binding ImportCandidates}" IsVisible="{Binding HasImportCandidates}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImportCandidateRow">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,7,16,7">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" Margin="8,0,12,0">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextCaption}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextSecondary}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding KindLabel}" FontSize="11" Foreground="{DynamicResource TextCaption}" VerticalAlignment="Center" />
                            </Grid>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsSettingsAppearance}" Spacing="50" Classes="settings-pane">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.106de8b9}" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,9,16,10">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.47a27008}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
<Border Width="80" Height="58" CornerRadius="8" Classes="settings-mode-card" Tag="system" BorderBrush="#606ACC" BorderThickness="2" ClipToBounds="True" Background="#1A1A1D">
                            <Grid ColumnDefinitions="24,56"><Border Background="#F1F1F3"><StackPanel Margin="4,5,0,0" Spacing="4"><Ellipse Width="6" Height="6" Fill="#C6C6CA" HorizontalAlignment="Left"/><Border Height="2" Width="12" Background="#D4D4D8" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="9" Background="#D4D4D8" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="11" Background="#D4D4D8" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="14" Background="#4C8DF6" CornerRadius="1" HorizontalAlignment="Left" Margin="0,2,0,0"/></StackPanel></Border><StackPanel Grid.Column="1" Margin="5,5,0,0" Spacing="3"><Ellipse Width="6" Height="6" Fill="#5A5A5E" HorizontalAlignment="Left"/><Border Height="2" Width="26" Background="#3C3C40" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="20" Background="#3C3C40" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="24" Background="#3C3C40" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="18" Background="#4C8DF6" CornerRadius="1" HorizontalAlignment="Left" Margin="0,1,0,0"/><Border Height="8" Width="34" CornerRadius="4" BorderBrush="#38383C" BorderThickness="1" HorizontalAlignment="Left" Margin="0,2,0,0"/></StackPanel></Grid>
                            </Border>
<Border Width="80" Height="58" CornerRadius="8" Classes="settings-mode-card" Tag="light" BorderBrush="#2E2E31" BorderThickness="1" ClipToBounds="True" Background="#F3F3F5">
                            <Grid ColumnDefinitions="24,56"><StackPanel Margin="4,5,0,0" Spacing="4"><Ellipse Width="6" Height="6" Fill="#C6C6CA" HorizontalAlignment="Left"/><Border Height="2" Width="10" Background="#D4D4D8" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="12" Background="#D4D4D8" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="9" Background="#D4D4D8" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="12" Background="#4C8DF6" CornerRadius="1" HorizontalAlignment="Left" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="4,5,4,0" Spacing="2"><Border Height="2" Width="30" Background="#4C8DF6" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="26" Background="#D4D4D8" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="24" Background="#D4D4D8" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="22" Background="#D4D4D8" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="28" Background="#4C8DF6" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="22" Background="#4C8DF6" CornerRadius="1" HorizontalAlignment="Left"/><Grid Height="9" Margin="0,2,0,0"><Border CornerRadius="4" BorderBrush="#DADADE" BorderThickness="1" Background="#FFFFFF"/><Ellipse Width="3" Height="3" Fill="#4C8DF6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/></Grid></StackPanel></Grid>
                            </Border>
<Border Width="80" Height="58" CornerRadius="8" Classes="settings-mode-card" Tag="dark" BorderBrush="#2E2E31" BorderThickness="1" ClipToBounds="True" Background="#19191C">
                            <Grid ColumnDefinitions="24,56"><StackPanel Margin="4,5,0,0" Spacing="4"><Ellipse Width="6" Height="6" Fill="#5A5A5E" HorizontalAlignment="Left"/><Border Height="2" Width="10" Background="#3C3C40" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="12" Background="#3C3C40" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="9" Background="#3C3C40" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="12" Background="#4C8DF6" CornerRadius="1" HorizontalAlignment="Left" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="4,5,4,0" Spacing="2"><Border Height="2" Width="30" Background="#4C8DF6" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="26" Background="#3C3C40" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="24" Background="#3C3C40" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="22" Background="#3C3C40" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="28" Background="#4C8DF6" CornerRadius="1" HorizontalAlignment="Left"/><Border Height="2" Width="22" Background="#4C8DF6" CornerRadius="1" HorizontalAlignment="Left"/><Grid Height="9" Margin="0,2,0,0"><Border CornerRadius="4" BorderBrush="#38383C" BorderThickness="1" Background="#141417"/><Ellipse Width="3" Height="3" Fill="#4C8DF6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/></Grid></StackPanel></Grid>
                            </Border>
                            </StackPanel>
                            </Grid>
                            </StackPanel>
                            </Border>
                            <Border Classes="settings-card" Margin="0,16,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Height="43" Margin="16,0,16,0">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.9f6fee1a}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.66da6751}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" MinWidth="140" Margin="0,0,16,0" VerticalAlignment="Center"
                                      SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.217cfe7d}" />
                            <ComboBoxItem Content="{DynamicResource S.9937e365}" />
                            <ComboBoxItem Content="English" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Height="43" Margin="16,0,16,0">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.f84e0542}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0"><ComboBox MinWidth="80" Classes="settings-select flat-select recessed-select settings-pill" SelectedIndex="{Binding AccentColorIndex, Mode=TwoWay}"><ComboBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="13" Height="13" CornerRadius="6.5" Background="#4D9FFF" /><TextBlock Text="{DynamicResource S.844b8cc8}" VerticalAlignment="Center" /></StackPanel></ComboBoxItem><ComboBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="13" Height="13" CornerRadius="6.5" Background="#3566F0" /><TextBlock Text="{DynamicResource S.67035e6b}" VerticalAlignment="Center" /></StackPanel></ComboBoxItem><ComboBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="13" Height="13" CornerRadius="6.5" Background="#179E8A" /><TextBlock Text="{DynamicResource S.30c83dc2}" VerticalAlignment="Center" /></StackPanel></ComboBoxItem><ComboBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="13" Height="13" CornerRadius="6.5" Background="#FFCC38" /><TextBlock Text="{DynamicResource S.d451c07d}" VerticalAlignment="Center" /></StackPanel></ComboBoxItem><ComboBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="13" Height="13" CornerRadius="6.5" Background="#FA70AB" /><TextBlock Text="{DynamicResource S.dbd379b3}" VerticalAlignment="Center" /></StackPanel></ComboBoxItem><ComboBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="13" Height="13" CornerRadius="6.5" Background="#FF8066" /><TextBlock Text="{DynamicResource S.aa1e899d}" VerticalAlignment="Center" /></StackPanel></ComboBoxItem><ComboBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="13" Height="13" CornerRadius="6.5" Background="#A25BFF" /><TextBlock Text="{DynamicResource S.2ed9c6fa}" VerticalAlignment="Center" /></StackPanel></ComboBoxItem><ComboBoxItem><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="13" Height="13" CornerRadius="6.5" Background="#FFFFFF" /><TextBlock Text="{DynamicResource S.f56e7eff}" VerticalAlignment="Center" /></StackPanel></ComboBoxItem></ComboBox><Border Classes="color-value"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Border Width="14" Height="14" CornerRadius="7" Background="{Binding AccentColorBrush}" /><TextBlock Text="{Binding AccentColorHex}" FontSize="12" Foreground="#C6C7C9" VerticalAlignment="Center" /></StackPanel></Border></StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Height="43" Margin="16,0,16,0">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.f4b669c5}" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="color-value" Margin="0,0,16,0"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Border Width="14" Height="14" CornerRadius="7" Background="{DynamicResource BgBase}" BorderBrush="{DynamicResource Line}" BorderThickness="1" /><TextBlock Classes="settings-value" Text="{Binding ThemeBackgroundHex}" Foreground="#C6C7C9" VerticalAlignment="Center" /></StackPanel></Border>
                            </Grid>
