                            <Button Grid.Column="1" Classes="subtle" Padding="6,2" Margin="0,0,-6,0" Click="OnResetSettingsClicked" ToolTip.Tip="{DynamicResource S.ac239c3a}"><TextBlock Text="{DynamicResource S.45c8826f}" FontSize="12.5" Foreground="{DynamicResource TextCaption}" VerticalAlignment="Center" /></Button>
                            </Grid>
                            <StackPanel x:Name="AppearanceAdvancedPanel" IsVisible="False" Spacing="16" Margin="0,14,0,0">
                            <Border Classes="settings-card">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,10,16,9">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.6089721b}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.d778caa9}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox Classes="settings-number" Text="{Binding SettingsContentFontSize, Mode=TwoWay}"
                                     LostFocus="OnAppearanceFontSizeCommitted" KeyDown="OnAppearanceFontSizeKeyDown" />
                            <TextBlock Classes="settings-value" Text="px" VerticalAlignment="Center" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,10,16,9">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.978c4c44}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.0d57c4ea}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox Classes="settings-number" Text="{Binding CodeFontSize, Mode=TwoWay}"
                                     LostFocus="OnAppearanceFontSizeCommitted" KeyDown="OnAppearanceFontSizeKeyDown" />
                            <TextBlock Classes="settings-value" Text="px" VerticalAlignment="Center" />
                            </StackPanel>
                            </Grid>
                            </StackPanel>
                            </Border>
                            <Border Classes="settings-card">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,10,16,9">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.7a56d47c}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.a5447ecd}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="filter" Classes.active="{Binding IsReduceMotionSystem}" Content="{DynamicResource S.5b50d7c4}" Tag="system" Click="OnMotionModeClicked" />
                            <Button Classes="filter" Classes.active="{Binding IsReduceMotionOn}" Content="{DynamicResource S.8da97ddd}" Tag="on" Click="OnMotionModeClicked" />
                            <Button Classes="filter" Classes.active="{Binding IsReduceMotionOff}" Content="{DynamicResource S.3fd47edc}" Tag="off" Click="OnMotionModeClicked" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,10,16,9">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.1fb60559}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.5dae076a}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding SeparateThemeSettings, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            <Border Classes="settings-card">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Height="34" Margin="16,0,16,0">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.6fba6dde}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Width="84" Classes="settings-select flat-select settings-pill" VerticalAlignment="Center" SelectedIndex="{Binding UiFontWeightIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.40fae00b}" />
                            <ComboBoxItem Content="{DynamicResource S.c7092c51}" />
                            <ComboBoxItem Content="{DynamicResource S.f6da93ed}" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Height="34" Margin="16,0,16,0">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.206eaa9c}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox Classes="settings-select flat-select settings-pill" VerticalAlignment="Center" SelectedIndex="{Binding ContentFontIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.d675d622}" />
                            <ComboBoxItem Content="Inter" />
                            <ComboBoxItem Content="{DynamicResource S.5b50d7c4}" />
                            </ComboBox>
                            <ComboBox Width="84" Classes="settings-select flat-select settings-pill" VerticalAlignment="Center" SelectedIndex="{Binding ContentFontWeightIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.40fae00b}" />
                            <ComboBoxItem Content="{DynamicResource S.c7092c51}" />
                            <ComboBoxItem Content="{DynamicResource S.f6da93ed}" />
                            </ComboBox>
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Height="34" Margin="16,0,16,0">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.e4210733}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox Classes="settings-select flat-select settings-pill" VerticalAlignment="Center" SelectedIndex="{Binding CodeFontIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Geist Mono" />
                            <ComboBoxItem Content="JetBrains Mono" />
                            <ComboBoxItem Content="{DynamicResource S.36e04fec}" />
                            </ComboBox>
                            <ComboBox Width="84" Classes="settings-select flat-select settings-pill" VerticalAlignment="Center" SelectedIndex="{Binding CodeFontWeightIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.40fae00b}" />
                            <ComboBoxItem Content="{DynamicResource S.c7092c51}" />
                            <ComboBoxItem Content="{DynamicResource S.f6da93ed}" />
                            </ComboBox>
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
