                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11"><StackPanel Spacing="3"><TextBlock Classes="settings-title" Text="{DynamicResource S.936ed875}" /><TextBlock Classes="settings-desc" Text="{DynamicResource S.a332b694}" /></StackPanel><Button Grid.Column="1" Classes="secondary settings-button" Content="{DynamicResource S.bb6d9957}" Click="OnOpenWorktreesSettingsClicked" /></Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11"><StackPanel Spacing="3"><TextBlock Classes="settings-title" Text="{DynamicResource S.e821845e}" /><TextBlock Classes="settings-desc" Text="{DynamicResource S.97e2f946}" /></StackPanel><Button Grid.Column="1" Classes="secondary settings-button" Click="OnSettingsNavClicked" Tag="Archived" Content="{DynamicResource S.bb6d9957}" /></Grid>
                            </StackPanel>
