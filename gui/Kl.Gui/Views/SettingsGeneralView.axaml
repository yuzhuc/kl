                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsSettingsArchived}" Spacing="50" Classes="settings-pane">
                                                                                                                                                                                                                                                                                            <StackPanel Spacing="0">
                                                                                                                                                                                                                                                                                                <TextBlock Classes="settings-heading" Text="{DynamicResource S.e821845e}" />
                                                                                                                                                                                                                                                                                                <TextBlock Classes="settings-desc" Margin="0,6,0,10"
                                                                                                                                                                                                                                                                                                           Text="{DynamicResource S.ec25ed49}" />
                                                                                                                                                                                                                                                                                                <Border Classes="settings-card">
                                                                                                                                                                                                                                                                                                    <StackPanel Margin="8,6">
                                                                                                                                                                                                                                                                                                        <ItemsControl ItemsSource="{Binding ArchivedSessions}">
                                                                                                                                                                                                                                                                                                            <ItemsControl.ItemTemplate>
                                                                                                                                                                                                                                                                                                                <DataTemplate x:DataType="vm:SessionItemViewModel">
                                                                                                                                                                                                                                                                                                                    <Grid Classes="session-row-container"
                                                                                                                                                                                                                                                                                                                          ColumnDefinitions="*,Auto" Margin="8,2">
                                                                                                                                                                                                                                                                                                                        <Button Classes="nav" Height="NaN" Padding="10,6"
                                                                                                                                                                                                                                                                                                                                Click="OnSessionClicked"
                                                                                                                                                                                                                                                                                                                                ToolTip.Tip="{Binding Workspace.Path}">
                                                                                                                                                                                                                                                                                                                            <StackPanel Spacing="2">
                                                                                                                                                                                                                                                                                                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                                                                                                                                                                                                                                                                                                           TextTrimming="CharacterEllipsis"
                                                                                                                                                                                                                                                                                                                                           VerticalAlignment="Center" />
                                                                                                                                                                                                                                                                                                                                <TextBlock Text="{Binding UpdatedLabel}"
                                                                                                                                                                                                                                                                                                                                           FontSize="11"
                                                                                                                                                                                                                                                                                                                                           Foreground="{DynamicResource TextCaption}" />
                                                                                                                                                                                                                                                                                                                            </StackPanel>
                                                                                                                                                                                                                                                                                                                        </Button>
                                                                                                                                                                                                                                                                                                                        <Button Grid.Column="1" Classes="row-action"
                                                                                                                                                                                                                                                                                                                                Opacity="1"
                                                                                                                                                                                                                                                                                                                                VerticalAlignment="Center"
                                                                                                                                                                                                                                                                                                                                Click="OnUnarchiveSessionClicked"
                                                                                                                                                                                                                                                                                                                                ToolTip.Tip="{DynamicResource S.be235f67}">
                                                                                                                                                                                                                                                                                                                            <Path Width="13" Height="13"
                                                                                                                                                                                                                                                                                                                                  Data="{DynamicResource RefreshIcon}"
                                                                                                                                                                                                                                                                                                                                  Stretch="Uniform" />
                                                                                                                                                                                                                                                                                                                        </Button>
                                                                                                                                                                                                                                                                                                                    </Grid>
                                                                                                                                                                                                                                                                                                                </DataTemplate>
                                                                                                                                                                                                                                                                                                            </ItemsControl.ItemTemplate>
                                                                                                                                                                                                                                                                                                        </ItemsControl>
                                                                                                                                                                                                                                                                                                        <TextBlock Text="{DynamicResource S.aed83b8d}"
                                                                                                                                                                                                                                                                                                                   IsVisible="{Binding !ShowArchivedSessions}"
                                                                                                                                                                                                                                                                                                                   FontSize="12.5"
                                                                                                                                                                                                                                                                                                                   Foreground="{DynamicResource TextCaption}"
                                                                                                                                                                                                                                                                                                                   Margin="12,10" />
                                                                                                                                                                                                                                                                                                    </StackPanel>
                                                                                                                                                                                                                                                                                                </Border>
                                                                                                                                                                                                                                                                                            </StackPanel>
                                                                                                                                                                                                                                                                                        </StackPanel>
                            <StackPanel IsVisible="{Binding IsSettingsStorage}" Spacing="50" Classes="settings-pane">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.625644b3}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.7885e0c5}" HorizontalAlignment="Left" Margin="0,6,0,0" MaxWidth="620" />
                            <TextBlock Text="{Binding StorageScopeText}" IsVisible="{Binding HasStorageScopeText}" FontSize="12" Foreground="{DynamicResource WarningAccent}" Margin="0,6,0,0" MaxWidth="620" TextWrapping="Wrap" />
                            <StackPanel Spacing="0" Margin="0,12,0,-14">
                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding StorageTotalLabel}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" /><Button Grid.Column="1" Classes="secondary settings-button" Height="26" Content="{DynamicResource S.aee88743}" Click="OnRefreshStorageClicked" /></Grid>
                            <Border Height="18" CornerRadius="9" ClipToBounds="True" Margin="0,12,0,0">
                            <Grid x:Name="StorageBar" ColumnDefinitions="1*,1*,1*,1*" IsVisible="{Binding HasStorageUsage}"><Border Background="#E3C63B" /><Border Grid.Column="1" Background="#4CD07D" /><Border Grid.Column="2" Background="#4C9FE8" /><Border Grid.Column="3" Background="#6B6B70" /></Grid>
                            </Border>
                            <Grid ColumnDefinitions="*,*,*,*" Margin="0,12,0,0">
                            <StackPanel Spacing="4"><StackPanel Orientation="Horizontal" Spacing="7"><Border Width="9" Height="9" CornerRadius="5" Background="#E3C63B" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource S.5948628c}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" /></StackPanel><TextBlock Text="{Binding StorageChatSizeLabel}" FontSize="11.5" Foreground="{DynamicResource TextCaption}" Margin="0,-3,0,0" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4"><StackPanel Orientation="Horizontal" Spacing="7"><Border Width="9" Height="9" CornerRadius="5" Background="#4CD07D" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource S.c7225dbf}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" /></StackPanel><TextBlock Text="{Binding StorageAttachmentSizeLabel}" FontSize="11.5" Foreground="{DynamicResource TextCaption}" Margin="0,-3,0,0" /></StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4"><StackPanel Orientation="Horizontal" Spacing="7"><Border Width="9" Height="9" CornerRadius="5" Background="#4C9FE8" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource S.e806fbbe}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" /></StackPanel><TextBlock Text="{Binding StoragePluginSizeLabel}" FontSize="11.5" Foreground="{DynamicResource TextCaption}" Margin="0,-3,0,0" /></StackPanel>
                            <StackPanel Grid.Column="3" Spacing="4"><StackPanel Orientation="Horizontal" Spacing="7"><Border Width="9" Height="9" CornerRadius="5" Background="#6B6B70" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource S.d2909f16}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" /></StackPanel><TextBlock Text="{Binding StorageOtherSizeLabel}" FontSize="11.5" Foreground="{DynamicResource TextCaption}" Margin="0,-3,0,0" /></StackPanel>
                            </Grid>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.486670c1}" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11"><StackPanel Spacing="3"><TextBlock Classes="settings-title" Text="{DynamicResource S.c5a93ed9}" /><SelectableTextBlock Text="{Binding StateDirectory}" FontSize="11.5" Foreground="{DynamicResource TextCaption}" HorizontalAlignment="Left" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="{Binding StorageStatusText}" FontSize="11.5" Foreground="{DynamicResource TextCaption}" /><Button Classes="secondary settings-button" Click="OnCopyStatePathClicked" Content="{DynamicResource S.63d90d97}" /><Button Classes="secondary settings-button" Click="OnOpenStateDirectoryClicked" Content="{DynamicResource S.a8c81f93}" /></StackPanel></Grid>
                            <Border Classes="settings-divider" />
