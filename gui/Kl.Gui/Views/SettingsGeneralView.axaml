                            <Grid ColumnDefinitions="*,Auto" Margin="0,17,0,24">
                            <TextBlock Text="{Binding ActiveWorkspace.Name}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="subtle" Click="OnOpenCoreConfigClicked" Content="{DynamicResource S.0736cf4b}" />
                            </Grid>
                            <Border Classes="settings-card" Margin="0,0,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.8f5a2a45}" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650" Text="{DynamicResource S.b5588001}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center"
                                      SelectedIndex="{Binding ApprovalModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.20505064}" />
                            <ComboBoxItem Content="{DynamicResource S.79f1c34b}" />
                            <ComboBoxItem Content="{DynamicResource S.e7adfca8}" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.ea58d1c4}" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650" Text="{DynamicResource S.89e47a19}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="settings-value" VerticalAlignment="Center"
                                       Text="{Binding CoreSandboxText}" ToolTip.Tip="{DynamicResource S.1f94f97d}" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.d36b3a9b}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.0bcdbb24}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding NetworkAccess, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.e369180d}" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650" Text="{DynamicResource S.8c62901a}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding WebSearch, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.14987f14}" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650" Text="{DynamicResource S.affb6f10}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding OutputVerbosityIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.9a36b187}" />
                            <ComboBoxItem Content="{DynamicResource S.aa55960e}" />
                            <ComboBoxItem Content="{DynamicResource S.ca3634c7}" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.c2bf03dd}" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650" Text="{DynamicResource S.f744db20}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding ReasoningSummaryIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.7eb336e4}" />
                            <ComboBoxItem Content="{DynamicResource S.3fd47edc}" />
                            <ComboBoxItem Content="{DynamicResource S.ca3634c7}" />
                            </ComboBox>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.a153567f}" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.3717a020}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.f715ee48}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="{DynamicResource S.40ff6300}" VerticalAlignment="Center" Click="OnRunDoctorClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.837bc957}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="settings-value" Text="{Binding CoreVersionText}" MaxWidth="420" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.8b22196b}" />
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="{DynamicResource S.aee88743}" Click="OnRefreshConfigClicked" />
                            </Grid>
                            <TextBlock Text="{Binding ConfigStatusText}" Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="Auto,*" Margin="16,12,16,11" ColumnSpacing="16">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.1d27f02e}" />
                            <TextBlock Grid.Column="1" Text="{Binding ConfigPathText}" Classes="settings-value"
                                       TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <ItemsControl ItemsSource="{Binding ConfigRows}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConfigValueRow">
                            <Grid ColumnDefinitions="Auto,*" Margin="16,8" ColumnSpacing="16">
                            <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" Foreground="{DynamicResource TextCaption}"
                                       TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource S.09ee8b39}" IsVisible="{Binding !ShowConfigRows}"
                                       FontSize="12.5" Foreground="{DynamicResource TextCaption}" Margin="16,10,16,14" />
                            <StackPanel IsVisible="{Binding HasDoctorSummary}" Margin="16,4,16,14" Spacing="4">
                            <TextBlock Text="{Binding DoctorSummary}" FontSize="12.5"
                                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding DoctorChecks}" IsVisible="{Binding HasDoctorChecks}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11.5"
                                       Foreground="{DynamicResource TextCaption}" TextWrapping="Wrap" />
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsSettingsPersonalization}" Spacing="50" Classes="settings-pane">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.74f72b91}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.3ce32715}" Margin="0,6,0,0" HorizontalAlignment="Left" MaxWidth="650" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.b9673097}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.77e46f43}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="{DynamicResource S.bb6d9957}" VerticalAlignment="Center" Click="OnOpenMemorySettingsClicked" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <StackPanel Margin="16,0,16,12"><TextBlock Classes="settings-desc" Text="{DynamicResource S.c0792357}" /></StackPanel>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.d0c87090}" Margin="0,6,0,0" HorizontalAlignment="Left" MaxWidth="650" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.ffa0a402}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.d3f55af5}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding MemoryEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.d86d4d5c}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.a35df9be}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="danger" Content="{DynamicResource S.2f9daa82}" Click="OnDeleteAllMemoriesClicked" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.d63307a8}" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.d63307a8}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding PersonalStyleIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.844b8cc8}" />
                            <ComboBoxItem Content="{DynamicResource S.d37bab70}" />
                            <ComboBoxItem Content="{DynamicResource S.349b21c0}" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.c191d033}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding WarmthIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.844b8cc8}" />
                            <ComboBoxItem Content="{DynamicResource S.aa9e366f}" />
                            <ComboBoxItem Content="{DynamicResource S.b1c27820}" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.4f31cc18}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding EnthusiasmIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.844b8cc8}" />
                            <ComboBoxItem Content="{DynamicResource S.aa9e366f}" />
                            <ComboBoxItem Content="{DynamicResource S.b1c27820}" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.4186bf69}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding EmojiIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.844b8cc8}" />
                            <ComboBoxItem Content="{DynamicResource S.185161ee}" />
                            <ComboBoxItem Content="{DynamicResource S.123321c4}" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.f46202db}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding VisualAnswersIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.844b8cc8}" />
                            <ComboBoxItem Content="{DynamicResource S.3fd47edc}" />
                            <ComboBoxItem Content="{DynamicResource S.8da97ddd}" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.6fbb8dd8}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding HeadingStyleIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.844b8cc8}" />
                            <ComboBoxItem Content="{DynamicResource S.aa55960e}" />
                            <ComboBoxItem Content="{DynamicResource S.ca3634c7}" />
                            </ComboBox>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.d4991789}" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="AGENTS.md" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.c20560ad}" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnEditAgentsClicked" ToolTip.Tip="{DynamicResource S.550575d3}">
                            <Path Classes="row-chevron" Width="10" Height="10" Data="{DynamicResource ChevronRightIcon}" Stretch="Uniform" Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                            </Button>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <StackPanel Margin="16,12,16,12" Spacing="8">
                            <TextBox Classes="settings-textarea" Height="90" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding CustomInstructionsDraft, Mode=TwoWay}" PlaceholderText="{DynamicResource S.13a7776a}" />
                            <Button Classes="secondary settings-button" Content="{DynamicResource S.cda0ef47}" HorizontalAlignment="Right" Click="OnSaveCustomInstructionsClicked" />
                            </StackPanel>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsSettingsMemory}" Spacing="50" Classes="settings-pane">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.1c21bf72}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="segment" Classes.active="{Binding IsMemoryScopeUser}" Click="OnMemoryScopeUserClicked" Content="{DynamicResource S.0d0e1a86}" />
                            <Button Classes="segment" Classes.active="{Binding IsMemoryScopeWorkspace}" Click="OnMemoryScopeWorkspaceClicked" Content="{DynamicResource S.37979829}" />
                            </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding MemoryScopeHint}" Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11" ColumnSpacing="10">
                            <TextBlock Text="{Binding MemoryStatus}" Classes="settings-desc" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary settings-button" Content="{DynamicResource S.aee88743}" Click="OnRefreshMemoryClicked" />
                            <Button Classes="secondary settings-button" Content="{DynamicResource S.50ef2f4c}" Click="OnNewMemoryClicked" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <ItemsControl ItemsSource="{Binding MemoryEntries}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MemoryEntryRow">
                            <Button Classes="more-menu-item" Height="36" Click="OnMemoryEntryClicked" Tag="{Binding Name}">
                            <Grid ColumnDefinitions="*,Auto" Margin="6,0" ColumnSpacing="12">
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" FontSize="11.5" Foreground="{DynamicResource TextCaption}" VerticalAlignment="Center" />
                            </Grid>
                            </Button>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource S.d36f463e}" IsVisible="{Binding !ShowMemoryEntries}"
                                       FontSize="12.5" Foreground="{DynamicResource TextCaption}" Margin="16,10,16,14" />
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.2d8c7359}" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel Spacing="10" Margin="16,12,16,11">
                            <TextBox Classes="settings-input" Text="{Binding MemoryName, Mode=TwoWay}" PlaceholderText="{DynamicResource S.85e5ec26}" />
                            <TextBox Classes="settings-input" Text="{Binding MemoryContent, Mode=TwoWay}"
                                     AcceptsReturn="True" Height="170" TextWrapping="Wrap"
                                     PlaceholderText="{DynamicResource S.a1e87f0e}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Classes="danger" Content="{DynamicResource S.81385c38}" Click="OnDeleteMemoryClicked" />
                            <Button Classes="primary" Content="{DynamicResource S.a3030bf8}" Click="OnSaveMemoryClicked" IsEnabled="{Binding CanSaveMemory}" />
                            </StackPanel>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding IsSettingsShortcuts}" Spacing="50" Classes="settings-pane">
                            <Border Classes="search-field" Margin="0,6,0,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Path Width="13" Height="13" Data="{DynamicResource SearchIcon}" Stretch="Uniform" Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.35" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Classes="search" PlaceholderText="{DynamicResource S.49504fdf}" Text="{Binding ShortcutSearch, Mode=TwoWay}" />
                            </Grid>
                            </Border>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.40b5f61c}" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{DynamicResource S.40b5f61c}" />
                            <TextBlock Classes="settings-desc" Text="{DynamicResource S.672c0fa9}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" SelectedIndex="{Binding NumberShortcutsIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{DynamicResource S.0a574b6c}" />
                            <ComboBoxItem Content="{DynamicResource S.3fd47edc}" />
                            </ComboBox>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <Border IsVisible="{Binding IsShortcutCapturing}" Classes="settings-card settings-tab-page" Background="#1B1B1E" BorderBrush="#3A3A40" BorderThickness="1">
                            <StackPanel Margin="16,12,16,12" Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                            <TextBlock Text="{Binding ShortcutCaptureTitle}" Classes="settings-title" />
                            <TextBlock Text="{DynamicResource S.5e992fd1}" Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="600" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="subtle" Content="{DynamicResource S.2cd0f3be}" Click="OnCancelShortcutCaptureClicked" VerticalAlignment="Top" />
                            </Grid>
                            <TextBlock Text="{Binding ShortcutCaptureStatus}" IsVisible="{Binding HasShortcutCaptureStatus}" FontSize="11.5" Foreground="#E36B6B" TextWrapping="Wrap" />
                            </StackPanel>
                            </Border>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="{DynamicResource S.5dc52ea7}" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <ItemsControl ItemsSource="{Binding ShortcutRows}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShortcutRowViewModel">
                            <StackPanel IsVisible="{Binding IsVisible}">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,16,11" ColumnSpacing="10">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="{Binding Title}" />
                            <TextBlock Classes="settings-desc" Text="{Binding Description}" HorizontalAlignment="Left" MaxWidth="620" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#2A2A2D" CornerRadius="6" Padding="7,2" VerticalAlignment="Center" IsVisible="{Binding HasGesture}">
                            <TextBlock Text="{Binding Gesture}" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{DynamicResource S.52496e5a}" IsVisible="{Binding !HasGesture}" FontSize="11.5" Foreground="{DynamicResource TextCaption}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnShortcutEditClicked" ToolTip.Tip="{DynamicResource S.7892e109}">
                            <Path Width="13" Height="13" Data="{DynamicResource EditIcon}" Stretch="Uniform" Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            <Button Grid.Column="3" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnShortcutResetClicked" ToolTip.Tip="{DynamicResource S.dcc045b9}">
                            <Path Width="13" Height="13" Data="{DynamicResource TrashIcon}" Stretch="Uniform" Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            </Grid>
                            <Border Classes="settings-divider" Margin="16,0,16,0" />
                            </StackPanel>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource S.078e8e58}" IsVisible="{Binding ShowNoShortcutMatches}" FontSize="12.5" Foreground="{DynamicResource TextCaption}" Margin="16,14,16,16" />
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>
    </StackPanel>
</UserControl>
