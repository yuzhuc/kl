                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Classes="settings-title" Text="{DynamicResource S.7c3708f6}" /><TextBlock Classes="settings-desc" Text="{DynamicResource S.a2c1be71}" /></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Classes="secondary settings-button" Click="OnExportStateBackupClicked" Content="{DynamicResource S.bc132600}" /><Button Classes="secondary settings-button" Click="OnImportStateBackupClicked" Content="{DynamicResource S.86bbe690}" /></StackPanel>
                            </Grid>
