                            <TextBlock Classes="settings-desc" Text="在侧边聊天中打开当前聊天" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="Ctrl+Alt+S" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
