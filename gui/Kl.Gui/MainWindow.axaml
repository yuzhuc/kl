<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Kl.Gui.ViewModels"
        xmlns:controls="using:Kl.Gui.Controls"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Kl.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="kl"
        Icon="/Assets/kl.png"
        Width="1280" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBase}"
        FontFamily="{StaticResource UiFont}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        KeyDown="OnWindowKeyDown"
        PointerPressed="OnWindowPointerPressed"
        Deactivated="OnWindowDeactivated"
        Closing="OnWindowClosing">

    <Window.Resources>
        <DataTemplate x:Key="AttachmentChipTemplate" x:DataType="vm:AttachmentItemViewModel">
            <Border Background="{StaticResource ElevatedHover}" CornerRadius="8" Padding="8,4" Margin="0,0,6,4">
                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                    <Path Width="13" Height="13" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                          Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3"
                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                          VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="{Binding SizeLabel}" FontSize="10" Foreground="{StaticResource TextCaption}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="message-action" Width="18" Height="18" Padding="0"
                            Click="OnRemoveAttachmentClicked" ToolTip.Tip="移除附件">
                        <TextBlock Text="×" FontSize="13" Foreground="{StaticResource TextCaption}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NestedSessionRowTemplate" x:DataType="vm:SessionItemViewModel">
            <Grid Classes="session-row-container" IsVisible="{Binding IsListVisible}" Margin="24,0,8,1">
                <Button Classes="session-row nested" Classes.active="{Binding IsSelected}" Click="OnSessionClicked"
                        PointerEntered="OnSessionRowPointerEntered"
                        PointerExited="OnSessionRowPointerExited">
                    <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="0,0,76,0" />
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Classes="row-action" Classes.pinned="{Binding IsPinned}"
                            Click="OnPinSessionClicked" ToolTip.Tip="置顶">
                        <Path Width="13" Height="13" Data="{StaticResource PinIcon}" Stretch="Uniform"
                              RenderTransform="rotate(45deg)" />
                    </Button>
                    <Button Classes="row-action" Click="OnArchiveSessionClicked" ToolTip.Tip="归档">
                        <Path Width="13" Height="13" Data="{StaticResource ArchiveIcon}" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WorkspaceRowTemplate" x:DataType="vm:WorkspaceItemViewModel">
            <StackPanel IsVisible="{Binding IsVisible}">
                <Grid Classes="session-row-container" Margin="8,0,8,1">
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="置顶" Click="OnWorkspacePinMenuClicked" />
                            <MenuItem Header="归档聊天" Click="OnWorkspaceArchiveMenuClicked" />
                            <MenuItem Header="移除项目" Click="OnWorkspaceRemoveMenuClicked" />
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <Button Classes="row" Height="30" Padding="10,0" CornerRadius="8"
                            Click="OnWorkspaceClicked"
                            PointerEntered="OnWorkspaceRowPointerEntered"
                            PointerExited="OnWorkspaceRowPointerExited">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <Path Width="16" Height="16" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                  StrokeThickness="1.35"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,76,0" />
                        </Grid>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Classes="row-action" Click="OnWorkspaceMoreClicked" ToolTip.Tip="更多">
                            <Path Width="13" Height="13" Data="{StaticResource MoreIcon}" Stretch="Uniform" />
                        </Button>
                        <Button Classes="row-action" Click="OnWorkspaceEditClicked" ToolTip.Tip="编辑项目">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock Text="暂无聊天" IsVisible="{Binding HasNoSessions}" FontSize="12"
                           Foreground="{StaticResource SidebarLabel}" Margin="40,4,0,6" />
                <ItemsControl ItemsSource="{Binding Sessions}" IsVisible="{Binding ShowSessions}"
                              ItemTemplate="{StaticResource NestedSessionRowTemplate}" Margin="0,0,0,2" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RecentSessionTemplate" x:DataType="vm:SessionItemViewModel">
            <Grid Classes="session-row-container" IsVisible="{Binding IsListVisible}" Margin="8,0,8,1">
                <Button Classes="session-row" Classes.active="{Binding IsSelected}" Click="OnSessionClicked"
                        PointerEntered="OnSessionRowPointerEntered"
                        PointerExited="OnSessionRowPointerExited">
                    <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="0,0,76,0" />
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Classes="row-action" Classes.pinned="{Binding IsPinned}"
                            Click="OnPinSessionClicked" ToolTip.Tip="置顶">
                        <Path Width="13" Height="13" Data="{StaticResource PinIcon}" Stretch="Uniform"
                              RenderTransform="rotate(45deg)" />
                    </Button>
                    <Button Classes="row-action" Click="OnArchiveSessionClicked" ToolTip.Tip="归档">
                        <Path Width="13" Height="13" Data="{StaticResource ArchiveIcon}" Stretch="Uniform" />
                    </Button>
                </StackPanel>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="重命名" Click="OnRenameSessionClicked" Tag="{Binding}" />
                        <MenuItem Header="删除" Click="OnDeleteSessionClicked" Tag="{Binding}" />
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ArchivedSessionTemplate" x:DataType="vm:SessionItemViewModel">
            <Grid Classes="session-row-container" IsVisible="{Binding IsListVisible}" Margin="8,0,8,1">
                <Button Classes="session-row" Click="OnSessionClicked" ToolTip.Tip="{Binding Workspace.Path}">
                    <TextBlock Text="{Binding Title}" FontSize="13.5" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{StaticResource SidebarLabel}" Margin="0,0,36,0" />
                </Button>
                <Button Classes="row-action" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,4,0" Click="OnUnarchiveSessionClicked" ToolTip.Tip="取消归档">
                    <Path Width="13" Height="13" Data="{StaticResource RefreshIcon}" Stretch="Uniform" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ToolChildTemplate" x:DataType="vm:ChatItemViewModel">
            <StackPanel Spacing="4">
                <Button Classes="activity-row" Classes.expanded="{Binding ShowExpanded}" Click="OnActivityClicked">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource ToolIcon}" Stretch="Uniform"
                              IsVisible="{Binding IsPlainTool}" Stroke="#7E7F82" StrokeThickness="1.35"
                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              VerticalAlignment="Center" />
                        <Path Width="14" Height="14" Data="{StaticResource ImageIcon}" Stretch="Uniform"
                              IsVisible="{Binding IsImageTool}" Stroke="#7E7F82" StrokeThickness="1.2"
                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActivityPrefix}" FontSize="12.5"
                                       Foreground="#C6C7C9" VerticalAlignment="Center" />
                            <Border IsVisible="{Binding HasActivityCommand}" Background="#202022"
                                    CornerRadius="6" Padding="5,1" MaxWidth="520"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActivityCommand}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                           Foreground="#C6C7C9" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{StaticResource TextCaption}"
                                       IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
                            <Path Classes="activity-chevron" Width="11" Height="11"
                                  Data="{StaticResource ChevronRightIcon}" Stretch="Uniform"
                                  IsVisible="{Binding ShowCollapsed}" Stroke="#7E7F82" StrokeThickness="1.4"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <Path Width="11" Height="11" Data="{StaticResource ChevronDownIcon}"
                                  Stretch="Uniform" IsVisible="{Binding ShowExpanded}"
                                  Stroke="#7E7F82" StrokeThickness="1.4"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Border IsVisible="{Binding ShowExpanded}" Background="#202022"
                        BorderBrush="#2E2E31" BorderThickness="1"
                        CornerRadius="10" Padding="12,10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ToolLabel}" FontSize="11.5"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{StaticResource TextTertiary}"
                                   IsVisible="{Binding IsTool}" />
                        <StackPanel IsVisible="{Binding IsTool}" Spacing="7">
                            <SelectableTextBlock Text="{Binding Text}"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                 Foreground="{StaticResource TextSecondary}"
                                                 TextWrapping="Wrap" MaxHeight="140" />
                            <ScrollViewer IsVisible="{Binding HasDetail}" MaxHeight="260"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <SelectableTextBlock Text="{Binding Detail}"
                                                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                     Foreground="{StaticResource TextSecondary}"
                                                     TextWrapping="Wrap" />
                            </ScrollViewer>
                            <TextBlock Text="{Binding Summary}" FontSize="11"
                                       Foreground="{StaticResource TextCaption}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right"
                                    IsVisible="{Binding HasStatus}">
                            <Path Width="12" Height="12" Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                  IsVisible="{Binding !HasFailure}" Stroke="#7FBF8F" StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <Path Width="12" Height="12" Data="{StaticResource CloseIcon}" Stretch="Uniform"
                                  IsVisible="{Binding HasFailure}" Stroke="#E5837C" StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                       Foreground="#7FBF8F" IsVisible="{Binding !HasFailure}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                       Foreground="#E5837C" IsVisible="{Binding HasFailure}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ChatItemTemplate" x:DataType="vm:ChatItemViewModel">
            <Grid>
                <!-- user bubble -->
                <StackPanel Classes="chat-user" IsVisible="{Binding IsUser}" HorizontalAlignment="Right" Spacing="3"
                            Margin="0,0,0,14">
                    <Border MaxWidth="560" Background="{StaticResource UserBubbleFill}" CornerRadius="18"
                            Padding="13,8" HorizontalAlignment="Right">
                        <SelectableTextBlock Text="{Binding Text}"
                                             FontSize="{DynamicResource ChatContentFontSize}"
                                             LineHeight="{DynamicResource ChatContentLineHeight}"
                                             Foreground="{StaticResource TextPrimary}"
                                             TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Classes="chat-user-actions" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="2">
                        <TextBlock Text="{Binding TimestampLabel}" FontSize="11"
                                   Foreground="{StaticResource TextCaption}" VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                        <Button Classes="message-action" Click="OnCopyMessageClicked" ToolTip.Tip="复制">
                            <Path Width="13" Height="13" Data="{StaticResource CopyIcon}" Stretch="Uniform" />
                        </Button>
                        <Button Classes="message-action" Click="OnEditUserMessageClicked" ToolTip.Tip="编辑">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- assistant -->
                <StackPanel IsVisible="{Binding IsAssistant}" Spacing="4" Margin="0,0,0,14">
                    <controls:MarkdownTextBlock Text="{Binding Text}"
                                                ContentFontSize="{DynamicResource ChatContentFontSize}"
                                                ContentLineHeight="{DynamicResource ChatContentLineHeight}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Foreground="{StaticResource TextCaption}"
                               IsVisible="{Binding HasStatus}" />
                    <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding ShowAssistantActions}">
                        <Button Classes="message-action" Click="OnCopyMessageClicked" ToolTip.Tip="复制回复">
                            <Path Width="13" Height="13" Data="{StaticResource CopyIcon}" Stretch="Uniform" />
                        </Button>
                        <Button Classes="message-action" ToolTip.Tip="更多">
                            <Path Width="13" Height="13" Data="{StaticResource MoreIcon}" Stretch="Uniform" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="复制回复" Click="OnCopyMessageClicked" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock Text="{Binding TimestampLabel}" IsVisible="{Binding HasTimestamp}"
                                   FontSize="11" Foreground="{StaticResource TextCaption}"
                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- error -->
                <Border IsVisible="{Binding IsError}" Margin="0,0,0,14" Background="#2A20221F" BorderBrush="#553B3B2B"
                        BorderThickness="0.5" CornerRadius="10" Padding="12,9">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                        <Path Width="14" Height="14" Data="{StaticResource WarningIcon}" Stretch="Uniform"
                              Stroke="#E6A0A0" StrokeThickness="1.4"
                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              VerticalAlignment="Top" Margin="0,3,0,0" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5" LineHeight="19"
                                             Foreground="#E6B4B4" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- grouped tool calls (运行了命令) -->
                <StackPanel IsVisible="{Binding IsToolGroup}" Spacing="2" Margin="0,0,0,2">
                    <Button Classes="activity-row" Classes.expanded="{Binding GroupExpanded}" Click="OnActivityClicked">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Path Width="14" Height="14" Data="{StaticResource ToolIcon}" Stretch="Uniform"
                                  IsVisible="{Binding !IsImageTool}" Stroke="#7E7F82" StrokeThickness="1.35"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <Path Width="14" Height="14" Data="{StaticResource ImageIcon}" Stretch="Uniform"
                                  IsVisible="{Binding IsImageTool}" Stroke="#7E7F82" StrokeThickness="1.2"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Header}" FontSize="12.5"
                                       Foreground="#C6C7C9" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <Path Classes="activity-chevron" Width="11" Height="11"
                                      Data="{StaticResource ChevronRightIcon}" Stretch="Uniform"
                                      Stroke="#7E7F82" StrokeThickness="1.4"
                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding GroupExpanded}"
                                  ItemTemplate="{StaticResource ToolChildTemplate}" />
                </StackPanel>

                <!-- reasoning / tool activity (Codex-style inline row + expanded shell panel) -->
                <StackPanel IsVisible="{Binding IsActivity}" Spacing="4" Margin="0,0,0,8">
                    <Button Classes="activity-row" Classes.expanded="{Binding ShowExpanded}" Click="OnActivityClicked">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Path Width="14" Height="14" Data="{StaticResource ThoughtIcon}" Stretch="Uniform"
                                  IsVisible="{Binding IsReasoning}" Stroke="#7E7F82" StrokeThickness="1.35"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <Path Width="14" Height="14" Data="{StaticResource ToolIcon}" Stretch="Uniform"
                                  IsVisible="{Binding IsPlainTool}" Stroke="#7E7F82" StrokeThickness="1.35"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <Path Width="14" Height="14" Data="{StaticResource ImageIcon}" Stretch="Uniform"
                                  IsVisible="{Binding IsImageTool}" Stroke="#7E7F82" StrokeThickness="1.2"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActivityPrefix}" FontSize="12.5"
                                           Foreground="#C6C7C9" VerticalAlignment="Center" />
                                <Border IsVisible="{Binding HasActivityCommand}" Background="#202022"
                                        CornerRadius="6" Padding="5,1" MaxWidth="520"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActivityCommand}"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                               Foreground="#C6C7C9" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                           Foreground="{StaticResource TextCaption}"
                                           IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
                                <Path Classes="activity-chevron" Width="11" Height="11"
                                      Data="{StaticResource ChevronRightIcon}" Stretch="Uniform"
                                      Stroke="#7E7F82" StrokeThickness="1.4"
                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Border IsVisible="{Binding ShowExpanded}" Background="#202022"
                            BorderBrush="#2E2E31" BorderThickness="1"
                            CornerRadius="10" Padding="12,10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding ToolLabel}" FontSize="11.5"
                                       FontFamily="Cascadia Mono, Consolas"
                                       Foreground="{StaticResource TextTertiary}"
                                       IsVisible="{Binding IsTool}" />
                            <SelectableTextBlock Text="{Binding Text}" IsVisible="{Binding IsReasoning}"
                                                 FontSize="12.5" LineHeight="19"
                                                 Foreground="{StaticResource TextSecondary}"
                                                 TextWrapping="Wrap" />
                            <StackPanel IsVisible="{Binding IsTool}" Spacing="7">
                                <SelectableTextBlock Text="{Binding Text}"
                                                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                     Foreground="{StaticResource TextSecondary}"
                                                     TextWrapping="Wrap" MaxHeight="140" />
                                <ScrollViewer IsVisible="{Binding HasDetail}" MaxHeight="260"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <SelectableTextBlock Text="{Binding Detail}"
                                                         FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                         Foreground="{StaticResource TextSecondary}"
                                                         TextWrapping="Wrap" />
                                </ScrollViewer>
                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                           Foreground="{StaticResource TextCaption}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right"
                                        IsVisible="{Binding HasStatus}">
                                <Path Width="12" Height="12" Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                      IsVisible="{Binding !HasFailure}" Stroke="#7FBF8F" StrokeThickness="1.6"
                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      VerticalAlignment="Center" />
                                <Path Width="12" Height="12" Data="{StaticResource CloseIcon}" Stretch="Uniform"
                                      IsVisible="{Binding HasFailure}" Stroke="#E5837C" StrokeThickness="1.6"
                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                           Foreground="#7FBF8F" IsVisible="{Binding !HasFailure}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                           Foreground="#E5837C" IsVisible="{Binding HasFailure}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="40,*">
        <!-- ===================== Title bar ===================== -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarFill}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2" Margin="8,0,0,0">
                    <Button Classes="titlebar-icon" IsEnabled="False" ToolTip.Tip="后退">
                        <Path Width="13" Height="13" Data="{StaticResource ChevronLeftIcon}" />
                    </Button>
                    <Button Classes="titlebar-icon" IsEnabled="False" ToolTip.Tip="前进">
                        <Path Width="13" Height="13" Data="{StaticResource ChevronRightIcon}" />
                    </Button>
                    <Button Classes="titlebar-icon" Click="OnToggleSidebarClicked" ToolTip.Tip="切换侧边栏">
                        <Path Width="14" Height="14" Data="{StaticResource PanelIcon}" />
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="0" Margin="6,0,0,0">
                        <Button Classes="titlebar-menu" Content="文件">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="新建会话" Click="OnNewSessionClicked" />
                                    <MenuItem Header="添加项目" Click="OnAddWorkspaceClicked" />
                                    <Separator />
                                    <MenuItem Header="退出" Click="OnExitClicked" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="titlebar-menu" Content="编辑">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="搜索会话" Click="OnToggleSearchClicked" />
                                    <MenuItem Header="设置" Click="OnNavSettingsClicked" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="titlebar-menu" Content="视图">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="显示/隐藏侧边栏" Click="OnToggleSidebarClicked" />
                                    <MenuItem Header="打开设置" Click="OnNavSettingsClicked" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="titlebar-menu" Content="帮助">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="关于 kl" Click="OnShowAboutClicked" />
                                    <MenuItem Header="打开数据目录" Click="OnOpenStateDirectoryClicked" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Background="Transparent"
                      PointerPressed="OnTitleBarPointerPressed"
                      DoubleTapped="OnTitleBarDoubleTapped" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Classes="caption" Click="OnMinimizeClicked" ToolTip.Tip="最小化">
                        <Border Width="10" Height="1" Background="{DynamicResource TextSecondary}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>
                    <Button Classes="caption" Click="OnMaximizeClicked" ToolTip.Tip="最大化">
                        <Path x:Name="MaximizeGlyph" Width="11" Height="11" Data="{StaticResource MaximizeIcon}" />
                    </Button>
                    <Button Classes="caption close" Click="OnCloseWindowClicked" ToolTip.Tip="关闭">
                        <Path Width="12" Height="12" Data="{StaticResource CloseIcon}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Body ===================== -->
        <Grid Grid.Row="1" ColumnDefinitions="52,Auto,*">
            <!-- rail -->
            <Border Grid.Column="0" Background="{StaticResource SidebarRailFill}"
                    BorderBrush="{StaticResource SidebarDivider}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="6" Margin="0,14,0,0">
                        <Button x:Name="ChatRailButton" Classes="rail" Classes.active="{Binding IsChatPage}"
                                HorizontalAlignment="Center" Click="OnNavChatClicked" Tag="首页"
                                ToolTip.Tip="首页" ToolTip.Placement="Right" ToolTip.HorizontalOffset="12" ToolTip.VerticalOffset="-2"
                                ToolTip.ShowDelay="450">
                            <Viewbox Width="21" Height="21">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="rail-line" Data="{StaticResource RailChatIcon}" Stretch="None"
                                          StrokeThickness="1.54" />
                                    <Path Classes="rail-solid" Data="{StaticResource RailChatIcon}" Stretch="None" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="AutomationRailButton" Classes="rail" Classes.active="{Binding IsAutomationPage}"
                                HorizontalAlignment="Center" Click="OnNavAutomationClicked" Tag="定时任务"
                                ToolTip.Tip="定时任务" ToolTip.Placement="Right" ToolTip.HorizontalOffset="12" ToolTip.VerticalOffset="-2"
                                ToolTip.ShowDelay="450">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="rail-line" Data="{StaticResource RailAutomationIcon}" Stretch="None"
                                          StrokeThickness="1.8" />
                                    <Path Classes="rail-solid" Data="{StaticResource RailAutomationSolid}" Stretch="None" />
                                    <Path Classes="rail-cut" Data="{StaticResource RailAutomationHands}" Stretch="None"
                                          StrokeThickness="2.2" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Classes="rail" Classes.active="{Binding IsLibraryPage}"
                                HorizontalAlignment="Center" Click="OnNavLibraryClicked" Tag="资料库"
                                ToolTip.Tip="资料库" ToolTip.Placement="Right" ToolTip.HorizontalOffset="12"
                                ToolTip.VerticalOffset="-2" ToolTip.ShowDelay="450">
                            <Viewbox Width="26" Height="26">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="rail-line" Data="{StaticResource RailLibraryIcon}" Stretch="None"
                                          StrokeThickness="1.25" />
                                    <Path Classes="rail-solid" Data="{StaticResource RailLibrarySolid}" Stretch="None" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="PluginsRailButton" Classes="rail" Classes.active="{Binding IsPluginsPage}"
                                HorizontalAlignment="Center" Click="OnNavPluginsClicked" Tag="插件"
                                ToolTip.Tip="插件" ToolTip.Placement="Right" ToolTip.HorizontalOffset="12" ToolTip.VerticalOffset="-2"
                                ToolTip.ShowDelay="450">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="rail-line" Data="{StaticResource RailPluginIcon}" Stretch="None"
                                          StrokeThickness="1.8" />
                                    <Path Classes="rail-solid" Data="{StaticResource RailPluginSolid}" Stretch="None" />
                                    <Path Classes="rail-cut" Data="{StaticResource RailPluginInner}" Stretch="None"
                                          StrokeThickness="2.1" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="MoreButton" Classes="rail" HorizontalAlignment="Center"
                                Click="OnMoreButtonClicked"
                                PointerEntered="OnMoreButtonPointerEntered" PointerExited="OnMoreButtonPointerExited">
                            <StackPanel Orientation="Horizontal" Spacing="2.5" VerticalAlignment="Center">
                                <Ellipse Width="2" Height="2" />
                                <Ellipse Width="2" Height="2" />
                                <Ellipse Width="2" Height="2" />
                            </StackPanel>
                        </Button>
                        <Border Width="24" Height="1" Background="#1D1D1F"
                                HorizontalAlignment="Center" Margin="0,2,0,2" />
                        <ItemsControl ItemsSource="{Binding PinnedRailItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PinnedRailItemViewModel">
                                    <Button Classes="rail pinned" Classes.active="{Binding IsActive}"
                                            HorizontalAlignment="Center"
                                            Click="OnPinnedRailItemClicked"
                                            ToolTip.Tip="{Binding Label}"
                                            ToolTip.Placement="Right" ToolTip.HorizontalOffset="12"
                                            ToolTip.VerticalOffset="-2" ToolTip.ShowDelay="450">
                                        <Grid>
                                            <Path Width="16" Height="16" Data="{StaticResource FolderIcon}"
                                                  Stretch="Uniform" IsVisible="{Binding IsProject}" />
                                            <Path Width="15" Height="15" Data="{StaticResource CodeReviewIcon}"
                                                  Stretch="Uniform" IsVisible="{Binding !IsProject}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Button Grid.Row="2" Classes="rail" Width="32" Height="32" HorizontalAlignment="Center"
                            Margin="0,0,0,12" Click="OnNavSettingsClicked" ToolTip.Tip="设置"
                            ToolTip.Placement="Right" ToolTip.HorizontalOffset="12" ToolTip.VerticalOffset="-2" ToolTip.ShowDelay="450">
                        <Path Width="18" Height="18" Data="{StaticResource SettingsIcon}" Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <!-- sidebar -->
            <Border x:Name="SidebarPanelBorder" Grid.Column="1" Width="284" ClipToBounds="True"
                    Background="{StaticResource SidebarFill}"
                    BorderBrush="{StaticResource SidebarDivider}" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- chat sidebar -->
                    <Grid IsVisible="{Binding IsChatPage}" RowDefinitions="Auto,Auto,Auto,*">
                        <Grid Grid.Row="0" Height="29" ColumnDefinitions="*,Auto" Margin="18,19,14,0">
                            <Button x:Name="ProductMenuButton" Classes="product-menu-toggle"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Click="OnProductMenuClicked" ToolTip.Tip="切换 Chat / Work">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveModeLabel}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource SidebarText}" />
                                    <Path Width="10" Height="10" Data="{StaticResource ChevronDownIcon}"
                                          Stretch="Uniform" Stroke="{StaticResource SidebarLabel}"
                                          StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"
                                          Fill="Transparent" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                        VerticalAlignment="Center">
                                <Button Classes="icon sidebar-icon" Classes.active="{Binding IsNotificationsVisible}"
                                        Click="OnNotificationsButtonClicked">
                                    <Path Width="14" Height="14" Data="{StaticResource BellIcon}" Stretch="Uniform" />
                                </Button>
                                <Button Classes="icon sidebar-icon" Click="OnSearchButtonClicked">
                                    <Path Width="14" Height="14" Data="{StaticResource SearchIcon}" Stretch="Uniform" />
                                </Button>
                            </StackPanel>

                            <!-- product / mode switcher, Codex-style -->
                            <Popup x:Name="ProductMenuPopup" PlacementTarget="{Binding #ProductMenuButton}"
                                   Placement="BottomEdgeAlignedLeft" HorizontalOffset="-11" VerticalOffset="14"
                                   IsLightDismissEnabled="True">
                                <Border Width="246" Background="{StaticResource ProductMenuFill}"
                                        BorderBrush="{StaticResource ProductMenuLine}" BorderThickness="1"
                                        CornerRadius="12" Padding="6"
                                        BoxShadow="0 14 34 0 #99000000">
                                    <StackPanel Spacing="2">
                                        <Button Classes="mode-menu-item" Click="OnChatModeMenuClicked">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                                                <TextBlock Text="Chat" FontSize="13.5"
                                                           Foreground="{StaticResource SidebarText}" />
                                                <TextBlock Grid.Row="1" Text="闲聊、提问和探索" FontSize="12"
                                                           Foreground="{StaticResource SidebarLabel}" />
                                                <Path Grid.Column="1" Grid.RowSpan="2" Width="14" Height="14"
                                                      Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                                      Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                      IsVisible="{Binding IsChatMode}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <Button Classes="mode-menu-item" Click="OnWorkModeMenuClicked">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                                                <TextBlock Text="Work" FontSize="13.5"
                                                           Foreground="{StaticResource SidebarText}" />
                                                <TextBlock Grid.Row="1" Text="构建、调试和发布" FontSize="12"
                                                           Foreground="{StaticResource SidebarLabel}" />
                                                <Path Grid.Column="1" Grid.RowSpan="2" Width="14" Height="14"
                                                      Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                                      Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                      IsVisible="{Binding IsWorkMode}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Border Grid.Row="1" IsVisible="{Binding IsSearchVisible}"
                                Background="{StaticResource ElevatedHover}" CornerRadius="8"
                                Height="34" Margin="6,0,6,8" Padding="12,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                <Path Width="13" Height="13" Data="{StaticResource SearchIcon}" Stretch="Uniform"
                                      Stroke="{StaticResource TextTertiary}" StrokeThickness="1.35"
                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      VerticalAlignment="Center" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" Classes="search"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="搜索会话" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- fixed new-chat row (Codex keeps this out of the scroll area) -->
                        <Button Grid.Row="2" Classes="row" Height="30" Padding="10,0" CornerRadius="8"
                                Margin="8,14,8,8" Click="OnNewSessionClicked"
                                IsVisible="{Binding !IsNotificationsVisible}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Path Width="16" Height="16" Data="{StaticResource EditIcon}" Stretch="Uniform"
                                      StrokeThickness="1.4"
                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="新聊天" FontSize="14"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Visible"
                                      AllowAutoHide="False"
                                      IsVisible="{Binding !IsNotificationsVisible}"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel IsVisible="{Binding HasPinnedSessions}" Margin="0,6,0,0">
                                    <Grid Classes="session-row-container">
                                        <Button Classes="section-header" Click="OnTogglePinnedSectionClicked">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="置顶" FontSize="13" LineHeight="21"
                                                           Foreground="{StaticResource SidebarLabel}"
                                                           VerticalAlignment="Center" />
                                                <Path Classes="section-chevron" Width="10" Height="10"
                                                      Data="{StaticResource ChevronDownIcon}" Stretch="Uniform"
                                                      Classes.collapsed="{Binding !IsPinnedExpanded}"
                                                      VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" Spacing="0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Margin="0,0,23,0">
                                            <Button Classes="row-action" Click="OnPinnedSectionMoreClicked">
                                                <Path Width="14" Height="14" Data="{StaticResource MoreIcon}"
                                                      Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl x:Name="PinnedItemsControl" ItemsSource="{Binding PinnedSessions}"
                                                  ItemTemplate="{StaticResource RecentSessionTemplate}"
                                                  IsVisible="{Binding IsPinnedExpanded}" />
                                </StackPanel>

                                <Grid Classes="session-row-container" Margin="0,16,0,0"
                                      IsVisible="{Binding IsSidebarGrouped}">
                                    <Button Classes="section-header"
                                            Click="OnToggleProjectSectionClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="项目" FontSize="13" LineHeight="21"
                                                       Foreground="{StaticResource SidebarLabel}" VerticalAlignment="Center" />
                                            <Path Classes="section-chevron" Width="10" Height="10"
                                                  Data="{StaticResource ChevronDownIcon}" Stretch="Uniform"
                                                  Classes.collapsed="{Binding !IsProjectSectionExpanded}"
                                                  VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,23,0">
                                        <Button Classes="row-action" Click="OnProjectSectionMoreClicked">
                                            <Path Width="14" Height="14" Data="{StaticResource MoreIcon}" Stretch="Uniform" />
                                        </Button>
                                        <Button Classes="row-action" Click="OnAddWorkspaceClicked">
                                            <Path Width="14" Height="14" Data="{StaticResource PlusIcon}" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Workspaces}"
                                              ItemTemplate="{StaticResource WorkspaceRowTemplate}"
                                              IsVisible="{Binding ShowProjectList}"
                                              Margin="0,6,0,0" />

                                <Grid Classes="session-row-container" Margin="0,18,0,0">
                                    <Button Classes="section-header"
                                            Click="OnToggleRecentClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="最近" FontSize="13" LineHeight="21"
                                                       Foreground="{StaticResource SidebarLabel}" VerticalAlignment="Center" />
                                            <Path Classes="section-chevron" Width="10" Height="10"
                                                  Data="{StaticResource ChevronDownIcon}" Stretch="Uniform"
                                                  Classes.collapsed="{Binding !IsRecentExpanded}"
                                                  VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,23,0">
                                        <Button Classes="row-action" Click="OnProjectSectionMoreClicked">
                                            <Path Width="14" Height="14" Data="{StaticResource MoreIcon}" Stretch="Uniform" />
                                        </Button>
                                        <Button Classes="row-action" Click="OnNewSessionClicked">
                                            <Path Width="14" Height="14" Data="{StaticResource EditIcon}" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding RecentSessions}"
                                              ItemTemplate="{StaticResource RecentSessionTemplate}"
                                              IsVisible="{Binding IsRecentExpanded}"
                                              Margin="0,6,0,0" />
                                <TextBlock Text="暂无会话" IsVisible="{Binding ShowNoRecentSessions}"
                                           FontSize="12" Foreground="{StaticResource SidebarLabel}"
                                           Margin="16,6,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- notifications pane (Codex bell) -->
                        <ScrollViewer Grid.Row="3" IsVisible="{Binding IsNotificationsVisible}"
                                      VerticalScrollBarVisibility="Visible"
                                      AllowAutoHide="False"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Height="28" Margin="16,16,12,0">
                                    <TextBlock Text="优先级" FontSize="13"
                                               Foreground="{StaticResource SidebarLabel}" VerticalAlignment="Center" />
                                    <Button Classes="row-action" Opacity="1" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="0,0,15,0"
                                            Click="OnNotificationMenuClicked">
                                        <Path Width="14" Height="14" Data="{StaticResource MoreIcon}"
                                              Stretch="Uniform" />
                                    </Button>
                                </Grid>
                                <TextBlock Text="部分未读聊天暂时不可用" FontSize="12"
                                           Foreground="{StaticResource SidebarLabel}" Margin="16,10,16,0"
                                           TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Notifications}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NotificationItemViewModel">
                                            <StackPanel>
                                                <TextBlock Text="{Binding GroupLabel}" IsVisible="{Binding ShowGroup}"
                                                           FontSize="12" Foreground="{StaticResource SidebarLabel}"
                                                           Margin="16,14,0,4" />
                                                <Button Classes="nav" Click="OnNotificationClicked" Tag="{Binding}">
                                                    <StackPanel Spacing="3">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource SidebarText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="NoWrap" MaxWidth="176" />
                                                            <TextBlock Text="{Binding WorkspaceName}" FontSize="11"
                                                                       Foreground="{StaticResource SidebarLabel}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Preview}" FontSize="11.5"
                                                                   Foreground="{StaticResource SidebarLabel}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" MaxLines="2"
                                                                   IsVisible="{Binding Preview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="暂无通知" IsVisible="{Binding ShowNoNotifications}" FontSize="12"
                                           Foreground="{StaticResource SidebarLabel}" Margin="16,10,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- plugins sidebar -->
                    <Grid IsVisible="{Binding IsPluginsPage}" RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" Height="44" ColumnDefinitions="*,Auto" Margin="16,0,10,0">
                            <TextBlock Text="自定义" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="icon" Click="OnToggleSearchClicked" ToolTip.Tip="搜索">
                                <Path Width="15" Height="15" Data="{StaticResource SearchIcon}" Stretch="Uniform" />
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="8,4,8,0">
                            <Button Classes="nav active" Click="OnNavPluginsClicked">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <Path Width="16" Height="16" Data="{StaticResource PluginIcon}" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Text="插件" FontSize="13" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Classes="nav" IsEnabled="False" ToolTip.Tip="即将支持">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <Path Width="16" Height="16" Data="{StaticResource SparkIcon}" Stretch="Uniform"
                                          Opacity="0.5" />
                                    <TextBlock Grid.Column="1" Text="技能" FontSize="13"
                                               Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="16,18,16,0" Spacing="6">
                            <TextBlock Classes="section-label" Text="已安装" />
                            <TextBlock Text="插件列表在右侧展示" FontSize="11.5"
                                       Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- notification pane menu (Codex-style 显示 menu) -->
                    <Popup x:Name="NotificationMenuPopup" Placement="BottomEdgeAlignedLeft" VerticalOffset="4"
                           IsLightDismissEnabled="True">
                        <Border Width="216" Background="#202022"
                                BorderBrush="#2E2E31" BorderThickness="1"
                                CornerRadius="12" Padding="6" x:CompileBindings="False"
                                BoxShadow="0 18 44 0 #99000000">
                            <StackPanel>
                                <TextBlock Text="显示" FontSize="11.5" Foreground="#7E7F82"
                                           Margin="10,6,0,4" />
                                <Button Classes="more-menu-item" Click="OnNotificationFilterClicked" Tag="priority">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="优先事项部分" FontSize="13"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Width="13" Height="13"
                                              Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                              Stroke="#E3E4E6" StrokeThickness="1.6"
                                              IsVisible="{Binding IsNotificationFilterPriority}"
                                              VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Classes="more-menu-item" Click="OnNotificationFilterClicked" Tag="pinned">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="已置顶" FontSize="13"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Width="13" Height="13"
                                              Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                              Stroke="#E3E4E6" StrokeThickness="1.6"
                                              IsVisible="{Binding IsNotificationFilterPinned}"
                                              VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Classes="more-menu-item" Click="OnNotificationFilterClicked" Tag="automations">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="定时任务" FontSize="13"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Width="13" Height="13"
                                              Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                              Stroke="#E3E4E6" StrokeThickness="1.6"
                                              IsVisible="{Binding IsNotificationFilterAutomations}"
                                              VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Border Height="1" Background="#2E2E31" Margin="10,6" />
                                <Button Classes="more-menu-item" Click="OnMarkAllNotificationsReadClicked">
                                    <TextBlock Text="全部标为已读" FontSize="13"
                                               Foreground="#C6C7C9" VerticalAlignment="Center" />
                                </Button>
                                <Button Classes="more-menu-item" Click="OnArchiveNotificationsClicked">
                                    <TextBlock Text="归档聊天" FontSize="13"
                                               Foreground="#C6C7C9" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- project row menu (Codex-style project details) -->
                    <Popup x:Name="WorkspaceMenuPopup" Placement="RightEdgeAlignedTop"
                           HorizontalOffset="6" VerticalOffset="-9"
                           IsLightDismissEnabled="True">
                        <Border Width="322" Background="#202022"
                                BorderBrush="#2E2E31" BorderThickness="1"
                                CornerRadius="12" Padding="6" x:CompileBindings="False"
                                BoxShadow="0 18 44 0 #99000000">
                            <StackPanel>
                                <Grid Height="32" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="4,0">
                                    <Path Width="14" Height="14" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                          Stroke="#C6C7C9" StrokeThickness="1.3" StrokeLineCap="Round"
                                          StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#E3E4E6" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <Button Grid.Column="2" Classes="row-action" Classes.pinned="{Binding IsPinned}"
                                            Click="OnToggleWorkspacePinnedClicked" ToolTip.Tip="置顶">
                                        <Path Width="13" Height="13" Data="{StaticResource PinIcon}" Stretch="Uniform"
                                              StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
                                              RenderTransform="rotate(45deg)" />
                                    </Button>
                                </Grid>
                                <Grid Height="26" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="10,0">
                                    <Path Width="13" Height="13" Data="{StaticResource ChatIcon}" Stretch="Uniform"
                                          Stroke="#7E7F82" StrokeThickness="1.25" StrokeLineCap="Round"
                                          StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ChatCountLabel}" FontSize="12.5"
                                               Foreground="#9EA0A3" VerticalAlignment="Center" />
                                </Grid>
                                <Border Height="1" Background="#2E2E31" Margin="10,6" />
                                <Grid Height="24" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="10,0">
                                    <Path Width="13" Height="13" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                          Stroke="#7E7F82" StrokeThickness="1.25" StrokeLineCap="Round"
                                          StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12"
                                               Foreground="#9EA0A3" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </Grid>
                                <Grid Height="24" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="10,0">
                                    <Path Width="13" Height="13" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                          Stroke="#7E7F82" StrokeThickness="1.25" StrokeLineCap="Round"
                                          StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ParentPath}" FontSize="12"
                                               Foreground="#9EA0A3" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </Grid>
                                <Border Height="1" Background="#2E2E31" Margin="10,6" />
                                <Button Classes="more-menu-item" Height="30" Click="OnWorkspaceEditClicked">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource SettingsIcon}" Stretch="Uniform"
                                              Stroke="#7E7F82" StrokeThickness="1.25" StrokeLineCap="Round"
                                              StrokeJoin="Round" Fill="Transparent" />
                                        <TextBlock Grid.Column="1" Text="编辑项目" FontSize="13"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Border Height="1" Background="#2E2E31" Margin="10,6" />
                                <Button Classes="more-menu-item" Height="30" Click="OnArchiveWorkspaceChatsClicked">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource ArchiveIcon}" Stretch="Uniform"
                                              Stroke="#7E7F82" StrokeThickness="1.25" StrokeLineCap="Round"
                                              StrokeJoin="Round" Fill="Transparent" />
                                        <TextBlock Grid.Column="1" Text="归档聊天" FontSize="13"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Classes="more-menu-item" Height="30" Click="OnRemoveWorkspaceClicked">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource TrashIcon}" Stretch="Uniform"
                                              Stroke="#E5837C" StrokeThickness="1.25" StrokeLineCap="Round"
                                              StrokeJoin="Round" Fill="Transparent" />
                                        <TextBlock Grid.Column="1" Text="移除项目" FontSize="13"
                                                   Foreground="#E5837C" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- project section menu (Codex-style) -->
                    <Popup x:Name="PinnedSectionMenuPopup" Placement="BottomEdgeAlignedRight"
                           VerticalOffset="4" IsLightDismissEnabled="True">
                        <Border x:Name="PinnedSectionMenuCard" Width="196"
                                Background="{StaticResource ProductMenuFill}"
                                BorderBrush="{StaticResource ProductMenuLine}" BorderThickness="1"
                                CornerRadius="12" Padding="6"
                                BoxShadow="0 14 34 0 #99000000">
                            <StackPanel Spacing="1">
                                <Button Classes="more-menu-item" Click="OnPinnedSortRecentClicked">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource ClockIcon}" Stretch="Uniform" />
                                        <TextBlock Grid.Column="1" Text="最近更新" VerticalAlignment="Center" />
                                        <Path Grid.Column="2" Width="14" Height="14"
                                              Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                              Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                              IsVisible="{Binding IsPinnedSortByRecent}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Classes="more-menu-item" Click="OnPinnedSortManualClicked">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource ToolIcon}" Stretch="Uniform" />
                                        <TextBlock Grid.Column="1" Text="手动排序" VerticalAlignment="Center" />
                                        <Path Grid.Column="2" Width="14" Height="14"
                                              Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                              Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                              IsVisible="{Binding IsPinnedSortByManual}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- automation sidebar -->
                    <Grid IsVisible="{Binding IsAutomationPage}" RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" Height="44" Margin="16,0,10,0">
                            <TextBlock Text="自动化" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="8,4,8,0">
                            <Button Classes="nav active" Click="OnNavAutomationClicked">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <Path Width="16" Height="16" Data="{StaticResource RailAutomationIcon}"
                                          Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Text="自动化任务" FontSize="13" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="16,18,16,0" Spacing="6">
                            <TextBlock Classes="section-label" Text="已启用" />
                            <TextBlock Text="任务详情在右侧展示" FontSize="11.5"
                                       Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- projects sidebar -->
                    <Grid IsVisible="{Binding IsProjectsPage}" RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" Height="44" Margin="16,0,10,0">
                            <TextBlock Text="项目" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="8,4,8,0">
                            <Button Classes="nav active" Click="OnMoreProjectClicked">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <Path Width="16" Height="16" Data="{StaticResource FolderIcon}" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Text="项目" FontSize="13" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="16,18,16,0" Spacing="6">
                            <TextBlock Classes="section-label" Text="本地项目" />
                            <TextBlock Text="选择项目进入对话" FontSize="11.5"
                                       Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- library sidebar (Codex parity placeholder) -->
                    <Grid IsVisible="{Binding IsLibraryPage}" RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Height="44" Margin="16,0,10,0">
                            <TextBlock Text="资料库" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="16,4,16,0" Spacing="8">
                            <TextBlock Text="kl 暂未接入资料库，先保留 Codex 入口。"
                                       FontSize="11.5" Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- drag handle: resize the sidebar from its right edge -->
                    <Border Width="2" HorizontalAlignment="Right" Background="Transparent"
                            Cursor="SizeWestEast" ZIndex="80"
                            PointerPressed="OnSidebarResizePressed"
                            PointerMoved="OnSidebarResizeMoved"
                            PointerReleased="OnSidebarResizeReleased" />
                </Grid>
            </Border>

            <!-- drag handle: pull the collapsed sidebar back out past 3/4 of its minimum width -->
            <Border Grid.Column="2" HorizontalAlignment="Left" Width="2" Background="Transparent"
                    Cursor="SizeWestEast" ZIndex="80"
                    IsVisible="{Binding !IsSidebarVisible}"
                    PointerPressed="OnSidebarResizePressed"
                    PointerMoved="OnSidebarResizeMoved"
                    PointerReleased="OnSidebarResizeReleased" />

            <!-- main content -->
            <Grid Grid.Column="2" Background="{StaticResource ContentFill}" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Height="48" ColumnDefinitions="*,Auto" Margin="0,0,12,0"
                      IsVisible="{Binding !IsChatPage}">
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Button Classes="chip" Height="28" Padding="6,2" Click="OnOpenModelSettingsClicked"
                                ToolTip.Tip="{Binding CoreConnectionLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Width="13" Height="13" Data="{StaticResource SparkIcon}" Stretch="Uniform"
                                      Fill="{StaticResource AccentBlue}" Stroke="{StaticResource AccentBlue}"
                                      StrokeThickness="0.6" />
                                <TextBlock Text="{Binding CoreConnectionLabel}" FontSize="12.5"
                                           Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="icon" Click="OnToggleSidebarClicked" ToolTip.Tip="切换侧边栏">
                            <Path Width="15" Height="15" Data="{StaticResource PanelIcon}" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <!-- ===================== Library page (Codex parity placeholder) ===================== -->
                    <Grid IsVisible="{Binding IsLibraryPage}" RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Height="50" BorderBrush="{StaticResource Line}"
                                BorderThickness="0,0,0,1" Padding="16,0">
                            <TextBlock Text="资料库" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="10">
                            <Path Width="30" Height="30" Data="{StaticResource RailLibraryIcon}" Stretch="Uniform"
                                  Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="资料库" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                            <TextBlock Text="kl 暂未接入资料库，此入口先按 Codex 布局保留。"
                                       FontSize="12.5" Foreground="{StaticResource TextTertiary}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- ===================== Chat page ===================== -->
                    <Grid IsVisible="{Binding IsChatPage}" RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" IsVisible="{Binding ShowConversationHeader}" Height="62"
                                BorderBrush="Transparent" BorderThickness="0" Padding="20,0,9,4">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <Path Width="14" Height="14" Data="{StaticResource ConversationIcon}" Stretch="Uniform"
                                          Stroke="{StaticResource TextTertiary}" StrokeThickness="1.25"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" />
                                    <TextBlock Text="{Binding HeaderTitle}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                                            VerticalAlignment="Center">
                                    <Button Classes="icon" IsVisible="{Binding HasConversation}" ToolTip.Tip="会话操作">
                                        <Path Width="13" Height="12" Data="{StaticResource MoreIcon}" Stretch="Uniform" Fill="#737375" Stroke="Transparent" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuItem Header="重命名当前会话" Click="OnRenameActiveSessionClicked" />
                                                <MenuItem Header="删除当前会话" Click="OnDeleteActiveSessionClicked" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Classes="icon" Click="OnToggleSidebarClicked" ToolTip.Tip="切换侧边栏">
                                        <Path Width="14" Height="12" Data="{StaticResource QueueIcon}" Stretch="Uniform" />
                                    </Button>
                                    <Border Width="1" Height="16" Background="#3A3A3C" Margin="1,0,1,0"
                                            VerticalAlignment="Center" />
                                    <Button Classes="icon" Click="OnNewSessionClicked" ToolTip.Tip="新会话">
                                        <Path Width="12" Height="12" Data="{StaticResource PlusIcon}" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Spacing="0">
                                <Border Width="64" Height="64" CornerRadius="16" ClipToBounds="True"
                                        HorizontalAlignment="Center" Background="#1A1A1C">
                                    <Image Source="/Assets/kl.png" Width="64" Height="64" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{Binding EmptyStateTitle}" FontSize="28" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Center" Margin="0,18,0,0" />
                            </StackPanel>

                            <ScrollViewer x:Name="TranscriptScroller" IsVisible="{Binding HasConversation}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,12,0,16">
                                <ItemsControl x:Name="TranscriptItems" ItemsSource="{Binding Messages}"
                                              ItemTemplate="{StaticResource ChatItemTemplate}"
                                              MaxWidth="736" HorizontalAlignment="Stretch" />
                            </ScrollViewer>

                            <Button x:Name="JumpToBottomButton" Classes="jump-bottom" IsVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Margin="0,0,0,14" Click="OnJumpToBottomClicked" ToolTip.Tip="跳到底部">
                                <Path Width="14" Height="14" Data="{StaticResource ChevronDownIcon}" Stretch="Uniform" />
                            </Button>

                            <Border x:Name="RulerStrip" IsVisible="{Binding HasConversation}"
                                   Width="28" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                   Margin="6,0,0,0" Background="Transparent"
                                   PointerMoved="OnRulerPointerMoved"
                                   PointerExited="OnRulerPointerExited"
                                   PointerPressed="OnRulerPointerPressed">
                                <Canvas x:Name="RulerTicksPanel" Width="6"
                                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                        Margin="10,0,0,0" IsHitTestVisible="False" />
                            </Border>

                            <Border x:Name="RulerPreviewCard" IsVisible="False" Width="322"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="45,0,0,0" Background="#202022" CornerRadius="10"
                                    Padding="12,10" BoxShadow="0 12 32 0 #66000000"
                                    IsHitTestVisible="False" ZIndex="30" Opacity="0">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                    </Transitions>
                                </Border.Transitions>
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="RulerPreviewTitle" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#E3E4E6" TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                        <Path Grid.Column="1" Width="14" Height="14" Data="{StaticResource ChatIcon}"
                                              Stretch="Uniform" Stroke="#7E7F82" StrokeThickness="1.3"
                                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                              VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock x:Name="RulerPreviewBody" Grid.Row="1" FontSize="12" LineHeight="21"
                                               Foreground="#A0A1A3" TextWrapping="Wrap" />
                                    <StackPanel x:Name="RulerPreviewBulletRow" Grid.Row="2" Orientation="Horizontal"
                                                Spacing="8" Margin="2,0,0,0">
                                        <TextBlock Text="•" FontSize="12" Foreground="#A0A1A3"
                                                   VerticalAlignment="Top" />
                                        <TextBlock x:Name="RulerPreviewBullet" FontSize="12" LineHeight="21"
                                                   Foreground="#A0A1A3" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" MaxWidth="736" HorizontalAlignment="Stretch"
                              Margin="0,0,0,12" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <Button Grid.Row="0" Classes="chip" IsVisible="{Binding IsEmpty}" Click="OnWorkspacePickerClicked"
                                    HorizontalAlignment="Left" ToolTip.Tip="{Binding WorkspacePath}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Path Width="14" Height="14" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                          Stroke="{StaticResource TextTertiary}" StrokeThickness="1.35"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding WorkspaceName}" FontSize="12.5"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                    <Path Width="9" Height="9" Data="{StaticResource ChevronDownIcon}" Stretch="Uniform"
                                          Stroke="{StaticResource TextTertiary}" StrokeThickness="1.4"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                          VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Border Grid.Row="1" IsVisible="{Binding ShowCoreBanner}"
                                    Background="#2A20221F" BorderBrush="#553B3B2B" BorderThickness="0.5"
                                    CornerRadius="10" Padding="12,9">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Path Width="14" Height="14" Data="{StaticResource WarningIcon}" Stretch="Uniform"
                                          Stroke="#E6C79A" StrokeThickness="1.4"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                          VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding CoreBannerText}" FontSize="12"
                                               Foreground="#E6D2B4" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="secondary" Height="26" Padding="8,3"
                                            Click="OnRetryCoreClicked" Content="重试"
                                            IsEnabled="{Binding CanRetryCore}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Background="{StaticResource ComposerFill}" CornerRadius="18"
                                    Padding="14,10,14,8" BoxShadow="0 10 34 0 #55000000">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <ItemsControl Grid.Row="0" ItemsSource="{Binding PendingAttachments}"
                                                  ItemTemplate="{StaticResource AttachmentChipTemplate}"
                                                  IsVisible="{Binding HasPendingAttachments}" Margin="2,2,2,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <Grid Grid.Row="1">
                                        <TextBox x:Name="HeroComposerBox" Classes="composer"
                                                 IsVisible="{Binding IsEmpty}"
                                                 Text="{Binding Composer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{Binding ComposerPlaceholder}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="42" MaxHeight="180"
                                                 KeyDown="OnComposerKeyDown" />
                                        <TextBox x:Name="ChatComposerBox" Classes="composer"
                                                 IsVisible="{Binding HasConversation}"
                                                 Text="{Binding Composer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{Binding ComposerPlaceholder}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="42" MaxHeight="180"
                                                 KeyDown="OnComposerKeyDown" />
                                    </Grid>

                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                          ColumnSpacing="4" Margin="0,6,0,0">
                                        <Button Classes="attach" Click="OnAttachFilesClicked"
                                                ToolTip.Tip="添加文本或代码附件">
                                            <Path Width="14" Height="14" Data="{StaticResource PlusIcon}"
                                                  Stretch="Uniform" />
                                        </Button>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Margin="4,0,0,0">
                                            <Button Classes="chip" Click="OnNavSettingsClicked" ToolTip.Tip="权限模式">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Path Width="13" Height="13" Data="{StaticResource AlertIcon}"
                                                          Stretch="Uniform" Stroke="#F0814B"
                                                          StrokeThickness="1.5" StrokeLineCap="Round"
                                                          StrokeJoin="Round" Fill="Transparent"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding PermissionMode}" FontSize="12.5"
                                                               Foreground="#F0814B"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="chip" Click="OnNavPluginsClicked" ToolTip.Tip="插件">
                                                <Grid Width="16" Height="16">
                                                    <Path Width="14" Height="14" Data="{StaticResource PluginIcon}"
                                                          Stretch="Uniform" Stroke="#8A8B8D"
                                                          StrokeThickness="1.2" StrokeLineCap="Round"
                                                          StrokeJoin="Round" Fill="Transparent" />
                                                    <Border Width="4" Height="4" CornerRadius="2"
                                                            Background="#E6C15A"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="chip" Click="OnOpenModelSettingsClicked"
                                                ToolTip.Tip="模型与连接">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Path Width="13" Height="13" Data="{StaticResource RingIcon}" Stretch="Uniform"
                                                      Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3"
                                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                      VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ProviderModelLabel}" FontSize="12.5"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           VerticalAlignment="Center" />
                                                <Path Width="9" Height="9" Data="{StaticResource ChevronDownIcon}"
                                                      Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                                      StrokeThickness="1.4" StrokeLineCap="Round"
                                                      StrokeJoin="Round" Fill="Transparent"
                                                      VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Classes="icon" Width="28" Height="28"
                                                ToolTip.Tip="语音输入（即将支持）">
                                            <Path Width="14" Height="14" Data="{StaticResource MicIcon}"
                                                  Stretch="Uniform" />
                                        </Button>
                                        <Button Grid.Column="4" Classes="stop" IsVisible="{Binding IsBusy}"
                                                Click="OnCancelClicked" ToolTip.Tip="停止生成">
                                            <Path Width="12" Height="12" Data="{StaticResource StopIcon}"
                                                  Stretch="Uniform" />
                                        </Button>
                                        <Button Grid.Column="4" Classes="send" IsVisible="{Binding !IsBusy}"
                                                Click="OnSendClicked" IsEnabled="{Binding CanSend}"
                                                ToolTip.Tip="发送 Ctrl+Enter">
                                            <Path Width="13" Height="13" Data="{StaticResource SendIcon}"
                                                  Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ===================== Plugins page ===================== -->
                    <ScrollViewer IsVisible="{Binding IsPluginsPage}" VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="960" HorizontalAlignment="Stretch" Margin="40,28,40,40"
                              RowDefinitions="Auto,Auto,Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="page-title" Text="插件" />
                                    <TextBlock Classes="page-subtitle"
                                               Text="连接本地插件，让 kl 在你的工具中协同工作" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Border Width="260" Height="34" Background="{StaticResource ElevatedHover}"
                                            CornerRadius="8" Padding="9,0">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                            <Path Width="13" Height="13" Data="{StaticResource SearchIcon}"
                                                  Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                                  StrokeThickness="1.35" StrokeLineCap="Round"
                                                  StrokeJoin="Round" Fill="Transparent"
                                                  VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Classes="search" IsEnabled="False"
                                                     PlaceholderText="搜索插件" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Button Classes="icon" Width="32" Height="32"
                                            Click="OnRefreshPluginsClicked" ToolTip.Tip="刷新插件">
                                        <Path Width="15" Height="15" Data="{StaticResource RefreshIcon}"
                                              Stretch="Uniform" />
                                    </Button>
                                    <Button Classes="primary" Click="OnImportPluginClicked" Content="导入" />
                                    <Button Classes="subtle" Click="OnOpenPluginDirectoryClicked" Content="打开目录" />
                                </StackPanel>
                            </Grid>

                            <SelectableTextBlock Grid.Row="1" Text="{Binding PluginDirectoryPath}" FontSize="11"
                                                 Foreground="{StaticResource TextCaption}"
                                                 TextTrimming="CharacterEllipsis" Margin="0,14,0,18" />

                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Text="本地插件" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Grid.Column="1" Text="{Binding PluginStatus}" FontSize="11"
                                           Foreground="{StaticResource TextCaption}" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="3" Spacing="0">
                                <Border IsVisible="{Binding ShowNoPlugins}" Padding="0,60,0,0">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                                        <Path Width="30" Height="30" Data="{StaticResource PluginIcon}"
                                              Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                              StrokeThickness="1.1" StrokeLineCap="Round" StrokeJoin="Round"
                                              Fill="Transparent" HorizontalAlignment="Center" />
                                        <TextBlock Text="暂无本地插件" FontSize="14"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="在插件目录下创建子目录并放入 plugin.json" FontSize="12"
                                                   Foreground="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Center" />
                                        <Button Classes="secondary" Click="OnOpenPluginDirectoryClicked"
                                                Content="打开插件目录" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Plugins}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PluginItemViewModel">
                                            <Border Background="{StaticResource CardFill}" CornerRadius="16"
                                                    Padding="16,14" Margin="0,0,0,10">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Border Width="32" Height="32" CornerRadius="8"
                                                            Background="#1E1E22" VerticalAlignment="Center">
                                                        <Path Width="16" Height="16" Data="{StaticResource PluginIcon}"
                                                              Stretch="Uniform" Stroke="{StaticResource TextSecondary}"
                                                              StrokeThickness="1.3" StrokeLineCap="Round"
                                                              StrokeJoin="Round" Fill="Transparent"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}" />
                                                            <TextBlock Text="{Binding Version}" FontSize="11"
                                                                       Foreground="{StaticResource TextCaption}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="12.5"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{StaticResource ActiveFill}"
                                                            CornerRadius="999" Padding="10,3"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="已安装" FontSize="12"
                                                                   Foreground="{StaticResource TextSecondary}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- ===================== Projects page ===================== -->
                    <ScrollViewer IsVisible="{Binding IsProjectsPage}" VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="960" HorizontalAlignment="Stretch" Margin="40,28,40,40"
                              RowDefinitions="Auto,Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="page-title" Text="项目" />
                                    <TextBlock Classes="page-subtitle" Text="选择项目进入对话，或添加新的本地项目" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primary" Click="OnAddWorkspaceClicked"
                                        Content="添加项目" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Grid.Row="1" Classes="section-label" Text="本地项目"
                                       Margin="0,18,0,8" />

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Workspaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkspaceItemViewModel">
                                        <Button Classes="row" Height="56" Padding="12,8" Margin="0,0,0,8"
                                                Click="OnWorkspaceClicked">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Width="32" Height="32" Background="#1E1E22"
                                                        CornerRadius="8" VerticalAlignment="Center">
                                                    <Path Width="16" Height="16"
                                                          Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                                          Stroke="{StaticResource TextSecondary}"
                                                          StrokeThickness="1.35" StrokeLineCap="Round"
                                                          StrokeJoin="Round" Fill="Transparent"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                               Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Text="{Binding Path}" FontSize="11"
                                                               Foreground="{StaticResource TextTertiary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="打开" FontSize="12"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- ===================== Automation page ===================== -->
                    <ScrollViewer IsVisible="{Binding IsAutomationPage}" VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="960" HorizontalAlignment="Stretch" Margin="40,28,40,40"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="page-title" Text="自动化任务" />
                                    <TextBlock Classes="page-subtitle"
                                               Text="按间隔让 KL Core 自动执行任务并保存结果" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primary" Click="OnNewAutomationClicked"
                                        Content="新建" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,18,0,12">
                                <Button Classes="filter" Classes.active="{Binding IsAutomationFilterAll}"
                                        Click="OnAutomationFilterAllClicked" Content="全部" />
                                <Button Classes="filter" Classes.active="{Binding IsAutomationFilterActive}"
                                        Click="OnAutomationFilterActiveClicked" Content="已开启" />
                                <Button Classes="filter" Classes.active="{Binding IsAutomationFilterEnded}"
                                        Click="OnAutomationFilterEndedClicked" Content="已结束" />
                            </StackPanel>

                            <Border Grid.Row="2" Height="34" Background="{StaticResource ElevatedHover}"
                                    CornerRadius="8" Padding="9,0" Margin="0,0,0,16">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                    <Path Width="13" Height="13" Data="{StaticResource SearchIcon}"
                                          Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                          StrokeThickness="1.35" StrokeLineCap="Round" StrokeJoin="Round"
                                          Fill="Transparent" VerticalAlignment="Center" />
                                    <TextBox x:Name="AutomationSearchBox" Grid.Column="1" Classes="search"
                                             Text="{Binding AutomationSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="搜索自动化任务" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" IsVisible="{Binding ShowNoAutomations}" Padding="0,50,0,0">
                                <StackPanel Spacing="12" HorizontalAlignment="Center">
                                    <Path Width="28" Height="28" Data="{StaticResource ClockIcon}"
                                          Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                          StrokeThickness="1.1" StrokeLineCap="Round" StrokeJoin="Round"
                                          Fill="Transparent" HorizontalAlignment="Center" />
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding AutomationEmptyTitle}" FontSize="14"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding AutomationEmptyDescription}" FontSize="12"
                                                   Foreground="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <Button Classes="secondary" Click="OnNewAutomationClicked"
                                            Content="新建自动化任务" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <ItemsControl Grid.Row="4" ItemsSource="{Binding Automations}"
                                          IsVisible="{Binding HasAutomations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AutomationItemViewModel">
                                        <Border IsVisible="{Binding IsVisible}"
                                                Background="{StaticResource CardFill}" CornerRadius="12"
                                                Padding="16,12" Margin="0,0,0,10">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                    <Path Width="18" Height="18" Data="{StaticResource ClockIcon}"
                                                          Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                                          StrokeThickness="1.15" StrokeLineCap="Round"
                                                          StrokeJoin="Round" Fill="Transparent"
                                                          VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="{Binding Name}" FontSize="14"
                                                                   FontWeight="Medium"
                                                                   Foreground="{StaticResource TextPrimary}" />
                                                        <TextBlock Text="{Binding Prompt}" FontSize="12"
                                                                   Foreground="{StaticResource TextTertiary}"
                                                                   TextWrapping="Wrap" MaxHeight="40" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{StaticResource ActiveFill}"
                                                            CornerRadius="999" Padding="9,3"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding StateLabel}" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondary}" />
                                                    </Border>
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="16"
                                                      Margin="30,0,0,0">
                                                    <TextBlock Text="{Binding IntervalLabel}" FontSize="10"
                                                               Foreground="{StaticResource TextCaption}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding NextRunLabel}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextCaption}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding LastRunLabel}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextCaption}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding StatusLabel}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextCaption}" />
                                                </Grid>

                                                <Border IsVisible="{Binding HasLastResult}"
                                                        Background="{StaticResource ToolCardFill}"
                                                        CornerRadius="8" Padding="12,9" Margin="30,0,0,0">
                                                    <ScrollViewer MaxHeight="96"
                                                                  VerticalScrollBarVisibility="Auto">
                                                        <SelectableTextBlock Text="{Binding LastResult}"
                                                                             FontSize="11" LineHeight="18"
                                                                             Foreground="{StaticResource TextTertiary}"
                                                                             TextWrapping="Wrap" />
                                                    </ScrollViewer>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                            Spacing="8">
                                                    <Button Classes="secondary" Click="OnRunAutomationClicked"
                                                            IsEnabled="{Binding CanRun}"
                                                            Content="{Binding RunButtonLabel}" />
                                                    <Button Classes="secondary" Click="OnToggleAutomationClicked"
                                                            IsEnabled="{Binding CanEdit}"
                                                            Content="{Binding ToggleLabel}" />
                                                    <Button Classes="secondary" Click="OnEditAutomationClicked"
                                                            IsEnabled="{Binding CanEdit}" Content="编辑" />
                                                    <Button Classes="secondary" Click="OnDeleteAutomationClicked"
                                                            IsEnabled="{Binding CanEdit}" Content="删除" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- error banner -->
                    <Border IsVisible="{Binding HasError}" VerticalAlignment="Top"
                            HorizontalAlignment="Center" MaxWidth="720" Margin="20,12,20,0"
                            Background="#2A20221F" BorderBrush="#553B3B2B" BorderThickness="0.5"
                            CornerRadius="10" Padding="12,9" ZIndex="20">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Path Width="14" Height="14" Data="{StaticResource WarningIcon}" Stretch="Uniform"
                                  Stroke="#E6A0A0" StrokeThickness="1.3"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="12"
                                       Foreground="#E6B4B4" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="icon" Width="24" Height="24"
                                    Click="OnDismissErrorClicked" ToolTip.Tip="关闭">
                                <TextBlock Text="×" FontSize="16" Foreground="{StaticResource TextTertiary}" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== Settings overlay ===================== -->
        <Grid Grid.Row="1" IsVisible="{Binding IsSettingsOpen}" Margin="52,0,0,0"
              Background="{StaticResource BgBase}" ZIndex="40">
            <Grid ColumnDefinitions="280,*">
                <Border Background="{StaticResource SidebarFill}"
                        BorderBrush="{StaticResource SidebarDivider}" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,20,16,16">
                        <TextBlock Text="设置" FontSize="20" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimary}" Margin="2,0" />
                        <Border Grid.Row="1" Height="34" Background="{StaticResource ElevatedHover}"
                                CornerRadius="8" Margin="0,14,0,16" Padding="9,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                <Path Width="13" Height="13" Data="{StaticResource SearchIcon}"
                                      Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                      StrokeThickness="1.35" StrokeLineCap="Round" StrokeJoin="Round"
                                      Fill="Transparent" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Classes="search" IsEnabled="False"
                                         PlaceholderText="搜索" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="2" Spacing="2">
                            <TextBlock Classes="section-label" Text="个人" Margin="2,0,0,6" />
                            <Button Classes="nav" Classes.active="{Binding IsSettingsGeneral}"
                                    Click="OnSettingsGeneralClicked">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <Path Width="15" Height="15" Data="{StaticResource SettingsIcon}"
                                          Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Text="通用设置" FontSize="13"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Classes="nav" Classes.active="{Binding IsSettingsModels}"
                                    Click="OnSettingsModelsClicked">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <Path Width="15" Height="15" Data="{StaticResource SparkIcon}"
                                          Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Text="模型与连接" FontSize="13"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Classes="nav" Classes.active="{Binding IsSettingsData}"
                                    Click="OnSettingsDataClicked">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <Path Width="15" Height="15" Data="{StaticResource FolderIcon}"
                                          Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Text="本地数据" FontSize="13"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Classes="nav" Classes.active="{Binding IsSettingsAbout}"
                                    Click="OnSettingsAboutClicked">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <Path Width="15" Height="15" Data="{StaticResource HelpIcon}"
                                          Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Text="关于与快捷键" FontSize="13"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="{Binding VersionLabel, StringFormat='版本 {0}'}"
                                   FontSize="11" Foreground="{StaticResource TextCaption}" Margin="2,0" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1" RowDefinitions="Auto,*">
                    <Grid RowDefinitions="Auto" ColumnDefinitions="*,Auto" Margin="40,24,40,8">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SettingsPaneTitle}" Classes="page-title" />
                            <TextBlock Text="{Binding SettingsPaneSubtitle}" Classes="page-subtitle" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="subtle" Click="OnOpenStateDirectoryClicked"
                                Content="打开 GUI 目录" VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="40,8,40,40">
                        <Grid MaxWidth="880" HorizontalAlignment="Stretch">
                            <!-- General -->
                            <StackPanel IsVisible="{Binding IsSettingsGeneral}" Spacing="14">
                                <Border Classes="card">
                                    <Grid ColumnDefinitions="*,240">
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="权限" FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="选择新会话默认的工具与文件访问方式" FontSize="11.5"
                                                       Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Classes="field"
                                                  ItemsSource="{Binding PermissionModes}"
                                                  SelectedItem="{Binding SettingsPermissionMode, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Classes="card">
                                    <Grid ColumnDefinitions="*,120">
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="内容字号" FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="仅影响对话正文与用户消息" FontSize="11.5"
                                                       Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Classes="field"
                                                  ItemsSource="{Binding ContentFontSizes}"
                                                  SelectedItem="{Binding SettingsContentFontSize, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Classes="card">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="工作模式" FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="Chat 更轻量，Work 面向任务" FontSize="11.5"
                                                       Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                    VerticalAlignment="Center">
                                            <Button Classes="filter" Classes.active="{Binding IsChatMode}"
                                                    Click="OnChatModeClicked" Content="Chat" />
                                            <Button Classes="filter" Classes.active="{Binding IsWorkMode}"
                                                    Click="OnWorkModeClicked" Content="Work" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="card">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="快捷键" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <Grid ColumnDefinitions="*,Auto"
                                              RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                            <TextBlock Text="新建会话" FontSize="12"
                                                       Foreground="{StaticResource TextTertiary}" />
                                            <TextBlock Grid.Column="1" Text="Ctrl+N" FontSize="11"
                                                       Foreground="{StaticResource TextCaption}" />
                                            <TextBlock Grid.Row="1" Text="发送消息" FontSize="12"
                                                       Foreground="{StaticResource TextTertiary}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl+Enter"
                                                       FontSize="11" Foreground="{StaticResource TextCaption}" />
                                            <TextBlock Grid.Row="2" Text="搜索会话" FontSize="12"
                                                       Foreground="{StaticResource TextTertiary}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Ctrl+F"
                                                       FontSize="11" Foreground="{StaticResource TextCaption}" />
                                            <TextBlock Grid.Row="3" Text="打开设置" FontSize="12"
                                                       Foreground="{StaticResource TextTertiary}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Ctrl+,"
                                                       FontSize="11" Foreground="{StaticResource TextCaption}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Button Classes="primary" Click="OnSaveSettingsClicked"
                                        Content="保存通用设置" HorizontalAlignment="Left" />
                            </StackPanel>

                            <!-- Models / Core runtime -->
                            <StackPanel IsVisible="{Binding IsSettingsModels}" Spacing="14">
                                <Border Classes="card">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="KL Core 运行时" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="GUI 只作为协议客户端：会话、工具、审批与沙箱都由 KL Core 执行。模型、Provider 与 API Key 由 Core 配置管理，这里只显示状态。"
                                                   FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                                   TextWrapping="Wrap" LineHeight="18" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="card">
                                    <Grid ColumnDefinitions="140,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                                        <TextBlock Text="连接状态" FontSize="12"
                                                   Foreground="{StaticResource TextTertiary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CoreStatusText}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="1" Text="版本" FontSize="12"
                                                   Foreground="{StaticResource TextTertiary}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CoreVersionText}"
                                                   FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Grid.Row="2" Text="Provider / 模型" FontSize="12"
                                                   Foreground="{StaticResource TextTertiary}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CoreProviderText}"
                                                   FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="3" Text="Provider 凭据" FontSize="12"
                                                   Foreground="{StaticResource TextTertiary}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CoreKeyStatusText}"
                                                   FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="4" Text="Core 路径" FontSize="12"
                                                   Foreground="{StaticResource TextTertiary}" />
                                        <SelectableTextBlock Grid.Row="4" Grid.Column="1"
                                                             Text="{Binding CorePathText}" FontSize="11"
                                                             Foreground="{StaticResource TextCaption}"
                                                             TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="5" Text="KL Home" FontSize="12"
                                                   Foreground="{StaticResource TextTertiary}" />
                                        <SelectableTextBlock Grid.Row="5" Grid.Column="1"
                                                             Text="{Binding CoreHomeText}" FontSize="11"
                                                             Foreground="{StaticResource TextCaption}"
                                                             TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="secondary" Click="OnTestConnectionClicked"
                                            IsEnabled="{Binding CanTestConnection}"
                                            Content="{Binding TestConnectionButtonText}" />
                                    <Button Classes="secondary" Click="OnResetSettingsClicked"
                                            Content="恢复默认值" />
                                    <Button Classes="secondary" Click="OnOpenStateDirectoryClicked"
                                            Content="打开 GUI 目录" />
                                </StackPanel>
                                <TextBlock Text="{Binding SettingsStatus}" FontSize="11"
                                           Foreground="{StaticResource SuccessGreen}" TextWrapping="Wrap"
                                           IsVisible="{Binding IsSettingsStatusSuccess}" />
                                <TextBlock Text="{Binding SettingsStatus}" FontSize="11"
                                           Foreground="#E6A0A0" TextWrapping="Wrap"
                                           IsVisible="{Binding IsSettingsStatusError}" />
                            </StackPanel>

                            <!-- Local data -->
                            <StackPanel IsVisible="{Binding IsSettingsData}" Spacing="14">
                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="GUI 状态文件" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <SelectableTextBlock Text="{Binding StateFilePath}" FontSize="11"
                                                             Foreground="{StaticResource TextCaption}"
                                                             TextWrapping="Wrap" />
                                        <TextBlock Text="会话与消息真值由 KL Core 保存于 ~/.kl/sessions（默认 KL Home 为 ~/.kl，可用 KL_HOME 覆盖）；这里的 ~/.kl/gui 状态文件只保存 GUI 本地状态：工作区、界面偏好与自动化配置。"
                                                   FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                                   TextWrapping="Wrap" LineHeight="18" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Classes="secondary" Click="OnCopyStatePathClicked"
                                                    Content="复制路径" />
                                            <Button Classes="secondary" Click="OnOpenStateDirectoryClicked"
                                                    Content="打开 GUI 目录" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Classes="card">
                                    <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="18">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="工作区" FontSize="11"
                                                       Foreground="{StaticResource TextCaption}" />
                                            <TextBlock Text="{Binding WorkspaceCount}" FontSize="20"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimary}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="已保存会话" FontSize="11"
                                                       Foreground="{StaticResource TextCaption}" />
                                            <TextBlock Text="{Binding SavedSessionCount}" FontSize="20"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimary}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock Text="自动化" FontSize="11"
                                                       Foreground="{StaticResource TextCaption}" />
                                            <TextBlock Text="{Binding AutomationCount}" FontSize="20"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimary}" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Classes="secondary"
                                                Click="OnAddWorkspaceClicked" Content="添加工作区"
                                                VerticalAlignment="Bottom" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- About -->
                            <StackPanel IsVisible="{Binding IsSettingsAbout}" Spacing="14">
                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Width="32" Height="32" CornerRadius="8" ClipToBounds="True"
                                                    Background="#1A1A1C">
                                                <Image Source="/Assets/kl.png" Width="32" Height="32"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="kl" FontSize="16" FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="{Binding VersionLabel, StringFormat='版本 {0}'}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextCaption}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="KL 桌面客户端：通过 Kl.Client 以 JSON-RPC 连接本地 KL Core 进程；会话、工具调用、审批与沙箱都由 Core 执行，GUI 只负责交互与展示。"
                                                   FontSize="12" Foreground="{StaticResource TextTertiary}"
                                                   TextWrapping="Wrap" LineHeight="20" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="card">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="隐私与安全" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="API Key 与 Provider 凭据由 KL Core 配置管理，GUI 不读取也不保存凭据文件。会话真值保存在 KL Core 的 ~/.kl/sessions；GUI 本地状态位于 ~/.kl/gui，插件目录为 ~/.kl/plugins。"
                                                   FontSize="12" Foreground="{StaticResource TextTertiary}"
                                                   TextWrapping="Wrap" LineHeight="20" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== Rail hover hint ===================== -->
        <Canvas x:Name="RailHintLayer" Grid.RowSpan="2" IsHitTestVisible="False">
            <Border x:Name="RailHintCard" IsVisible="False" Opacity="0"
                    Background="{DynamicResource MenuFill}" BorderThickness="1"
                    BorderBrush="{DynamicResource LineStrong}"
                    CornerRadius="8" Padding="9,5"
                    BoxShadow="0 6 20 0 #66000000">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
                    </Transitions>
                </Border.Transitions>
                <TextBlock x:Name="RailHintText" FontSize="12"
                           Foreground="{StaticResource TextPrimary}" />
            </Border>
        </Canvas>

        <!-- ===================== More menu popup ===================== -->
        <primitives:Popup x:Name="MorePopup" Placement="RightEdgeAlignedTop" HorizontalOffset="4"
                          IsLightDismissEnabled="False" ShouldUseOverlayLayer="True"
                          Opened="OnMorePopupOpened" Closed="OnMorePopupClosed">
            <Border x:Name="MoreMenuCard" MinWidth="210"
                    Background="{DynamicResource MoreMenuFill}"
                    BorderThickness="0" CornerRadius="10" Padding="4" Opacity="0"
                    PointerEntered="OnMoreMenuPointerEntered"
                    PointerExited="OnMoreMenuPointerExited">
                <Border.RenderTransform>
                    <TranslateTransform X="-3">
                        <TranslateTransform.Transitions>
                            <Transitions>
                                <DoubleTransition Property="X" Duration="0:0:0.10" />
                            </Transitions>
                        </TranslateTransform.Transitions>
                    </TranslateTransform>
                </Border.RenderTransform>
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="1">
                    <Button Classes="more-menu-item" Click="OnMoreProjectClicked">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Path Width="16" Height="16" Data="{StaticResource FolderIcon}" Stretch="Uniform" />
                            <TextBlock Grid.Column="1" Text="项目" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="more-menu-pin" Classes.pinned="{Binding IsAddProjectPinned}"
                                    Click="OnToggleAddProjectPinnedClicked">
                                <Path x:Name="PinProjectGlyph" Width="12" Height="12"
                                      Data="{StaticResource PinIcon}" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Button>
                    <Button Classes="more-menu-item" Click="OnMoreCodeReviewClicked">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Path Width="16" Height="16" Data="{StaticResource CodeReviewIcon}"
                                  Stretch="Uniform" />
                            <TextBlock Grid.Column="1" Text="代码审查" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="more-menu-pin" Classes.pinned="{Binding IsCodeReviewPinned}"
                                    Click="OnToggleCodeReviewPinnedClicked">
                                <Path x:Name="PinReviewGlyph" Width="12" Height="12"
                                      Data="{StaticResource PinIcon}" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </primitives:Popup>

        <!-- section menu overlay: drawn inside the main window, no extra popup windows -->
        <Grid x:Name="SectionMenuOverlay" Grid.RowSpan="2" ZIndex="44" IsVisible="False">
            <Border Background="Transparent" PointerPressed="OnSectionMenuDismissPressed" />
            <Canvas x:Name="SectionMenuCanvas">
                <StackPanel x:Name="SectionMenuStack" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top"
                                    Canvas.Left="0" Canvas.Top="0">
                        <Border x:Name="ProjectSectionMenuCard" Width="216"
                                VerticalAlignment="Top"
                                Background="#202022"
                                BorderBrush="#2E2E31" BorderThickness="1"
                                CornerRadius="12" Padding="6"
                                BoxShadow="0 18 44 0 #99000000"
                                PointerMoved="OnProjectSectionMenuPointerMoved"
                                PointerExited="OnProjectSectionMenuCardPointerExited">
                            <StackPanel Spacing="1">
                                <Button Classes="more-menu-item" Click="OnOrganizeSidebarRowClicked"
                                        PointerEntered="OnOrganizeSidebarRowEntered"
                                        PointerExited="OnProjectSectionMenuRowExited">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource PanelIcon}" Stretch="Uniform" />
                                        <TextBlock Grid.Column="1" Text="整理侧边栏" VerticalAlignment="Center" />
                                        <Path Grid.Column="2" Width="9" Height="9"
                                              Data="{StaticResource ChevronRightSmallIcon}" Stretch="Uniform"
                                              StrokeThickness="1.4" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Classes="more-menu-item" Click="OnSessionSortRowClicked"
                                        PointerEntered="OnSessionSortRowEntered"
                                        PointerExited="OnProjectSectionMenuRowExited">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource SortIcon}" Stretch="Uniform"
                                              StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" />
                                        <TextBlock Grid.Column="1" Text="聊天排序方式" VerticalAlignment="Center" />
                                        <Path Grid.Column="2" Width="9" Height="9"
                                              Data="{StaticResource ChevronRightSmallIcon}" Stretch="Uniform"
                                              StrokeThickness="1.4" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ProjectSectionSubmenuCard" IsVisible="False" Width="190"
                                VerticalAlignment="Top"
                                Background="#1E1E21"
                                BorderBrush="#2C2C2F" BorderThickness="1"
                                CornerRadius="12" Padding="6"
                                BoxShadow="0 14 34 0 #99000000"
                                Margin="0,6,0,0"
                                PointerEntered="OnProjectSectionSubmenuPointerEntered"
                                PointerExited="OnProjectSectionSubmenuPointerExited">
                            <Grid>
                                <StackPanel x:Name="OrganizeSidebarOptions" Spacing="1">
                                    <Button Classes="more-menu-item" Click="OnGroupByProjectClicked">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                            <Path Width="14" Height="14" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                                  Stroke="#A0A1A3" StrokeThickness="1.3" StrokeLineCap="Round"
                                                  StrokeJoin="Round" Fill="Transparent" />
                                            <TextBlock Grid.Column="1" Text="分项目显示" VerticalAlignment="Center"
                                                       Foreground="#C6C7C9" />
                                            <Path Grid.Column="2" Width="14" Height="14"
                                                  Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                                  Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  IsVisible="{Binding IsSidebarGrouped}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Classes="more-menu-item" Click="OnMergeDisplayClicked">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                            <Path Width="14" Height="14" Data="{StaticResource QueueIcon}" Stretch="Uniform"
                                                  StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" />
                                            <TextBlock Grid.Column="1" Text="合并显示" VerticalAlignment="Center"
                                                       Foreground="#C6C7C9" />
                                            <Path Grid.Column="2" Width="14" Height="14"
                                                  Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                                  Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  IsVisible="{Binding !IsSidebarGrouped}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="SessionSortOptions" Spacing="1" IsVisible="False">
                                    <Button Classes="more-menu-item" Click="OnSortByUpdatedClicked">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                            <Path Width="14" Height="14" Data="{StaticResource ClockIcon}" Stretch="Uniform" />
                                            <TextBlock Grid.Column="1" Text="最近更新" VerticalAlignment="Center" />
                                            <Path Grid.Column="2" Width="14" Height="14"
                                                  Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                                  Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  IsVisible="{Binding IsSessionSortByUpdated}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Classes="more-menu-item" Click="OnSortByCreatedClicked">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                            <Path Width="14" Height="14" Data="{StaticResource ClockIcon}" Stretch="Uniform" />
                                            <TextBlock Grid.Column="1" Text="创建时间" VerticalAlignment="Center" />
                                            <Path Grid.Column="2" Width="14" Height="14"
                                                  Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                                  Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  IsVisible="{Binding IsSessionSortByCreated}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        </StackPanel>
            </Canvas>
        </Grid>

        <!-- ===================== Hover preview cards ===================== -->
        <Canvas x:Name="PreviewCanvas" Grid.RowSpan="2" ZIndex="45">
            <Border x:Name="DropIndicator" IsVisible="False" Height="2"
                    Background="#7EA6F2" CornerRadius="1"
                    BoxShadow="0 0 6 0 #667EA6F2"
                    IsHitTestVisible="False" />
            <Border x:Name="SessionPreviewCard" IsVisible="False" Width="346"
                    Background="#202022" CornerRadius="12" Padding="12,10"
                    BoxShadow="0 18 44 0 #8C000000" Opacity="0"
                    PointerEntered="OnPreviewCardPointerEntered"
                    PointerExited="OnPreviewCardPointerExited"
                    x:CompileBindings="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="#E3E4E6" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" LineHeight="20" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Top" Margin="0,3,0,0">
                            <Path Width="12" Height="12" Data="{StaticResource ClockIcon}" Stretch="Uniform"
                                  Stroke="{StaticResource SidebarLabel}" StrokeThickness="1.25"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RelativeLabel}" FontSize="11.5"
                                       Foreground="#7C7C7E" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Path Width="12" Height="12" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                              Stroke="{StaticResource SidebarLabel}" StrokeThickness="1.25"
                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Workspace.Name}" FontSize="12.5"
                                   Foreground="#BDBEC1" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="WorkspacePreviewCard" IsVisible="False" Width="322"
                    Background="#202022" CornerRadius="12" Padding="12,10"
                    BoxShadow="0 18 44 0 #8C000000" Opacity="0"
                    PointerEntered="OnPreviewCardPointerEntered"
                    PointerExited="OnPreviewCardPointerExited"
                    x:CompileBindings="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                        <Path Width="14" Height="14" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                              Stroke="{StaticResource SidebarText}" StrokeThickness="1.3"
                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#E3E4E6"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                        <Path Grid.Column="2" Width="13" Height="13" Data="{StaticResource PinIcon}"
                              Stretch="Uniform" IsVisible="{Binding IsPinned}"
                              Stroke="{StaticResource SidebarTextHover}" StrokeThickness="1.3"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Fill="{StaticResource SidebarTextHover}"
                              RenderTransform="rotate(45deg)" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                            <Path Width="13" Height="13" Data="{StaticResource ClockIcon}" Stretch="Uniform"
                                  Stroke="{StaticResource SidebarLabel}" StrokeThickness="1.25"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ChatCountLabel}" FontSize="12"
                                       Foreground="{StaticResource SidebarLabel}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                            <Path Width="13" Height="13" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                  Stroke="{StaticResource SidebarLabel}" StrokeThickness="1.25"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12"
                                       Foreground="{StaticResource SidebarLabel}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                            <Path Width="13" Height="13" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                  Stroke="{StaticResource SidebarLabel}" StrokeThickness="1.25"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ParentPath}" FontSize="12"
                                       Foreground="{StaticResource SidebarLabel}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource LineStrong}" />
                    <Button Classes="row" Height="28" Padding="7,0" CornerRadius="6"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="OnWorkspaceEditClicked">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                            <Path Width="13" Height="13" Data="{StaticResource SettingsIcon}" Stretch="Uniform"
                                  Stroke="{StaticResource SidebarText}" StrokeThickness="1.25"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="编辑项目" FontSize="12"
                                       Foreground="{StaticResource SidebarText}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- ===================== Command palette (Codex search) ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsSearchPaletteOpen}" Background="Transparent" ZIndex="55"
              PointerPressed="OnPaletteBackdropPressed">
            <Border Width="768" MaxHeight="560" Margin="0,147,0,0"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="#0F0F10" BorderBrush="#1E1E20" BorderThickness="1"
                    CornerRadius="12" BoxShadow="0 20 48 0 #B3000000">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" Height="52" ColumnDefinitions="*,Auto" Margin="16,0,12,0">
                        <TextBox x:Name="PaletteSearchBox" Grid.Column="0" Classes="search"
                                 Background="Transparent" BorderThickness="0" FontSize="14"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="搜索聊天或运行命令"
                                 KeyDown="OnPaletteSearchKeyDown" />

                    </Grid>
                    <Border Grid.Row="1" Height="1" Background="#1E1E20" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,6,8,8">
                            <StackPanel IsVisible="{Binding ShowPaletteActions}">
                                <TextBlock Text="快捷操作" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                           Margin="8,6,0,6" />
                                <Button Classes="palette-row" Click="OnPaletteNewChatClicked">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <Path Width="15" Height="15" Data="{StaticResource EditIcon}" Stretch="Uniform" />
                                        <TextBlock Grid.Column="1" Text="新聊天" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Background="#2D2D2E" CornerRadius="5" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="Ctrl+N" FontSize="10.5" Foreground="#B7B8BA" /></Border>
                                    </Grid>
                                </Button>
                                <Button Classes="palette-row" Click="OnPaletteOpenFolderClicked">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <Path Width="15" Height="15" Data="{StaticResource FolderIcon}" Stretch="Uniform" />
                                        <TextBlock Grid.Column="1" Text="打开文件夹" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Background="#2D2D2E" CornerRadius="5" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="Ctrl+O" FontSize="10.5" Foreground="#B7B8BA" /></Border>
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding ShowPaletteChats}">
                                <TextBlock Text="最近聊天" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                           Margin="8,12,0,6" />
                                <ItemsControl ItemsSource="{Binding PaletteSessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SessionItemViewModel">
                                            <Button Classes="palette-row" Click="OnPaletteSessionClicked" Tag="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                    <Ellipse Width="8" Height="8" Stroke="{StaticResource SidebarLabel}"
                                                             StrokeThickness="1.2" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Workspace.Name}" FontSize="11"
                                                               Foreground="{StaticResource TextCaption}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="{Binding PaletteEmptyText}" IsVisible="{Binding ShowPaletteEmpty}"
                                       FontSize="12.5" Foreground="{StaticResource TextTertiary}"
                                       Margin="8,16,0,20" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="3" Background="#111011" BorderBrush="#1E1E20" BorderThickness="0,1,0,0">
                    <Grid Height="42" ColumnDefinitions="Auto,*" Margin="14,0,14,0">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="filter" Classes.active="{Binding IsPaletteFilterAll}"
                                    Click="OnPaletteFilterClicked" Tag="all" Content="All" />
                            <Button Classes="filter" Classes.active="{Binding IsPaletteFilterActions}"
                                    Click="OnPaletteFilterClicked" Tag="actions" Content="Actions" />
                            <Button Classes="filter" Classes.active="{Binding IsPaletteFilterChats}"
                                    Click="OnPaletteFilterClicked" Tag="chats" Content="Chats" />
                            <Button Classes="filter" Classes.active="{Binding IsPaletteFilterFiles}"
                                    Click="OnPaletteFilterClicked" Tag="files" Content="Files" />
                            <Button Classes="filter" Classes.active="{Binding IsPaletteFilterText}"
                                    Click="OnPaletteFilterClicked" Tag="text" Content="Text" />
                        </StackPanel>
                    </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Approval overlay ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsApprovalOpen}" Background="#99000000" ZIndex="60">
            <Border MinWidth="420" MaxWidth="560" Margin="24,0"
                    Background="{StaticResource CardFill}" BorderBrush="{StaticResource LineStrong}"
                    BorderThickness="1" CornerRadius="16" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="工具调用审批" FontSize="12" Foreground="{StaticResource TextCaption}" />
                        <TextBlock Text="{Binding ApprovalTitle}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Text="动作" FontSize="12" Foreground="{StaticResource TextTertiary}" />
                        <TextBlock Grid.Column="1" Text="{Binding ApprovalAction}" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="资源" FontSize="12"
                                   Foreground="{StaticResource TextTertiary}" />
                        <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ApprovalResource}"
                                             FontSize="12" Foreground="{StaticResource TextSecondary}"
                                             TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="原因" FontSize="12"
                                   Foreground="{StaticResource TextTertiary}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ApprovalReason}" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                    </Grid>
                    <StackPanel Spacing="6" IsVisible="{Binding HasApprovalArgs}">
                        <TextBlock Text="参数" FontSize="12" Foreground="{StaticResource TextTertiary}" />
                        <Border Background="{StaticResource ToolCardFill}" CornerRadius="8" Padding="10,8"
                                MaxHeight="170">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <SelectableTextBlock Text="{Binding ApprovalArgs}" FontSize="11"
                                                     Foreground="{StaticResource TextSecondary}"
                                                     TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button x:Name="ApprovalDenyButton" Classes="subtle" Click="OnApprovalDenyClicked"
                                Content="拒绝" />
                        <Button x:Name="ApprovalSessionAllowButton" Classes="secondary"
                                Click="OnApprovalAllowSessionClicked" Content="本会话允许" />
                        <Button x:Name="ApprovalAllowButton" Classes="primary" Click="OnApprovalAllowClicked"
                                Content="允许一次" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Rename / edit project dialog ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsRenameDialogOpen}" Background="#99000000" ZIndex="60">
            <Border Width="508" Background="#1F1F21"
                    BorderBrush="#2E2E31" BorderThickness="1"
                    CornerRadius="16" Padding="24"
                    BoxShadow="0 24 60 0 #A0000000"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding RenameDialogTitle}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#E3E4E6" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Width="28" Height="28"
                                Click="OnCloseDialogClicked">
                            <Path Width="12" Height="12" Data="{StaticResource CloseIcon}"
                                  Stretch="Uniform" Stroke="#7E7F82" StrokeThickness="1.4" />
                        </Button>
                    </Grid>
                    <Border Background="#141416" BorderBrush="#34343A" BorderThickness="1"
                            CornerRadius="8" Height="42" Padding="10,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Path Width="16" Height="16" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                  Stroke="#7E7F82" StrokeThickness="1.3" StrokeLineCap="Round"
                                  StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center" />
                            <TextBox x:Name="RenameBox" Grid.Column="1" Classes="dialog-plain"
                                     Text="{Binding RenameTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnRenameKeyDown" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Spacing="8" IsVisible="{Binding IsEditingWorkspace}">
                        <TextBlock Text="源文件夹" FontSize="12.5" Foreground="#7E7F82" />
                        <Border Background="#17171A" BorderBrush="#2E2E31" BorderThickness="1"
                                CornerRadius="10" Padding="6">
                            <StackPanel>
                                <Grid Height="34" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                      Margin="6,0">
                                    <Path Width="14" Height="14" Data="{StaticResource FolderIcon}"
                                          Stretch="Uniform" Stroke="#C6C7C9" StrokeThickness="1.3"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                          VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding RenameSourcePath}" FontSize="13"
                                               Foreground="#C6C7C9" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <Border Grid.Column="2" Background="#2E2E31" CornerRadius="6"
                                            Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock Text="主要" FontSize="11" Foreground="#C6C7C9" />
                                    </Border>
                                </Grid>
                                <Button Classes="more-menu-item" Height="34" Click="OnEditProjectAddFolderClicked">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="6,0">
                                        <Path Width="14" Height="14" Data="{StaticResource FolderIcon}"
                                              Stretch="Uniform" Stroke="#7E7F82" StrokeThickness="1.3"
                                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                              VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="添加文件夹" FontSize="13"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Button Classes="danger" HorizontalAlignment="Left"
                                IsVisible="{Binding IsEditingWorkspace}"
                                Click="OnRemoveWorkspaceFromDialogClicked"
                                Content="移除本地项目" />
                        <Button Grid.Column="1" Classes="subtle" Click="OnCloseDialogClicked"
                                Content="取消" />
                        <Button Grid.Column="2" Classes="save-light" Click="OnConfirmRenameClicked"
                                Content="保存" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Create project dialog ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsCreateProjectDialogOpen}" Background="#80000000"
              ZIndex="60">
            <Border Width="508" Background="#1F1F21"
                    BorderBrush="#2E2E31" BorderThickness="1"
                    CornerRadius="16" Padding="24"
                    BoxShadow="0 24 60 0 #A0000000"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="创建项目" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#E3E4E6" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Width="28" Height="28"
                                Click="OnCreateProjectCancelClicked">
                            <Path Width="12" Height="12" Data="{StaticResource CloseIcon}"
                                  Stretch="Uniform" Stroke="#7E7F82" StrokeThickness="1.4" />
                        </Button>
                    </Grid>
                    <Border Background="#141416" BorderBrush="#34343A" BorderThickness="1"
                            CornerRadius="8" Height="42" Padding="10,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Path Width="16" Height="16" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                  Stroke="#7E7F82" StrokeThickness="1.3" StrokeLineCap="Round"
                                  StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center" />
                            <TextBox x:Name="ProjectNameBox" Grid.Column="1" Classes="dialog-plain"
                                     Text="{Binding ProjectNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="项目名称" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Spacing="8">
                        <TextBlock Text="源文件夹" FontSize="12.5" Foreground="#7E7F82" />
                        <Border Background="#17171A" BorderBrush="#2E2E31" BorderThickness="1"
                                CornerRadius="10" Height="104">
                            <StackPanel Spacing="10" VerticalAlignment="Center">
                                <Button Classes="subtle" Background="Transparent" Padding="10,4"
                                        HorizontalAlignment="Center" Click="OnCreateProjectBrowseClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="在此电脑上添加文件夹" FontSize="13.5"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                        <Path Width="10" Height="10" Data="{StaticResource ChevronDownIcon}"
                                              Stretch="Uniform" Stroke="#7E7F82" StrokeThickness="1.4"
                                              VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="secondary" Height="30" Padding="12,0"
                                        HorizontalAlignment="Center" Click="OnCreateProjectBrowseClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Width="13" Height="13" Data="{StaticResource FolderIcon}"
                                              Stretch="Uniform" Stroke="#C6C7C9" StrokeThickness="1.3"
                                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="添加" FontSize="12.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding ProjectSourcePath}"
                                   IsVisible="{Binding HasProjectSourcePath}"
                                   FontSize="11.5" Foreground="#7E7F82"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="subtle" Content="取消" Click="OnCreateProjectCancelClicked" />
                        <Button Classes="primary" Content="创建项目"
                                IsEnabled="{Binding CanCreateProject}"
                                Click="OnCreateProjectConfirmClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Automation dialog ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsAutomationDialogOpen}" Background="#99000000"
              ZIndex="60">
            <Border Width="520" Background="{StaticResource CardFill}"
                    BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="16" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding AutomationDialogTitle}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="任务名称" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBox x:Name="AutomationNameBox" Classes="field"
                                 Text="{Binding AutomationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="例如：每日项目摘要" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="发送给模型的指令" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBox Classes="field" MinHeight="130" MaxHeight="220"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Text="{Binding AutomationPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="检查当前工作区并总结今天需要处理的事项。" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="运行间隔" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" />
                        <ComboBox Classes="field" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding AutomationIntervals}"
                                  SelectedItem="{Binding SelectedAutomationInterval, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AutomationDialogStatus}" FontSize="11" Foreground="#E6A0A0"
                               IsVisible="{Binding HasAutomationDialogStatus}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="subtle" Click="OnCloseDialogClicked" Content="取消" />
                        <Button Classes="primary" Click="OnSaveAutomationClicked" Content="保存任务" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Automation delete dialog ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsAutomationDeleteDialogOpen}" Background="#99000000"
              ZIndex="60">
            <Border Width="420" Background="{StaticResource CardFill}"
                    BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="16" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="7">
                        <TextBlock Text="删除自动化任务" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="{Binding AutomationDeletePrompt}" FontSize="12"
                                   Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="subtle" Click="OnCloseDialogClicked" Content="取消" />
                        <Button Classes="danger" Click="OnConfirmDeleteAutomationClicked" Content="删除" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Delete session dialog ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsDeleteDialogOpen}" Background="#99000000" ZIndex="60">
            <Border Width="420" Background="{StaticResource CardFill}"
                    BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="16" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="7">
                        <TextBlock Text="删除会话" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="{Binding DeletePrompt}" FontSize="12"
                                   Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="subtle" Click="OnCloseDialogClicked" Content="取消" />
                        <Button Classes="danger" Click="OnConfirmDeleteClicked" Content="删除" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
