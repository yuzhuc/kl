<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Kl.Gui.ViewModels"
        xmlns:controls="using:Kl.Gui.Controls"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        xmlns:media="using:Avalonia.Media"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Kl.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="kl"
        Icon="/Assets/kl.png"
        Width="1280" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBase}"
        FontFamily="{StaticResource UiFont}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        KeyDown="OnWindowKeyDown"
        PointerPressed="OnWindowPointerPressed"
        Deactivated="OnWindowDeactivated"
        Closing="OnWindowClosing">

    <Window.Resources>
        <DataTemplate x:Key="AttachmentChipTemplate" x:DataType="vm:AttachmentItemViewModel">
            <Border Background="{StaticResource ElevatedHover}" CornerRadius="8" Padding="8,4" Margin="0,0,6,4">
                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                    <Path Width="13" Height="13" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                          Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3"
                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                          VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="{Binding SizeLabel}" FontSize="10" Foreground="{StaticResource TextCaption}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="message-action" Width="18" Height="18" Padding="0"
                            Click="OnRemoveAttachmentClicked" ToolTip.Tip="移除附件">
                        <TextBlock Text="×" FontSize="13" Foreground="{StaticResource TextCaption}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NestedSessionRowTemplate" x:DataType="vm:SessionItemViewModel">
            <Grid Classes="session-row-container" IsVisible="{Binding IsListVisible}" Margin="8,0,8,1">
                <Button Classes="session-row nested" Classes.active="{Binding IsSelected}" Click="OnSessionClicked"
                        PointerEntered="OnSessionRowPointerEntered"
                        PointerExited="OnSessionRowPointerExited">
                    <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="0,0,76,0" />
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse Width="6" Height="6" Fill="#4D9FFF" IsVisible="{Binding IsUnread}"
                             VerticalAlignment="Center" ToolTip.Tip="未读" />
                    <Button Classes="row-action" Classes.pinned="{Binding IsPinned}"
                            Click="OnPinSessionClicked" ToolTip.Tip="置顶聊天" ToolTip.Placement="Top" ToolTip.VerticalOffset="-5">
                        <Path Width="11" Height="11" Data="{StaticResource PinIcon}" Stretch="Uniform" Margin="0,2,0,0"
                              RenderTransform="rotate(45deg)" />
                    </Button>
                    <Button Classes="row-action" Click="OnArchiveSessionClicked" ToolTip.Tip="归档聊天" ToolTip.Placement="Top" ToolTip.VerticalOffset="-5">
                        <Path Width="11" Height="11" Data="{StaticResource ArchiveIcon}" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WorkspaceRowTemplate" x:DataType="vm:WorkspaceItemViewModel">
            <StackPanel IsVisible="{Binding IsVisible}">
                <Grid Classes="session-row-container" Margin="8,0,8,1">
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="置顶" Click="OnWorkspacePinMenuClicked" />
                            <MenuItem Header="归档聊天" Click="OnWorkspaceArchiveMenuClicked" />
                            <MenuItem Header="移除项目" Click="OnWorkspaceRemoveMenuClicked" />
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <Button Classes="row" Classes.active="{Binding IsSelected}" Height="30" Padding="10,0" CornerRadius="8"
                            Click="OnWorkspaceClicked"
                            PointerEntered="OnWorkspaceRowPointerEntered"
                            PointerExited="OnWorkspaceRowPointerExited">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <Path Width="16" Height="16" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                  StrokeThickness="1.35"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="6"
                                  VerticalAlignment="Center" Margin="0,0,76,0">
                                <TextBlock Text="{Binding Name}" FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Classes="row-action" Click="OnWorkspaceMoreClicked" ToolTip.Tip="更多" ToolTip.Placement="Top" ToolTip.VerticalOffset="-5">
                            <Path Width="11" Height="11" Data="{StaticResource MoreDotsIcon}" Stretch="Uniform" />
                        </Button>
                        <Button Classes="row-action" Click="OnWorkspaceEditClicked" ToolTip.Tip="编辑项目" ToolTip.Placement="Top" ToolTip.VerticalOffset="-5">
                            <Path Width="12" Height="12" Data="{StaticResource SquarePenIcon}" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock Text="暂无聊天" IsVisible="{Binding HasNoSessions}" FontSize="12"
                           Foreground="{StaticResource SidebarLabel}" Margin="40,4,0,6" />
                <ItemsControl ItemsSource="{Binding Sessions}" IsVisible="{Binding ShowSessions}"
                              ItemTemplate="{StaticResource NestedSessionRowTemplate}" Margin="0,0,0,2" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="RecentSessionTemplate" x:DataType="vm:SessionItemViewModel">
            <Grid Classes="session-row-container" IsVisible="{Binding IsListVisible}" Margin="8,0,8,1">
                <Button Classes="session-row" Classes.active="{Binding IsSelected}" Click="OnSessionClicked"
                        PointerEntered="OnSessionRowPointerEntered"
                        PointerExited="OnSessionRowPointerExited">
                    <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="0,0,76,0" />
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse Width="6" Height="6" Fill="#4D9FFF" IsVisible="{Binding IsUnread}"
                             VerticalAlignment="Center" ToolTip.Tip="未读" />
                    <Button Classes="row-action" Classes.pinned="{Binding IsPinned}"
                            Click="OnPinSessionClicked" ToolTip.Tip="置顶聊天" ToolTip.Placement="Top" ToolTip.VerticalOffset="-5">
                        <Path Width="11" Height="11" Data="{StaticResource PinIcon}" Stretch="Uniform" Margin="0,2,0,0"
                              RenderTransform="rotate(45deg)" />
                    </Button>
                    <Button Classes="row-action" Click="OnArchiveSessionClicked" ToolTip.Tip="归档聊天" ToolTip.Placement="Top" ToolTip.VerticalOffset="-5">
                        <Path Width="11" Height="11" Data="{StaticResource ArchiveIcon}" Stretch="Uniform" />
                    </Button>
                </StackPanel>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="标记为未读" Click="OnMarkSessionUnreadClicked" Tag="{Binding}" />
                        <MenuItem Header="重命名" Click="OnRenameSessionClicked" Tag="{Binding}" />
                        <MenuItem Header="删除" Click="OnDeleteSessionClicked" Tag="{Binding}" />
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ArchivedSessionTemplate" x:DataType="vm:SessionItemViewModel">
            <Grid Classes="session-row-container" IsVisible="{Binding IsListVisible}" Margin="8,0,8,1">
                <Button Classes="session-row" Click="OnSessionClicked" ToolTip.Tip="{Binding Workspace.Path}">
                    <TextBlock Text="{Binding Title}" FontSize="13.5" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{StaticResource SidebarLabel}" Margin="0,0,36,0" />
                </Button>
                <Button Classes="row-action" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,4,0" Click="OnUnarchiveSessionClicked" ToolTip.Tip="取消归档">
                    <Path Width="13" Height="13" Data="{StaticResource RefreshIcon}" Stretch="Uniform" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ToolChildTemplate" x:DataType="vm:ChatItemViewModel">
            <StackPanel Spacing="6">
                <Button Classes="activity-row compact" Classes.expanded="{Binding ShowExpanded}" Click="OnActivityClicked">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource ToolIcon}" Stretch="Uniform"
                              IsVisible="{Binding IsPlainTool}" Classes="activity-icon" StrokeThickness="1.3"
                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              VerticalAlignment="Center" />
                        <Path Width="14" Height="14" Data="{StaticResource ImageIcon}" Stretch="Uniform"
                              IsVisible="{Binding IsImageTool}" Classes="activity-icon" StrokeThickness="1.2"
                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ActivityChildLabel}" FontSize="13"
                                   FontFamily="Cascadia Mono, Consolas"
                                   Classes="activity-label"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" VerticalAlignment="Center" />
                        <Path Grid.Column="2" Classes="activity-chevron" Width="11" Height="11"
                              Data="{StaticResource ChevronDownIcon}" Stretch="Uniform"
                              StrokeThickness="1.4"
                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Border IsVisible="{Binding ShowExpanded}" Classes="tool-panel"
                        Classes.open="{Binding ShowExpanded}">
                    <StackPanel>
                        <TextBlock Text="{Binding ToolLabel}" FontSize="12"
                                   Foreground="#A8A9AB"
                                   IsVisible="{Binding IsTool}" Margin="0,0,0,10" />
                        <StackPanel IsVisible="{Binding IsTool}" Spacing="0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding HasText}">
                                <TextBlock Text="$" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           Foreground="#7A7A7C" VerticalAlignment="Top" />
                                <SelectableTextBlock Grid.Column="1" Text="{Binding Text}"
                                                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                     LineHeight="19" Foreground="#A8A9AB"
                                                     TextWrapping="Wrap" MaxHeight="140" />
                            </Grid>
                            <ScrollViewer IsVisible="{Binding HasDetail}" MaxHeight="260" Margin="0,14,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <SelectableTextBlock Text="{Binding Detail}"
                                                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                     LineHeight="19" Foreground="#A8A9AB"
                                                     TextWrapping="Wrap" />
                            </ScrollViewer>
                            <TextBlock Text="{Binding Summary}" FontSize="11"
                                       Foreground="#8E8F91"
                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right"
                                    IsVisible="{Binding HasStatus}" Margin="0,10,0,0">
                            <Path Width="12" Height="12" Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                  IsVisible="{Binding !HasFailure}" Stroke="#8E8F91" StrokeThickness="1.5"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <Path Width="12" Height="12" Data="{StaticResource CloseIcon}" Stretch="Uniform"
                                  IsVisible="{Binding HasFailure}" Stroke="#E5837C" StrokeThickness="1.5"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                       Foreground="#8E8F91" IsVisible="{Binding !HasFailure}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                       Foreground="#E5837C" IsVisible="{Binding HasFailure}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ChatItemTemplate" x:DataType="vm:ChatItemViewModel">
            <Grid>
                <!-- user bubble -->
                <StackPanel IsVisible="{Binding IsUser}" Margin="0,0,0,25" Spacing="18">
                    <TextBlock Text="{Binding TurnLabel}" IsVisible="{Binding HasTurnLabel}"
                               FontSize="12" Foreground="#737375" HorizontalAlignment="Center"
                               Margin="0,31,0,0" />
                    <StackPanel Classes="chat-user" HorizontalAlignment="Right" Spacing="3">
                        <Border MaxWidth="560" Classes="chat-user-bubble"
                                Classes.jump-highlight="{Binding IsJumpHighlighted}"
                                Background="{StaticResource UserBubbleFill}" CornerRadius="18"
                                Padding="15,10" HorizontalAlignment="Right">
                            <SelectableTextBlock Text="{Binding Text}"
                                                 FontSize="{DynamicResource ChatContentFontSize}"
                                                 LineHeight="{DynamicResource ChatContentLineHeight}"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Classes="chat-user-actions" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Spacing="2">
                            <TextBlock Text="{Binding TimestampLabel}" FontSize="11"
                                       Foreground="{StaticResource TextCaption}" VerticalAlignment="Center"
                                       Margin="0,0,4,0" />
                            <Button Classes="message-action" Click="OnCopyMessageClicked" ToolTip.Tip="复制">
                                <Path Width="13" Height="13" Data="{StaticResource CopyIcon}" Stretch="Uniform" />
                            </Button>
                            <Button Classes="message-action" Click="OnEditUserMessageClicked" ToolTip.Tip="编辑">
                                <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- assistant -->
                <StackPanel Classes="chat-assistant" IsVisible="{Binding IsAssistant}" Spacing="4" Margin="0,0,0,14"
                            Background="Transparent">
                    <controls:MarkdownTextBlock Text="{Binding Text}"
                                                ContentFontSize="{DynamicResource ChatContentFontSize}"
                                                ContentLineHeight="{DynamicResource ChatContentLineHeight}"
                                                CodeFontSize="{DynamicResource ChatCodeFontSize}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Foreground="{StaticResource TextCaption}"
                               IsVisible="{Binding HasStatus}" />
                    <StackPanel Classes="chat-assistant-actions" Orientation="Horizontal" Spacing="2"
                                IsVisible="{Binding ShowAssistantActions}">
                        <Button Classes="message-action" Click="OnCopyMessageClicked" ToolTip.Tip="复制回复">
                            <Path Width="13" Height="13" Data="{StaticResource CopyIcon}" Stretch="Uniform" />
                        </Button>
                        <Button Classes="message-action" ToolTip.Tip="更多">
                            <Path Width="13" Height="13" Data="{StaticResource MoreDotsIcon}" Stretch="Uniform" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="复制回复" Click="OnCopyMessageClicked" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock Text="{Binding TimestampLabel}" IsVisible="{Binding HasTimestamp}"
                                   FontSize="11" Foreground="{StaticResource TextCaption}"
                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- error -->
                <Border IsVisible="{Binding IsError}" Margin="0,0,0,14" Background="#2A20221F" BorderBrush="#553B3B2B"
                        BorderThickness="0.5" CornerRadius="10" Padding="12,9">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                        <Path Width="14" Height="14" Data="{StaticResource WarningIcon}" Stretch="Uniform"
                              Stroke="#E6A0A0" StrokeThickness="1.4"
                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              VerticalAlignment="Top" Margin="0,3,0,0" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12.5" LineHeight="19"
                                             Foreground="#E6B4B4" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- grouped tool calls (运行了命令) -->
                <StackPanel IsVisible="{Binding IsToolGroup}" Spacing="2" Margin="0,0,0,2">
                    <Button Classes="activity-row" Classes.expanded="{Binding GroupExpanded}" Click="OnActivityClicked">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                            <Path Width="14" Height="14" Data="{StaticResource ToolIcon}" Stretch="Uniform"
                                  IsVisible="{Binding !IsImageTool}" Classes="activity-icon" StrokeThickness="1.35"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <Path Width="14" Height="14" Data="{StaticResource ImageIcon}" Stretch="Uniform"
                                  IsVisible="{Binding IsImageTool}" Classes="activity-icon" StrokeThickness="1.2"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Header}" FontSize="13.5"
                                       Classes="activity-label" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Path Grid.Column="2" Classes="activity-chevron" Width="11" Height="11"
                                  Data="{StaticResource ChevronDownIcon}" Stretch="Uniform"
                                  StrokeThickness="1.4"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Codex hangs expanded children off a thin guide line, with no panel behind them. -->
                    <Grid IsVisible="{Binding GroupExpanded}">
                        <Border Width="1" Background="#1F1F21" HorizontalAlignment="Left" Margin="8,0,0,0" />
                        <ItemsControl ItemsSource="{Binding Children}"
                                      ItemTemplate="{StaticResource ToolChildTemplate}" />
                    </Grid>
                </StackPanel>

                <!-- reasoning / tool activity (Codex-style inline row + expanded shell panel) -->
                <StackPanel IsVisible="{Binding IsActivity}" Spacing="6" Margin="0,0,0,8">
                    <Button Classes="activity-row" Classes.expanded="{Binding ShowExpanded}" Click="OnActivityClicked">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                            <Path Width="14" Height="14" Data="{StaticResource ThoughtIcon}" Stretch="Uniform"
                                  IsVisible="{Binding IsReasoning}" Classes="activity-icon" StrokeThickness="1.35"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <Path Width="14" Height="14" Data="{StaticResource ToolIcon}" Stretch="Uniform"
                                  IsVisible="{Binding IsPlainTool}" Classes="activity-icon" StrokeThickness="1.35"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <Path Width="14" Height="14" Data="{StaticResource ImageIcon}" Stretch="Uniform"
                                  IsVisible="{Binding IsImageTool}" Classes="activity-icon" StrokeThickness="1.2"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActivityPrefix}" FontSize="13.5"
                                           Classes="activity-label" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActivityCommand}" IsVisible="{Binding HasActivityCommand}"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           Classes="activity-label" TextTrimming="CharacterEllipsis"
                                           MaxWidth="520" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Path Classes="activity-chevron" Width="11" Height="11"
                                      Data="{StaticResource ChevronDownIcon}" Stretch="Uniform"
                                      StrokeThickness="1.4"
                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11"
                                           Classes.running-pulse="{Binding IsRunning}"
                                           Foreground="{StaticResource TextCaption}"
                                           IsVisible="{Binding IsRunning}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                    </Button>

                    <Border IsVisible="{Binding ShowExpanded}" Classes="tool-panel"
                            Classes.open="{Binding ShowExpanded}">
                        <StackPanel>
                            <TextBlock Text="{Binding ToolLabel}" FontSize="12"
                                       Foreground="#A8A9AB"
                                       IsVisible="{Binding IsTool}" Margin="0,0,0,10" />
                            <ScrollViewer IsVisible="{Binding IsReasoning}" MaxHeight="260"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <SelectableTextBlock Text="{Binding Text}"
                                                     FontSize="13" LineHeight="20"
                                                     Foreground="#A0A1A3"
                                                     TextWrapping="Wrap" />
                            </ScrollViewer>
                            <StackPanel IsVisible="{Binding IsTool}" Spacing="0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding HasText}">
                                    <TextBlock Text="$" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                               Foreground="#7A7A7C" VerticalAlignment="Top" />
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Text}"
                                                         FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                         LineHeight="19" Foreground="#A8A9AB"
                                                         TextWrapping="Wrap" MaxHeight="140" />
                                </Grid>
                                <ScrollViewer IsVisible="{Binding HasDetail}" MaxHeight="260" Margin="0,14,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <SelectableTextBlock Text="{Binding Detail}"
                                                         FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                         LineHeight="19" Foreground="#A8A9AB"
                                                         TextWrapping="Wrap" />
                                </ScrollViewer>
                                <TextBlock Text="{Binding Summary}" FontSize="11"
                                           Foreground="#8E8F91"
                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right"
                                        IsVisible="{Binding HasStatus}" Margin="0,10,0,0">
                                <Path Width="12" Height="12" Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                      IsVisible="{Binding !HasFailure}" Stroke="#8E8F91" StrokeThickness="1.5"
                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      VerticalAlignment="Center" />
                                <Path Width="12" Height="12" Data="{StaticResource CloseIcon}" Stretch="Uniform"
                                      IsVisible="{Binding HasFailure}" Stroke="#E5837C" StrokeThickness="1.5"
                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                           Foreground="#8E8F91" IsVisible="{Binding !HasFailure}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                           Foreground="#E5837C" IsVisible="{Binding HasFailure}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="44,*">
        <!-- ===================== Title bar ===================== -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarFill}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Spacing="2" Margin="4,3,0,0">
                    <Button Classes="titlebar-icon" IsEnabled="False" ToolTip.Tip="后退">
                        <Path Width="14" Height="14" Data="{StaticResource ArrowLeftIcon}" />
                    </Button>
                    <Button Classes="titlebar-icon" IsEnabled="False" ToolTip.Tip="前进">
                        <Path Width="14" Height="14" Data="{StaticResource ArrowRightIcon}" />
                    </Button>
                    <Button Classes="titlebar-icon" Click="OnToggleSidebarClicked" ToolTip.Tip="切换侧边栏">
                        <Path Width="14" Height="14" Data="{StaticResource PanelIcon}" />
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="0" Margin="6,0,0,0">
                        <Button Classes="titlebar-menu" Content="文件">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="新建会话" Click="OnNewSessionClicked" />
                                    <MenuItem Header="添加项目" Click="OnAddWorkspaceClicked" />
                                    <Separator />
                                    <MenuItem Header="退出" Click="OnExitClicked" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="titlebar-menu" Content="编辑">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="搜索会话" Click="OnToggleSearchClicked" />
                                    <MenuItem Header="设置" Click="OnNavSettingsClicked" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="titlebar-menu" Content="视图">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="显示/隐藏侧边栏" Click="OnToggleSidebarClicked" />
                                    <MenuItem Header="打开设置" Click="OnNavSettingsClicked" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="titlebar-menu" Content="帮助">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="打开数据目录" Click="OnOpenStateDirectoryClicked" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Background="Transparent"
                      PointerPressed="OnTitleBarPointerPressed"
                      DoubleTapped="OnTitleBarDoubleTapped" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Classes="caption" Click="OnMinimizeClicked" ToolTip.Tip="最小化">
                        <Border Width="10" Height="1" Background="White"
                                VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>
                    <Button Classes="caption" Click="OnMaximizeClicked" ToolTip.Tip="最大化">
                        <Path x:Name="MaximizeGlyph" Width="9" Height="9" Data="{StaticResource MaximizeIcon}" />
                    </Button>
                    <Button Classes="caption close" Click="OnCloseWindowClicked" ToolTip.Tip="关闭">
                        <Path Width="9" Height="9" Data="{StaticResource CloseIcon}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Body ===================== -->
        <Grid Grid.Row="1" ColumnDefinitions="52,Auto,*">
            <!-- rail -->
            <Border Grid.Column="0" Background="{StaticResource SidebarRailFill}"
                    BorderBrush="{StaticResource SidebarDivider}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="ChatRailButton" Classes="rail" Classes.active="{Binding IsChatPage}"
                                HorizontalAlignment="Center" Click="OnNavChatClicked" Tag="首页"
                                ToolTip.Tip="首页" ToolTip.Placement="Right" ToolTip.HorizontalOffset="12" ToolTip.VerticalOffset="-2"
                                ToolTip.ShowDelay="450">
                            <Viewbox Width="19" Height="19">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="rail-line" Data="{StaticResource RailChatIcon}" Stretch="None"
                                          StrokeThickness="1.54" />
                                    <Path Classes="rail-solid" Data="{StaticResource RailChatIcon}" Stretch="None" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="ProjectsRailButton" Classes="rail" Classes.active="{Binding IsProjectsPage}"
                                HorizontalAlignment="Center" Click="OnNavProjectsClicked" Tag="项目"
                                ToolTip.Tip="项目" ToolTip.Placement="Right" ToolTip.HorizontalOffset="12" ToolTip.VerticalOffset="-2"
                                ToolTip.ShowDelay="450">
                            <Viewbox Width="20" Height="20">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="rail-line" Data="{StaticResource RailProjectsIcon}" Stretch="None"
                                          StrokeThickness="1.6" />
                                    <Path Classes="rail-solid" Data="{StaticResource RailProjectsIcon}" Stretch="None" />
                                    <Ellipse Width="3.4" Height="3.4" Canvas.Left="9.3" Canvas.Top="10.3" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="AutomationRailButton" Classes="rail" Classes.active="{Binding IsAutomationPage}"
                                HorizontalAlignment="Center" Click="OnNavAutomationClicked" Tag="定时任务"
                                ToolTip.Tip="定时任务" ToolTip.Placement="Right" ToolTip.HorizontalOffset="12" ToolTip.VerticalOffset="-2"
                                ToolTip.ShowDelay="450">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="rail-line" Data="{StaticResource RailAutomationIcon}" Stretch="None"
                                          StrokeThickness="1.8" />
                                    <Path Classes="rail-solid" Data="{StaticResource RailAutomationSolid}" Stretch="None" />
                                    <Path Classes="rail-cut" Data="{StaticResource RailAutomationHands}" Stretch="None"
                                          StrokeThickness="2.2" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Classes="rail" Classes.active="{Binding IsLibraryPage}"
                                HorizontalAlignment="Center" Click="OnNavLibraryClicked" Tag="资料库"
                                ToolTip.Tip="资料库" ToolTip.Placement="Right" ToolTip.HorizontalOffset="12"
                                ToolTip.VerticalOffset="-2" ToolTip.ShowDelay="450">
                            <Viewbox Width="17" Height="17">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="rail-line" Data="{StaticResource RailLibraryIcon}" Stretch="None"
                                          StrokeThickness="1.8" />
                                    <Path Classes="rail-solid" Data="{StaticResource RailLibrarySolid}" Stretch="None" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="PluginsRailButton" Classes="rail" Classes.active="{Binding IsPluginsPage}"
                                HorizontalAlignment="Center" Click="OnNavPluginsClicked" Tag="插件"
                                ToolTip.Tip="插件" ToolTip.Placement="Right" ToolTip.HorizontalOffset="12" ToolTip.VerticalOffset="-2"
                                ToolTip.ShowDelay="450">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="rail-line" Data="{StaticResource RailPluginIcon}" Stretch="None"
                                          StrokeThickness="1.8" />
                                    <Path Classes="rail-solid" Data="{StaticResource RailPluginSolid}" Stretch="None" />
                                    <Path Classes="rail-cut" Data="{StaticResource RailPluginInner}" Stretch="None"
                                          StrokeThickness="2.1" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="MoreButton" Classes="rail" HorizontalAlignment="Center"
                                Click="OnMoreButtonClicked"
                                PointerEntered="OnMoreButtonPointerEntered" PointerExited="OnMoreButtonPointerExited">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <Ellipse Width="2.5" Height="2.5" />
                                <Ellipse Width="2.5" Height="2.5" />
                                <Ellipse Width="2.5" Height="2.5" />
                            </StackPanel>
                        </Button>
                        <Border Width="24" Height="1" Background="#2A2A2C"
                                HorizontalAlignment="Center" Margin="0,0,0,0" />
                        <ItemsControl ItemsSource="{Binding PinnedRailItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PinnedRailItemViewModel">
                                    <Button Classes="rail pinned" Classes.active="{Binding IsActive}"
                                            HorizontalAlignment="Center"
                                            Click="OnPinnedRailItemClicked"
                                            ToolTip.Tip="{Binding Label}"
                                            ToolTip.Placement="Right" ToolTip.HorizontalOffset="12"
                                            ToolTip.VerticalOffset="-2" ToolTip.ShowDelay="450">
                                        <Grid>
                                            <Path Width="16" Height="16" Data="{StaticResource FolderIcon}"
                                                  Stretch="Uniform" IsVisible="{Binding IsProject}" />
                                            <Path Width="15" Height="15" Data="{StaticResource CodeReviewIcon}"
                                                  Stretch="Uniform" IsVisible="{Binding !IsProject}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Button Grid.Row="2" Classes="rail" Width="32" Height="32" HorizontalAlignment="Center"
                            Margin="0,0,0,12" Click="OnNavSettingsClicked" ToolTip.Tip="设置"
                            ToolTip.Placement="Right" ToolTip.HorizontalOffset="12" ToolTip.VerticalOffset="-2" ToolTip.ShowDelay="450">
                        <Path Width="18" Height="18" Data="{StaticResource SettingsIcon}" Stretch="Uniform" />
                    </Button>
                </Grid>
            </Border>

            <!-- sidebar -->
            <Border x:Name="SidebarPanelBorder" Grid.Column="1" Width="284" ClipToBounds="True"
                    Background="{StaticResource SidebarFill}"
                    BorderBrush="{StaticResource SidebarDivider}" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- chat sidebar -->
                    <Grid IsVisible="{Binding IsChatPage}" RowDefinitions="Auto,Auto,Auto,*">
                        <Grid Grid.Row="0" Height="29" ColumnDefinitions="*,Auto" Margin="18,12,11,0">
                            <Button x:Name="ProductMenuButton" Classes="product-menu-toggle"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Click="OnProductMenuClicked" ToolTip.Tip="切换 Chat / Work">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveModeLabel}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource SidebarText}" />
                                    <Path Width="10" Height="10" Data="{StaticResource ChevronDownIcon}"
                                          Stretch="Uniform" Stroke="{StaticResource SidebarLabel}"
                                          StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"
                                          Fill="Transparent" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <Button Classes="icon sidebar-icon" Classes.active="{Binding IsNotificationsVisible}"
                                        Click="OnNotificationsButtonClicked">
                                    <Path Width="12" Height="12" Data="{StaticResource BellIcon}" Stretch="Uniform" />
                                </Button>
                                <Button Classes="icon sidebar-icon" Click="OnSearchButtonClicked">
                                    <Path Width="12" Height="12" Data="{StaticResource SearchIcon}" Stretch="Uniform" />
                                </Button>
                            </StackPanel>

                            <!-- product / mode switcher, Codex-style -->
                            <Popup x:Name="ProductMenuPopup" PlacementTarget="{Binding #ProductMenuButton}"
                                   Placement="BottomEdgeAlignedLeft" HorizontalOffset="-11" VerticalOffset="14"
                                   IsLightDismissEnabled="True">
                                <Border x:Name="ProductMenuCard" Width="246" Opacity="0"
                                        Background="{StaticResource ProductMenuFill}"
                                        BorderBrush="{StaticResource ProductMenuLine}" BorderThickness="1"
                                        CornerRadius="12" Padding="6"
                                        BoxShadow="0 14 34 0 #99000000">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
                                        </Transitions>
                                    </Border.Transitions>
                                    <StackPanel Spacing="2">
                                        <Button Classes="mode-menu-item" Click="OnChatModeMenuClicked">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                                                <TextBlock Text="Chat" FontSize="13.5"
                                                           Foreground="{StaticResource SidebarText}" />
                                                <TextBlock Grid.Row="1" Text="创建、学习和探索" FontSize="12"
                                                           Foreground="{StaticResource SidebarLabel}" />
                                                <Path Grid.Column="1" Grid.RowSpan="2" Width="14" Height="14"
                                                      Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                                      Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                      IsVisible="{Binding IsChatMode}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <Button Classes="mode-menu-item" Click="OnWorkModeMenuClicked">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                                                <TextBlock Text="Work" FontSize="13.5"
                                                           Foreground="{StaticResource SidebarText}" />
                                                <TextBlock Grid.Row="1" Text="构建、调试和发布" FontSize="12"
                                                           Foreground="{StaticResource SidebarLabel}" />
                                                <Path Grid.Column="1" Grid.RowSpan="2" Width="14" Height="14"
                                                      Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                                      Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                      IsVisible="{Binding IsWorkMode}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Border Grid.Row="1" IsVisible="{Binding IsSearchVisible}"
                                Background="#1F1F20" CornerRadius="17"
                                Height="34" Margin="6,0,6,8" Padding="12,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                <Path Width="13" Height="13" Data="{StaticResource SearchIcon}" Stretch="Uniform"
                                      Stroke="{StaticResource TextTertiary}" StrokeThickness="1.35"
                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      VerticalAlignment="Center" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" Classes="search"
                                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="搜索会话" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- fixed new-chat row (Codex keeps this out of the scroll area) -->
                        <Button Grid.Row="2" Classes="row" Height="30" Padding="10,0" CornerRadius="8"
                                Margin="8,11,15,8" Click="OnNewSessionClicked"
                                IsVisible="{Binding !IsNotificationsVisible}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Path Width="12" Height="12" Data="{StaticResource ComposeIcon}" Stretch="Uniform"
                                      StrokeThickness="1.4"
                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="新聊天" FontSize="14"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Visible"
                                      AllowAutoHide="False" Margin="0,0,1,0"
                                      IsVisible="{Binding !IsNotificationsVisible}"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel IsVisible="{Binding HasPinnedSessions}" Margin="0,6,0,0">
                                    <Grid Classes="session-row-container">
                                        <Button Classes="section-header" Click="OnTogglePinnedSectionClicked">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="置顶" FontSize="14" LineHeight="21"
                                                           Foreground="{StaticResource SidebarLabel}"
                                                           VerticalAlignment="Center" />
                                                <Path Classes="section-chevron" Width="10" Height="10"
                                                      Data="{StaticResource ChevronDownIcon}" Stretch="Uniform"
                                                      Classes.collapsed="{Binding !IsPinnedExpanded}"
                                                      VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" Spacing="0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Margin="0,0,16,0">
                                            <Button Classes="row-action" Click="OnPinnedSectionMoreClicked">
                                                <Path Width="12" Height="12" Data="{StaticResource QueueIcon}"
                                                      Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl x:Name="PinnedItemsControl" ItemsSource="{Binding PinnedSessions}"
                                                  ItemTemplate="{StaticResource RecentSessionTemplate}"
                                                  IsVisible="{Binding IsPinnedExpanded}" ClipToBounds="True" />
                                </StackPanel>

                                <Grid Classes="session-row-container" Margin="0,16,0,0"
                                      IsVisible="{Binding IsSidebarGrouped}">
                                    <Button Classes="section-header"
                                            Click="OnToggleProjectSectionClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="项目" FontSize="14" LineHeight="21"
                                                       Foreground="{StaticResource SidebarLabel}" VerticalAlignment="Center" />
                                            <Path Classes="section-chevron" Width="10" Height="10"
                                                  Data="{StaticResource ChevronDownIcon}" Stretch="Uniform"
                                                  Classes.collapsed="{Binding !IsProjectSectionExpanded}"
                                                  VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Button Classes="row-action" Click="OnProjectSectionMoreClicked">
                                            <Path Width="12" Height="12" Data="{StaticResource QueueIcon}" Stretch="Uniform" />
                                        </Button>
                                        <Button Classes="row-action" Click="OnAddWorkspaceClicked">
                                            <Path Width="11" Height="11" Data="{StaticResource PlusIcon}" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl x:Name="WorkspaceItemsControl" ItemsSource="{Binding Workspaces}"
                                              ItemTemplate="{StaticResource WorkspaceRowTemplate}"
                                              IsVisible="{Binding ShowProjectList}"
                                              ClipToBounds="True"
                                              Margin="0,6,0,0" />

                                <Grid Classes="session-row-container" Margin="0,18,0,0">
                                    <Button Classes="section-header"
                                            Click="OnToggleRecentClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="最近" FontSize="14" LineHeight="21"
                                                       Foreground="{StaticResource SidebarLabel}" VerticalAlignment="Center" />
                                            <Path Classes="section-chevron" Width="10" Height="10"
                                                  Data="{StaticResource ChevronDownIcon}" Stretch="Uniform"
                                                  Classes.collapsed="{Binding !IsRecentExpanded}"
                                                  VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Button Classes="row-action" Click="OnProjectSectionMoreClicked">
                                            <Path Width="12" Height="12" Data="{StaticResource QueueIcon}" Stretch="Uniform" />
                                        </Button>
                                        <Button Classes="row-action" Click="OnNewSessionClicked">
                                            <Path Width="12" Height="12" Data="{StaticResource ComposeIcon}" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl x:Name="RecentItemsControl" ItemsSource="{Binding RecentSessions}"
                                              ItemTemplate="{StaticResource RecentSessionTemplate}"
                                              IsVisible="{Binding IsRecentExpanded}"
                                              ClipToBounds="True"
                                              Margin="0,6,0,0" />
                                <TextBlock Text="暂无会话" IsVisible="{Binding ShowNoRecentSessions}"
                                           FontSize="12" Foreground="{StaticResource SidebarLabel}"
                                           Margin="16,6,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- notifications pane (Codex bell) -->
                        <ScrollViewer Grid.Row="3" IsVisible="{Binding IsNotificationsVisible}"
                                      VerticalScrollBarVisibility="Visible"
                                      AllowAutoHide="False"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Height="28" Margin="16,16,12,0">
                                    <TextBlock Text="优先级" FontSize="13"
                                               Foreground="{StaticResource SidebarLabel}" VerticalAlignment="Center" />
                                    <Button Classes="row-action" Opacity="1" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="0,0,15,0"
                                            Click="OnNotificationMenuClicked">
                                        <Path Width="11" Height="11" Data="{StaticResource MoreDotsIcon}"
                                              Stretch="Uniform" />
                                    </Button>
                                </Grid>
                                <TextBlock Text="部分未读聊天暂时不可用" FontSize="12"
                                           Foreground="{StaticResource SidebarLabel}" Margin="16,10,16,0"
                                           TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Notifications}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NotificationItemViewModel">
                                            <StackPanel>
                                                <TextBlock Text="{Binding GroupLabel}" IsVisible="{Binding ShowGroup}"
                                                           FontSize="12" Foreground="{StaticResource SidebarLabel}"
                                                           Margin="16,14,0,4" />
                                                <Button Classes="nav" Click="OnNotificationClicked" Tag="{Binding}">
                                                    <StackPanel Spacing="3">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource SidebarText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="NoWrap" MaxWidth="176" />
                                                            <TextBlock Text="{Binding WorkspaceName}" FontSize="11"
                                                                       Foreground="{StaticResource SidebarLabel}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Preview}" FontSize="11.5"
                                                                   Foreground="{StaticResource SidebarLabel}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="Wrap" MaxLines="2"
                                                                   IsVisible="{Binding Preview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="暂无通知" IsVisible="{Binding ShowNoNotifications}" FontSize="12"
                                           Foreground="{StaticResource SidebarLabel}" Margin="16,10,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- plugins sidebar -->
                    <Grid IsVisible="{Binding IsPluginsPage}" RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" Height="44" ColumnDefinitions="*,Auto" Margin="16,0,10,0">
                            <TextBlock Text="自定义" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="icon" Click="OnToggleSearchClicked" ToolTip.Tip="搜索">
                                <Path Width="15" Height="15" Data="{StaticResource SearchIcon}" Stretch="Uniform" />
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="8,4,8,0">
                            <Button Classes="nav" Classes.active="{Binding IsPluginsList}"
                                    Click="OnPluginsTabClicked">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <Path Width="16" Height="16" Data="{StaticResource PluginIcon}" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Text="插件" FontSize="13" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Classes="nav" Classes.active="{Binding IsSkillsList}"
                                    Click="OnSkillsTabClicked">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <Path Width="16" Height="16" Data="{StaticResource SparkIcon}" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Text="技能" FontSize="13" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="16,18,16,0" Spacing="6">
                            <TextBlock Classes="section-label" Text="已安装" />
                            <TextBlock Text="插件与技能列表在右侧展示" FontSize="11.5"
                                       Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- notification pane menu (Codex-style 显示 menu) -->
                    <Popup x:Name="NotificationMenuPopup" Placement="BottomEdgeAlignedLeft" VerticalOffset="4"
                           IsLightDismissEnabled="True">
                        <Border x:Name="NotificationMenuCard" Width="216" Opacity="0"
                                Background="#202022"
                                BorderBrush="#2E2E31" BorderThickness="1"
                                CornerRadius="12" Padding="6" x:CompileBindings="False"
                                BoxShadow="0 18 44 0 #99000000">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel>
                                <TextBlock Text="显示" FontSize="11.5" Foreground="#7E7F82"
                                           Margin="10,6,0,4" />
                                <Button Classes="more-menu-item" Click="OnNotificationFilterClicked" Tag="priority">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="优先事项部分" FontSize="13"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Width="13" Height="13"
                                              Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                              Stroke="#E3E4E6" StrokeThickness="1.6"
                                              IsVisible="{Binding IsNotificationFilterPriority}"
                                              VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Classes="more-menu-item" Click="OnNotificationFilterClicked" Tag="pinned">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="已置顶" FontSize="13"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Width="13" Height="13"
                                              Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                              Stroke="#E3E4E6" StrokeThickness="1.6"
                                              IsVisible="{Binding IsNotificationFilterPinned}"
                                              VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Classes="more-menu-item" Click="OnNotificationFilterClicked" Tag="automations">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="定时任务" FontSize="13"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Width="13" Height="13"
                                              Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                              Stroke="#E3E4E6" StrokeThickness="1.6"
                                              IsVisible="{Binding IsNotificationFilterAutomations}"
                                              VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Border Height="1" Background="#2E2E31" Margin="10,6" />
                                <Button Classes="more-menu-item" Click="OnMarkAllNotificationsReadClicked">
                                    <TextBlock Text="全部标为已读" FontSize="13"
                                               Foreground="#C6C7C9" VerticalAlignment="Center" />
                                </Button>
                                <Button Classes="more-menu-item" Click="OnArchiveNotificationsClicked">
                                    <TextBlock Text="归档聊天" FontSize="13"
                                               Foreground="#C6C7C9" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- project row menu (Codex-style project details) -->
                    <Popup x:Name="WorkspaceMenuPopup" Placement="RightEdgeAlignedTop"
                           HorizontalOffset="6" VerticalOffset="-9"
                           IsLightDismissEnabled="True">
                        <Border x:Name="WorkspaceMenuCard" Width="322" Opacity="0"
                                Background="#202022"
                                BorderBrush="#2E2E31" BorderThickness="1"
                                CornerRadius="12" Padding="6" x:CompileBindings="False"
                                BoxShadow="0 18 44 0 #99000000">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel>
                                <Grid Height="32" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="4,0">
                                    <Path Width="14" Height="14" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                          Stroke="#C6C7C9" StrokeThickness="1.3" StrokeLineCap="Round"
                                          StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#E3E4E6" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <Button Grid.Column="2" Classes="row-action" Classes.pinned="{Binding IsPinned}"
                                            Click="OnToggleWorkspacePinnedClicked" ToolTip.Tip="置顶">
                                        <Path Width="13" Height="13" Data="{StaticResource PinIcon}" Stretch="Uniform"
                                              StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
                                              RenderTransform="rotate(45deg)" />
                                    </Button>
                                </Grid>
                                <Grid Height="26" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="10,0">
                                    <Path Width="13" Height="13" Data="{StaticResource ChatIcon}" Stretch="Uniform"
                                          Stroke="#7E7F82" StrokeThickness="1.25" StrokeLineCap="Round"
                                          StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ChatCountLabel}" FontSize="12.5"
                                               Foreground="#9EA0A3" VerticalAlignment="Center" />
                                </Grid>
                                <Border Height="1" Background="#2E2E31" Margin="10,6" />
                                <Grid Height="24" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="10,0">
                                    <Path Width="13" Height="13" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                          Stroke="#7E7F82" StrokeThickness="1.25" StrokeLineCap="Round"
                                          StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12"
                                               Foreground="#9EA0A3" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </Grid>
                                <Grid Height="24" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="10,0">
                                    <Path Width="13" Height="13" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                          Stroke="#7E7F82" StrokeThickness="1.25" StrokeLineCap="Round"
                                          StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ParentPath}" FontSize="12"
                                               Foreground="#9EA0A3" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </Grid>
                                <Border Height="1" Background="#2E2E31" Margin="10,6" />
                                <Button Classes="more-menu-item" Height="30" Click="OnWorkspaceEditClicked">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource SettingsIcon}" Stretch="Uniform"
                                              Stroke="#7E7F82" StrokeThickness="1.25" StrokeLineCap="Round"
                                              StrokeJoin="Round" Fill="Transparent" />
                                        <TextBlock Grid.Column="1" Text="编辑项目" FontSize="13"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Classes="more-menu-item" Height="30" Click="OnWorkspaceAgentsClicked">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource CodeIcon}" Stretch="Uniform"
                                              Stroke="#7E7F82" StrokeThickness="1.25" StrokeLineCap="Round"
                                              StrokeJoin="Round" Fill="Transparent" />
                                        <TextBlock Grid.Column="1" Text="项目 AGENTS.md" FontSize="13"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Border Height="1" Background="#2E2E31" Margin="10,6" />
                                <Button Classes="more-menu-item" Height="30" Click="OnArchiveWorkspaceChatsClicked">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource ArchiveIcon}" Stretch="Uniform"
                                              Stroke="#7E7F82" StrokeThickness="1.25" StrokeLineCap="Round"
                                              StrokeJoin="Round" Fill="Transparent" />
                                        <TextBlock Grid.Column="1" Text="归档聊天" FontSize="13"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Classes="more-menu-item" Height="30" Click="OnRemoveWorkspaceClicked">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource TrashIcon}" Stretch="Uniform"
                                              Stroke="#E5837C" StrokeThickness="1.25" StrokeLineCap="Round"
                                              StrokeJoin="Round" Fill="Transparent" />
                                        <TextBlock Grid.Column="1" Text="移除项目" FontSize="13"
                                                   Foreground="#E5837C" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- project section menu (Codex-style) -->
                    <Popup x:Name="PinnedSectionMenuPopup" Placement="BottomEdgeAlignedRight"
                           VerticalOffset="4" IsLightDismissEnabled="True">
                        <Border x:Name="PinnedSectionMenuCard" Width="196" Opacity="0"
                                Background="{StaticResource ProductMenuFill}"
                                BorderBrush="{StaticResource ProductMenuLine}" BorderThickness="1"
                                CornerRadius="12" Padding="6"
                                BoxShadow="0 14 34 0 #99000000">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel Spacing="1">
                                <Button Classes="more-menu-item" Click="OnPinnedSortRecentClicked">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource ClockIcon}" Stretch="Uniform" />
                                        <TextBlock Grid.Column="1" Text="最近更新" VerticalAlignment="Center" />
                                        <Path Grid.Column="2" Width="14" Height="14"
                                              Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                              Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                              IsVisible="{Binding IsPinnedSortByRecent}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Classes="more-menu-item" Click="OnPinnedSortManualClicked">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource ToolIcon}" Stretch="Uniform" />
                                        <TextBlock Grid.Column="1" Text="手动排序" VerticalAlignment="Center" />
                                        <Path Grid.Column="2" Width="14" Height="14"
                                              Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                              Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                              IsVisible="{Binding IsPinnedSortByManual}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- automation sidebar -->
                    <Grid IsVisible="{Binding IsAutomationPage}" RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" Height="44" Margin="16,0,10,0">
                            <TextBlock Text="自动化" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="8,4,8,0">
                            <Button Classes="nav active" Click="OnNavAutomationClicked">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <Path Width="16" Height="16" Data="{StaticResource RailAutomationIcon}"
                                          Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Text="自动化任务" FontSize="13" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="16,18,16,0" Spacing="6">
                            <TextBlock Classes="section-label" Text="已启用" />
                            <TextBlock Text="任务详情在右侧展示" FontSize="11.5"
                                       Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- projects sidebar -->
                    <Grid IsVisible="{Binding IsProjectsPage}" RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" Height="44" Margin="16,0,10,0">
                            <TextBlock Text="项目" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="8,4,8,0">
                            <Button Classes="nav active" Click="OnMoreProjectClicked">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <Path Width="16" Height="16" Data="{StaticResource FolderIcon}" Stretch="Uniform" />
                                    <TextBlock Grid.Column="1" Text="项目" FontSize="13" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="16,18,16,0" Spacing="6">
                            <TextBlock Classes="section-label" Text="本地项目" />
                            <TextBlock Text="选择项目进入对话" FontSize="11.5"
                                       Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- library sidebar -->
                    <Grid IsVisible="{Binding IsLibraryPage}" RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" Height="44" Margin="16,0,10,0">
                            <TextBlock Text="资料库" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,2,8,0">
                            <StackPanel Spacing="1">
                                <ItemsControl ItemsSource="{Binding LibraryItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LibraryItemViewModel">
                                            <Button Classes="session-row" Height="30" Padding="12,0" CornerRadius="8"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    Click="OnLibraryItemClicked" ToolTip.Tip="插入到输入框">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               Foreground="{StaticResource SidebarText}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding CreatedLabel}" FontSize="11"
                                                               Foreground="{StaticResource SidebarLabel}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding LibraryEmptyText}" IsVisible="{Binding !HasLibraryItems}"
                                           FontSize="11.5" Foreground="{StaticResource SidebarLabel}"
                                           Margin="12,8,12,0" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Border>

            <!-- drag handle: resize the sidebar from its edge, and pull a collapsed
                 sidebar back out past 3/4 of its minimum width -->
            <Border x:Name="SidebarResizeHandle" Grid.Column="2" HorizontalAlignment="Left" Width="8" Margin="-1,0,0,0" Background="Transparent"
                    Classes="sidebar-resize" Cursor="SizeWestEast" ZIndex="80"
                    IsVisible="{Binding !IsSettingsOpen}"
                    PointerPressed="OnSidebarResizePressed"
                    PointerMoved="OnSidebarResizeMoved"
                    PointerReleased="OnSidebarResizeReleased">
                <Border Width="1" HorizontalAlignment="Left" Classes="resize-line" />
            </Border>

            <!-- main content -->
            <Grid x:Name="ContentHost" Classes="content-host" Grid.Column="2"
                  Background="{StaticResource ContentFill}" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Height="48" ColumnDefinitions="*,Auto" Margin="0,0,12,0"
                      IsVisible="{Binding !IsChatPage}">
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Button Classes="chip" Height="28" Padding="6,2" Click="OnOpenModelSettingsClicked"
                                ToolTip.Tip="{Binding CoreConnectionLabel}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Width="13" Height="13" Data="{StaticResource SparkIcon}" Stretch="Uniform"
                                      Fill="{StaticResource AccentBlue}" Stroke="{StaticResource AccentBlue}"
                                      StrokeThickness="0.6" />
                                <TextBlock Text="{Binding CoreConnectionLabel}" FontSize="12.5"
                                           Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="icon" Click="OnToggleSidebarClicked" ToolTip.Tip="切换侧边栏">
                            <Path Width="15" Height="15" Data="{StaticResource PanelIcon}" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <!-- ===================== Library page ===================== -->
                    <Grid IsVisible="{Binding IsLibraryPage}" RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Height="50" BorderBrush="{StaticResource Line}"
                                BorderThickness="0,0,0,1" Padding="16,0">
                            <TextBlock Text="资料库" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="736" HorizontalAlignment="Stretch"
                                        Margin="20,18,20,26" Spacing="14">
                                <Border Classes="card">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="新的资料" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBox Classes="field"
                                                 Text="{Binding LibraryDraftTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="标题（可选）" />
                                        <TextBox Classes="field" MinHeight="120" MaxHeight="260"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top"
                                                 Text="{Binding LibraryDraftContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="粘贴常用提示词、规范或说明…" />
                                        <Button Classes="primary" Click="OnSaveLibraryItemClicked"
                                                Content="保存到资料库" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding LibraryItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LibraryItemViewModel">
                                            <Border Classes="card" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                                                      RowSpacing="6" ColumnSpacing="12">
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               FontWeight="Medium"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Preview}" FontSize="11.5"
                                                               Foreground="{StaticResource TextTertiary}"
                                                               TextWrapping="Wrap" MaxLines="3"
                                                               TextTrimming="CharacterEllipsis" LineHeight="18" />
                                                    <StackPanel Grid.Column="1" Grid.RowSpan="2"
                                                                Orientation="Horizontal" Spacing="4"
                                                                VerticalAlignment="Center">
                                                        <Button Classes="subtle" Click="OnInsertLibraryItemClicked"
                                                                Content="插入" />
                                                        <Button Classes="subtle" Click="OnDeleteLibraryItemClicked"
                                                                Content="删除" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding LibraryEmptyText}" IsVisible="{Binding !HasLibraryItems}"
                                           FontSize="12" Foreground="{StaticResource TextTertiary}"
                                           Margin="4,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===================== Chat page ===================== -->
                    <Grid IsVisible="{Binding IsChatPage}" RowDefinitions="Auto,*,Auto" Margin="0,0,3,0">
                        <Border Grid.Row="0" IsVisible="{Binding ShowConversationHeader}" Height="52"
                                BorderBrush="Transparent" BorderThickness="0" Padding="20,0,14,2">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Classes="chat-title" HorizontalAlignment="Left">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <MenuItem Header="重命名当前会话" Click="OnRenameActiveSessionClicked" />
                                            <MenuItem Header="复制为新会话（分支）" Click="OnForkSessionClicked" />
                                            <MenuItem Header="压缩上下文" Click="OnCompactSessionClicked" />
                                            <Separator />
                                            <MenuItem Header="删除当前会话" Click="OnDeleteActiveSessionClicked" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Path Width="14" Height="14" Data="{StaticResource ConversationIcon}" Stretch="Uniform"
                                              Stroke="{StaticResource TextPrimary}" StrokeThickness="1.25"
                                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" />
                                        <TextBlock Text="{Binding HeaderTitle}" FontSize="13.5" FontWeight="Normal"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Path Width="8" Height="8" Data="{StaticResource ChevronDownIcon}" Stretch="Uniform"
                                              Stroke="#C6C7C9" StrokeThickness="1.4"
                                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                              VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UsageText}" IsVisible="{Binding HasUsageText}"
                                               FontSize="11.5" Foreground="{StaticResource TextCaption}"
                                               VerticalAlignment="Center" ToolTip.Tip="本会话累计用量" />
                                    <Button Classes="icon header-action" IsVisible="{Binding HasConversation}"
                                            Click="OnShareConversationClicked" ToolTip.Tip="复制会话">
                                        <Path x:Name="ShareHeaderIcon" Width="14" Height="14"
                                              Data="{StaticResource ShareIcon}" Stretch="Uniform" />
                                    </Button>
                                    <Button Classes="icon header-action" IsVisible="{Binding HasConversation}"
                                            ToolTip.Tip="会话操作">
                                        <Path Width="12" Height="12" Data="{StaticResource QueueIcon}" Stretch="Uniform" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuItem Header="重命名当前会话" Click="OnRenameActiveSessionClicked" />
                                                <MenuItem Header="复制为新会话（分支）" Click="OnForkSessionClicked" />
                                                <MenuItem Header="压缩上下文" Click="OnCompactSessionClicked" />
                                                <MenuItem Header="导出为 Markdown…" Click="OnExportConversationClicked" />
                                                <Separator />
                                                <MenuItem Header="删除当前会话" Click="OnDeleteActiveSessionClicked" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Classes="icon header-action" Click="OnToggleSidebarClicked" ToolTip.Tip="切换侧边栏">
                                        <Path Width="12" Height="12" Data="{StaticResource PanelRightIcon}" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Spacing="0" Margin="0,23,0,0">
                                <Grid Width="48" Height="48" HorizontalAlignment="Center"
                                      IsVisible="{Binding IsWorkMode}">
                                    <Path Width="48" Height="48" Stretch="None"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          Data="{StaticResource CodexCloudIcon}"
                                          Stroke="#4F4F51" StrokeThickness="1.5"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" />
                                    <Path Width="48" Height="48" Stretch="None"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          Data="{StaticResource CodexPromptIcon}"
                                          Stroke="#4F4F51" StrokeThickness="2.2"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Margin="0,24,0,0" IsVisible="{Binding IsChatMode}">
                                    <TextBlock Text="我们要做什么?" FontSize="28" FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            Margin="0,24,0,0" IsVisible="{Binding IsWorkMode}">
                                    <TextBlock Text="我们应该在" FontSize="28" FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="{Binding WorkspaceName}" FontSize="28" FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimary}" Cursor="Hand"
                                               ToolTip.Tip="切换工作区" PointerPressed="OnHomeWorkspaceClicked">
                                        <TextBlock.TextDecorations>
                                            <media:TextDecorationCollection>
                                                <media:TextDecoration Location="Underline" Stroke="#E3E4E6"
                                                                      StrokeThickness="1" StrokeDashArray="1,2.2" />
                                            </media:TextDecorationCollection>
                                        </TextBlock.TextDecorations>
                                    </TextBlock>
                                    <TextBlock Text="中做些什么?" FontSize="28" FontWeight="Medium"
                                               Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding HomeSuggestions}"
                                              IsVisible="{Binding HasHomeSuggestions}"
                                              HorizontalAlignment="Center" MaxWidth="620" Margin="0,26,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LibraryItemViewModel">
                                            <Button Classes="chip" Margin="4" Click="OnInsertLibraryItemClicked"
                                                    ToolTip.Tip="{Binding Preview}">
                                                <TextBlock Text="{Binding Title}" MaxWidth="240"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <ScrollViewer x:Name="TranscriptScroller" IsVisible="{Binding HasConversation}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,12,0,16">
                                <ItemsControl x:Name="TranscriptItems" ItemsSource="{Binding Messages}"
                                              ItemTemplate="{StaticResource ChatItemTemplate}"
                                              MaxWidth="736" HorizontalAlignment="Stretch" />
                            </ScrollViewer>

                            <Button x:Name="JumpToBottomButton" Classes="jump-bottom" IsVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Margin="0,0,0,25" Click="OnJumpToBottomClicked" ToolTip.Tip="跳到底部">
                                <Path Width="13" Height="13" Data="{StaticResource ArrowDownIcon}" Stretch="Uniform"
                                      StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent">
                                    <Path.Stroke>
                                        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                            <GradientStop Offset="0" Color="#8E8F91" />
                                            <GradientStop Offset="1" Color="#E3E4E6" />
                                        </LinearGradientBrush>
                                    </Path.Stroke>
                                </Path>
                            </Button>

                            <Border x:Name="RulerStrip" IsVisible="{Binding HasConversation}"
                                   Width="44" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                   Margin="6,0,0,0" Background="Transparent"
                                   PointerMoved="OnRulerPointerMoved"
                                   PointerExited="OnRulerPointerExited"
                                   PointerPressed="OnRulerPointerPressed">
                                <Canvas x:Name="RulerTicksPanel" Width="6"
                                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                        Margin="10,0,0,0" IsHitTestVisible="False" />
                            </Border>

                            <Border x:Name="RulerPreviewCard" Classes="ruler-preview" IsVisible="False" Width="322" MaxHeight="220"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="45,0,0,0" Background="#202022" CornerRadius="10"
                                    Padding="12,10" BoxShadow="0 12 32 0 #66000000"
                                    BorderBrush="Transparent" BorderThickness="1"
                                    IsHitTestVisible="True" ZIndex="30" Opacity="0"
                                    PointerEntered="OnRulerPreviewPointerEntered"
                                    PointerExited="OnRulerPreviewPointerExited">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                    </Transitions>
                                </Border.Transitions>
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock x:Name="RulerPreviewTitle" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#E3E4E6" TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                        <Button x:Name="RulerPreviewIconButton" Grid.Column="1"
                                                Classes="message-action ruler-preview-icon"
                                                Width="22" Height="22" Padding="0" Cursor="Hand"
                                                VerticalAlignment="Center" Margin="8,0,0,0"
                                                Click="OnRulerPreviewJumpClicked" ToolTip.Tip="标记该轮对话">
                                            <Path Width="14" Height="14" Data="{StaticResource ChatIcon}"
                                                  Stretch="Uniform" Stroke="#7E7F82" StrokeThickness="1.3"
                                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent" />
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="RulerPreviewBody" Grid.Row="1" FontSize="12" LineHeight="21"
                                               Foreground="#A0A1A3" TextWrapping="Wrap"
                                               MaxLines="4" TextTrimming="CharacterEllipsis" />
                                    <StackPanel x:Name="RulerPreviewBulletRow" Grid.Row="2" Orientation="Horizontal"
                                                Spacing="8" Margin="2,0,0,0">
                                        <TextBlock Text="•" FontSize="12" Foreground="#A0A1A3"
                                                   VerticalAlignment="Top" />
                                        <TextBlock x:Name="RulerPreviewBullet" FontSize="12" LineHeight="21"
                                                   Foreground="#A0A1A3" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                            <Grid Grid.Row="2" MaxWidth="{Binding ComposerMaxWidth}" HorizontalAlignment="Stretch"
                              Margin="{Binding ComposerMargin}" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="0">
                            <TextBlock Grid.Row="0" Text="我们要做什么?" FontSize="28" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimary}"
                                       HorizontalAlignment="Center" Margin="0,0,0,21"
                                       IsVisible="{Binding ShowChatComposerChips}" />
                            <Border Grid.Row="0" IsVisible="{Binding ShowWorkspaceStrip}" Height="41"
                                    Margin="12,0,12,0" Background="#1C1C1E" CornerRadius="16,16,0,0" Padding="12,0">
                                <Button Background="Transparent" BorderThickness="0" Padding="0"
                                        Click="OnWorkspacePickerClicked" ToolTip.Tip="{Binding WorkspacePath}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Path Width="16" Height="16" Data="{StaticResource FolderIcon}"
                                              Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                              StrokeThickness="1.35" StrokeLineCap="Round"
                                              StrokeJoin="Round" Fill="Transparent"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding WorkspaceName}" FontSize="14"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Border>

                            <Border Grid.Row="1" IsVisible="{Binding ShowCoreBanner}"
                                    Margin="0,0,0,8"
                                    Background="#2A20221F" BorderBrush="#553B3B2B" BorderThickness="0.5"
                                    CornerRadius="10" Padding="12,9">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Path Width="14" Height="14" Data="{StaticResource WarningIcon}" Stretch="Uniform"
                                          Stroke="#E6C79A" StrokeThickness="1.4"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                          VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding CoreBannerText}" FontSize="12"
                                               Foreground="#E6D2B4" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Classes="secondary" Height="26" Padding="8,3"
                                            Click="OnRetryCoreClicked" Content="{Binding CoreBannerActionText}"
                                            IsEnabled="{Binding CanRetryCore}" />
                                </Grid>
                            </Border>

                            <!-- Codex shows this card right after the user switches to full access. -->
                            <Border Grid.Row="2" IsVisible="{Binding ShowFullAccessWarning}"
                                    Margin="0,0,0,10" BorderBrush="#232325" BorderThickness="1"
                                    CornerRadius="12" Padding="14,12">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                    <Path Width="18" Height="18" Data="{StaticResource AlertIcon}" Stretch="Uniform"
                                          Stroke="#9A9B9D" StrokeThickness="1.4" StrokeLineCap="Round"
                                          StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Top"
                                          Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="完整访问权限已开启" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock FontSize="12.5" LineHeight="19" Foreground="#A0A1A3"
                                                   TextWrapping="Wrap">
                                            <Run Text="KL 可以在未经你批准的情况下编辑任何文件，并通过互联网访问权限运行命令。这会增加数据丢失、信息暴露和意外更改的风险。" /><Run Text="了解更多关于风险升高的信息。" TextDecorations="Underline" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Height="28" Padding="12,0" CornerRadius="14"
                                            Background="#E3E4E6" Foreground="#18181A" FontSize="12"
                                            VerticalAlignment="Center" Click="OnHideFullAccessWarningClicked"
                                            Content="不再显示" />
                                    <Button Grid.Column="3" Classes="icon" Width="26" Height="26"
                                            VerticalAlignment="Center" Click="OnDismissFullAccessWarningClicked">
                                        <Path Width="12" Height="12" Data="{StaticResource CloseIcon}" Stretch="Uniform" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Border x:Name="ComposerCard" Grid.Row="3"
                                    Background="{StaticResource ComposerFill}" CornerRadius="24"
                                    BorderBrush="#2A2B2D" BorderThickness="1"
                                    Padding="5,10,6,7">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <ItemsControl Grid.Row="0" ItemsSource="{Binding PendingAttachments}"
                                                  ItemTemplate="{StaticResource AttachmentChipTemplate}"
                                                  IsVisible="{Binding HasPendingAttachments}" Margin="2,2,2,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <Grid Grid.Row="1">
                                        <TextBox x:Name="HeroComposerBox" Classes="composer"
                                                 IsVisible="{Binding IsEmpty}"
                                                 Text="{Binding Composer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{Binding ComposerPlaceholder}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="45" MaxHeight="180"
                                                 KeyDown="OnComposerKeyDown"
                                                 TextChanged="OnComposerTextChanged" />
                                        <TextBox x:Name="ChatComposerBox" Classes="composer"
                                                 IsVisible="{Binding HasConversation}"
                                                 Text="{Binding Composer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{Binding ComposerPlaceholder}"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="45" MaxHeight="180"
                                                 KeyDown="OnComposerKeyDown"
                                                 TextChanged="OnComposerTextChanged" />
                                    </Grid>

                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="4" Margin="0,6,0,0">
                                        <Button Classes="attach" Click="OnAttachFilesClicked"
                                                ToolTip.Tip="添加文本或代码附件">
                                            <Path Width="14" Height="14" Data="{StaticResource PlusIcon}"
                                                  Stretch="Uniform" />
                                        </Button>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Margin="4,0,0,0">
                                            <Button Classes="permission-chip" ToolTip.Tip="权限模式">
                                                <Button.Flyout>
                                                    <Flyout Placement="TopEdgeAlignedLeft">
                                                        <Border Width="340" Background="#17171A"
                                                                BorderBrush="#2B2B2E" BorderThickness="1"
                                                                CornerRadius="12" Padding="8"
                                                                Cursor="Arrow">
                                                                                                                        <StackPanel Spacing="1">
                                                                <Grid ColumnDefinitions="*,Auto"
                                                                      Margin="8,4,8,6">
                                                                    <TextBlock Text="应如何批准操作？"
                                                                               FontSize="12.5"
                                                                               Foreground="#B0B1B3"
                                                                               VerticalAlignment="Center" />
                                                                    <Button Grid.Column="1" Classes="link"
                                                                            Click="OnPermissionLearnMoreClicked">
                                                                        <TextBlock Text="了解更多" FontSize="12.5"
                                                                                   Foreground="#B0B1B3"
                                                                                   TextDecorations="Underline" />
                                                                    </Button>
                                                                </Grid>
                                                                <Button Classes="permission-row"
                                                                        Classes.selected="{Binding IsPermissionAsk}"
                                                                        Click="OnPermissionAskClicked">
                                                                    <Grid ColumnDefinitions="20,*,Auto"
                                                                          ColumnSpacing="10" Margin="4,2,4,2">
                                                                        <Path Width="18" Height="18"
                                                                              Data="{StaticResource ShieldIcon}"
                                                                              Stretch="Uniform"
                                                                              Stroke="#8E8F91"
                                                                              StrokeThickness="1.4"
                                                                              StrokeLineCap="Round"
                                                                              StrokeJoin="Round"
                                                                              Fill="Transparent"
                                                                              VerticalAlignment="Top"
                                                                              Margin="0,1,0,0" />
                                                                        <StackPanel Grid.Column="1"
                                                                                    Spacing="2">
                                                                            <TextBlock Text="请求批准"
                                                                                       FontSize="13.5"
                                                                                       Foreground="#E3E4E6" />
                                                                            <TextBlock
                                                                                Text="编辑外部文件和使用互联网时始终询问"
                                                                                FontSize="11.5"
                                                                                Foreground="#8E8F91"
                                                                                TextWrapping="Wrap"
                                                                                LineHeight="16" />
                                                                        </StackPanel>
                                                                        <Path Grid.Column="2"
                                                                              Width="14" Height="14"
                                                                              Data="{StaticResource CheckIcon}"
                                                                              Stretch="Uniform"
                                                                              Stroke="#E25507"
                                                                              StrokeThickness="1.7"
                                                                              StrokeLineCap="Round"
                                                                              StrokeJoin="Round"
                                                                              Fill="Transparent"
                                                                              IsVisible="{Binding IsPermissionAsk}"
                                                                              VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>
                                                                <Button Classes="permission-row"
                                                                        Classes.selected="{Binding IsPermissionAuto}"
                                                                        Click="OnPermissionAutoClicked">
                                                                    <Grid ColumnDefinitions="20,*,Auto"
                                                                          ColumnSpacing="10" Margin="4,2,4,2">
                                                                        <Path Width="18" Height="18"
                                                                              Data="{StaticResource ClockIcon}"
                                                                              Stretch="Uniform"
                                                                              Stroke="#8E8F91"
                                                                              StrokeThickness="1.4"
                                                                              StrokeLineCap="Round"
                                                                              StrokeJoin="Round"
                                                                              Fill="Transparent"
                                                                              VerticalAlignment="Top"
                                                                              Margin="0,1,0,0" />
                                                                        <StackPanel Grid.Column="1"
                                                                                    Spacing="2">
                                                                            <TextBlock Text="帮我批准"
                                                                                       FontSize="13.5"
                                                                                       Foreground="#E3E4E6" />
                                                                            <TextBlock
                                                                                Text="仅对检测到的风险操作请求批准"
                                                                                FontSize="11.5"
                                                                                Foreground="#8E8F91"
                                                                                TextWrapping="Wrap"
                                                                                LineHeight="16" />
                                                                        </StackPanel>
                                                                        <Path Grid.Column="2"
                                                                              Width="14" Height="14"
                                                                              Data="{StaticResource CheckIcon}"
                                                                              Stretch="Uniform"
                                                                              Stroke="#E25507"
                                                                              StrokeThickness="1.7"
                                                                              StrokeLineCap="Round"
                                                                              StrokeJoin="Round"
                                                                              Fill="Transparent"
                                                                              IsVisible="{Binding IsPermissionAuto}"
                                                                              VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>
                                                                <Button Classes="permission-row"
                                                                        Classes.selected="{Binding IsPermissionFull}"
                                                                        Click="OnPermissionFullClicked">
                                                                    <Grid ColumnDefinitions="20,*,Auto"
                                                                          ColumnSpacing="10" Margin="4,2,4,2">
                                                                        <Path Width="18" Height="18"
                                                                              Data="{StaticResource AlertIcon}"
                                                                              Stretch="Uniform"
                                                                              Stroke="#8E8F91"
                                                                              StrokeThickness="1.4"
                                                                              StrokeLineCap="Round"
                                                                              StrokeJoin="Round"
                                                                              Fill="Transparent"
                                                                              VerticalAlignment="Top"
                                                                              Margin="0,1,0,0" />
                                                                        <StackPanel Grid.Column="1"
                                                                                    Spacing="2">
                                                                            <TextBlock Text="完全访问"
                                                                                       FontSize="13.5"
                                                                                       Foreground="#E3E4E6" />
                                                                            <TextBlock
                                                                                Text="可不受限制地访问互联网和你电脑上的任何文件"
                                                                                FontSize="11.5"
                                                                                Foreground="#8E8F91"
                                                                                TextWrapping="Wrap"
                                                                                LineHeight="16" />
                                                                        </StackPanel>
                                                                        <Path Grid.Column="2"
                                                                              Width="14" Height="14"
                                                                              Data="{StaticResource CheckIcon}"
                                                                              Stretch="Uniform"
                                                                              Stroke="#E25507"
                                                                              StrokeThickness="1.7"
                                                                              StrokeLineCap="Round"
                                                                              StrokeJoin="Round"
                                                                              Fill="Transparent"
                                                                              IsVisible="{Binding IsPermissionFull}"
                                                                              VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Path Width="13" Height="13" Data="{StaticResource AlertIcon}"
                                                          Stretch="Uniform" Stroke="#E25507"
                                                          StrokeThickness="1.5" StrokeLineCap="Round"
                                                          StrokeJoin="Round" Fill="Transparent"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding PermissionMode}" FontSize="12.5"
                                                               Foreground="#E25507"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="chip" ToolTip.Tip="模型与推理强度">
                                            <Button.Flyout>
                                                <Flyout Placement="TopEdgeAlignedLeft"
                                                        Opened="OnReasoningFlyoutOpened">
                                                    <Border Width="260" Background="#1C1C1E"
                                                            BorderBrush="#2B2B2E" BorderThickness="1"
                                                            CornerRadius="16" Padding="16,14"
                                                            Cursor="Arrow">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock Text="{Binding ReasoningEffortDisplayLabel}"
                                                                       FontSize="14" FontWeight="SemiBold"
                                                                       Classes="effort-accent"
                                                                       Classes.high="{Binding IsReasoningHighDisplay}"
                                                                       HorizontalAlignment="Center" />
                                                            <Button Classes="link"
                                                                    Click="OnOpenModelSettingsClicked"
                                                                    HorizontalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal"
                                                                            Spacing="4">
                                                                    <TextBlock Text="{Binding ProviderModelLabel}"
                                                                               FontSize="13"
                                                                               Foreground="#A0A1A3"
                                                                               VerticalAlignment="Center" />
                                                                    <Path Width="9" Height="9"
                                                                          Data="{StaticResource ChevronRightIcon}"
                                                                          Stretch="Uniform"
                                                                          Stroke="#8E8F91"
                                                                          StrokeThickness="1.6"
                                                                          StrokeLineCap="Round"
                                                                          StrokeJoin="Round"
                                                                          Fill="Transparent"
                                                                          VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Grid x:Name="ReasoningTrack" Height="28"
                                                                  Cursor="Hand"
                                                                  Background="Transparent"
                                                                  ClipToBounds="False"
                                                                  PointerPressed="OnReasoningTrackPressed"
                                                                  PointerMoved="OnReasoningTrackMoved"
                                                                  PointerReleased="OnReasoningTrackReleased"
                                                                  SizeChanged="OnReasoningTrackSizeChanged">
                                                                <Border CornerRadius="14"
                                                                        VerticalAlignment="Center"
                                                                        Height="28"
                                                                        Background="#2E2E32" />
                                                                <Border x:Name="ReasoningFillClip" Width="0"
                                                                        Height="28" CornerRadius="14"
                                                                        ClipToBounds="True"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center">
                                                                    <Border x:Name="ReasoningFill" Height="28"
                                                                            CornerRadius="14"
                                                                            HorizontalAlignment="Left">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush
                                                                                StartPoint="0%,50%"
                                                                                EndPoint="100%,50%">
                                                                                <GradientStop Color="#5B4BC4"
                                                                                              Offset="0" />
                                                                                <GradientStop Color="#A78BFA"
                                                                                              Offset="1" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                    </Border>
                                                                </Border>
                                                                <Canvas x:Name="ReasoningTicks"
                                                                        IsHitTestVisible="False"
                                                                        Height="8"
                                                                        VerticalAlignment="Center">
                                                                    <Ellipse x:Name="ReasoningTick0" Width="4"
                                                                             Height="4" Fill="#8CFFFFFF" />
                                                                    <Ellipse x:Name="ReasoningTick1" Width="4"
                                                                             Height="4" Fill="#8CFFFFFF" />
                                                                    <Ellipse x:Name="ReasoningTick2" Width="4"
                                                                             Height="4" Fill="#8CFFFFFF" />
                                                                    <Ellipse x:Name="ReasoningTick3" Width="4"
                                                                             Height="4" Fill="#8CFFFFFF" />
                                                                </Canvas>
                                                                <Border x:Name="ReasoningThumb" Width="34"
                                                                        Height="34" CornerRadius="17"
                                                                        Background="#FFFFFF"
                                                                        IsHitTestVisible="False"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        BoxShadow="0 4 14 0 #66000000" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding ProviderModelLabel}" FontSize="14"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ReasoningEffortDisplayLabel}"
                                                           FontSize="14"
                                                           Classes="effort-accent"
                                                           Classes.high="{Binding IsReasoningHighDisplay}"
                                                           IsVisible="{Binding HasReasoningEffortDisplay}"
                                                           VerticalAlignment="Center" />
                                                <Path Width="10" Height="10" Data="{StaticResource ChevronDownIcon}"
                                                      Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                                      StrokeThickness="1.4" StrokeLineCap="Round"
                                                      StrokeJoin="Round" Fill="Transparent"
                                                      VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Classes="icon" Width="28" Height="28"
                                                ToolTip.Tip="语音输入（即将支持）">
                                            <Path Width="16" Height="16" Data="{StaticResource MicIcon}"
                                                  Stretch="Uniform" />
                                        </Button>
                                        <Button Grid.Column="4" Classes="stop" IsVisible="{Binding IsBusy}"
                                                Click="OnCancelClicked" ToolTip.Tip="停止生成">
                                            <Path Width="12" Height="12" Data="{StaticResource StopIcon}"
                                                  Stretch="Uniform" />
                                        </Button>
                                        <Button Grid.Column="4" Classes="send" IsVisible="{Binding !IsBusy}"
                                                Click="OnSendClicked" IsEnabled="{Binding CanSend}"
                                                ToolTip.Tip="发送 Ctrl+Enter">
                                            <Path Width="13" Height="13" Data="{StaticResource SendIcon}"
                                                  Stretch="Uniform" />
                                        </Button>
                                        <Button Grid.Column="5" Classes="send" IsVisible="{Binding CanQueueSend}"
                                                Click="OnSendClicked" ToolTip.Tip="排队发送；当前回复完成后自动发送">
                                            <Path Width="13" Height="13" Data="{StaticResource QueueIcon}"
                                                  Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="4" Background="#1C1C1E" CornerRadius="14"
                                    Padding="10,7" Margin="13,0,13,0"
                                    IsVisible="{Binding ShowChatComposerChips}">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Classes="composer-chip" Click="OnWorkspacePickerClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Width="14" Height="14" Data="{StaticResource FolderIcon}"
                                                  Stretch="Uniform" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding WorkspaceName}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="composer-chip" Click="OnNavPluginsClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Width="14" Height="14" Data="{StaticResource RailPluginIcon}"
                                                  Stretch="Uniform" VerticalAlignment="Center" />
                                            <TextBlock Text="插件" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- "/" commands and "@" file mentions, anchored above the composer -->
                            <Popup x:Name="ComposerMenuPopup"
                                   Placement="TopEdgeAlignedLeft" HorizontalOffset="0" VerticalOffset="-8"
                                   IsLightDismissEnabled="False" ShouldUseOverlayLayer="True">
                                <Border x:Name="ComposerMenuCard" Width="430" MaxHeight="330" Opacity="0"
                                        Background="#17171A" BorderBrush="#2B2B2E" BorderThickness="1"
                                        CornerRadius="12" Padding="6" BoxShadow="0 18 44 0 #99000000">
                                    <Border.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
                                        </Transitions>
                                    </Border.Transitions>
                                    <Grid RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock x:Name="ComposerMenuHeader" FontSize="11"
                                                   Foreground="#727275" Margin="8,4,8,6" />
                                        <ScrollViewer Grid.Row="1" MaxHeight="248"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="ComposerMenuItems" Spacing="1" />
                                        </ScrollViewer>
                                        <TextBlock Grid.Row="2" Text="↑↓ 选择 · Enter 确认 · Esc 关闭"
                                                   FontSize="10.5" Foreground="#5E5E61" Margin="8,8,8,4" />
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>

                    <!-- ===================== Plugins page ===================== -->
                    <ScrollViewer IsVisible="{Binding IsPluginsList}" VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="960" HorizontalAlignment="Stretch" Margin="40,28,40,40"
                              RowDefinitions="Auto,Auto,Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="page-title" Text="插件" />
                                    <TextBlock Classes="page-subtitle"
                                               Text="连接本地插件，让 kl 在你的工具中协同工作" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Border Classes="search-field" Width="260">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                            <Path Width="13" Height="13" Data="{StaticResource SearchIcon}"
                                                  Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                                  StrokeThickness="1.35" StrokeLineCap="Round"
                                                  StrokeJoin="Round" Fill="Transparent"
                                                  VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Classes="search"
                                                     Text="{Binding PluginSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="搜索插件" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Button Classes="icon" Width="32" Height="32"
                                            Click="OnRefreshPluginsClicked" ToolTip.Tip="刷新插件">
                                        <Path Width="15" Height="15" Data="{StaticResource RefreshIcon}"
                                              Stretch="Uniform" />
                                    </Button>
                                    <Button Classes="primary" Click="OnImportPluginClicked" Content="导入" />
                                    <Button Classes="subtle" Click="OnOpenPluginDirectoryClicked" Content="打开目录" />
                                </StackPanel>
                            </Grid>

                            <SelectableTextBlock Grid.Row="1" Text="{Binding PluginDirectoryPath}" FontSize="11"
                                                 Foreground="{StaticResource TextCaption}"
                                                 TextTrimming="CharacterEllipsis" Margin="0,14,0,18" />

                            <StackPanel Grid.Row="2" Spacing="3" Margin="0,0,0,12">
                                <TextBlock Text="本地插件" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="{Binding PluginStatus}" FontSize="11.5"
                                           Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Spacing="0">
                                <Border IsVisible="{Binding ShowNoPlugins}" Padding="0,60,0,0">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                                        <Path Width="36" Height="36" Data="{StaticResource PluginIcon}"
                                              Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                              StrokeThickness="1.1" StrokeLineCap="Round" StrokeJoin="Round"
                                              Fill="Transparent" HorizontalAlignment="Center" />
                                        <TextBlock Text="暂无本地插件" FontSize="15"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="在插件目录下创建子目录并放入 plugin.json" FontSize="12.5"
                                                   Foreground="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Center" />
                                        <Button Classes="secondary" Click="OnOpenPluginDirectoryClicked"
                                                Content="打开插件目录" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Plugins}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PluginItemViewModel">
                                            <Border Background="{StaticResource CardFill}" CornerRadius="16"
                                                    Padding="16,14" Margin="0,0,0,10">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <Border Width="32" Height="32" CornerRadius="8"
                                                            Background="#1E1E22" VerticalAlignment="Center">
                                                        <Path Width="16" Height="16" Data="{StaticResource PluginIcon}"
                                                              Stretch="Uniform" Stroke="{StaticResource TextSecondary}"
                                                              StrokeThickness="1.3" StrokeLineCap="Round"
                                                              StrokeJoin="Round" Fill="Transparent"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}" />
                                                            <TextBlock Text="{Binding Version}" FontSize="11"
                                                                       Foreground="{StaticResource TextCaption}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="12.5"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   VerticalAlignment="Center" />
                                                        <ToggleSwitch Classes="setting"
                                                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                                                      IsEnabled="{Binding CanToggle}"
                                                                      IsCheckedChanged="OnPluginToggled"
                                                                      ToolTip.Tip="{Binding StatusText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="没有匹配的插件" IsVisible="{Binding ShowNoPluginMatches}"
                                           FontSize="12.5" Foreground="{StaticResource TextTertiary}"
                                           Margin="2,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- ===================== Skills page ===================== -->
                    <ScrollViewer IsVisible="{Binding IsSkillsList}" VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="960" HorizontalAlignment="Stretch" Margin="40,28,40,40"
                              RowDefinitions="Auto,Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="page-title" Text="技能" />
                                    <TextBlock Classes="page-subtitle"
                                               Text="当前工作区的技能由 KL Core 发现" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="icon" Width="32" Height="32"
                                        Click="OnRefreshSkillsClicked" ToolTip.Tip="刷新技能"
                                        VerticalAlignment="Center">
                                    <Path Width="15" Height="15" Data="{StaticResource RefreshIcon}"
                                          Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <StackPanel Grid.Row="1" Spacing="3" Margin="0,16,0,12">
                                <TextBlock Text="已发现" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="{Binding SkillsStatusText}" FontSize="11.5"
                                           Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Spacing="0">
                                <Border IsVisible="{Binding !ShowSkills}" Padding="0,60,0,0">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                                        <Path Width="36" Height="36" Data="{StaticResource SparkIcon}"
                                              Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                              StrokeThickness="1.1" StrokeLineCap="Round"
                                              StrokeJoin="Round" Fill="Transparent"
                                              HorizontalAlignment="Center" />
                                        <TextBlock Text="当前工作区没有技能" FontSize="15"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="把技能放到工作区或 KL Home 的技能目录后刷新"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Skills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SkillRow">
                                            <Border Background="{StaticResource CardFill}" CornerRadius="16"
                                                    Padding="16,14" Margin="0,0,0,10">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <Border Width="32" Height="32" CornerRadius="8"
                                                            Background="#1E1E22" VerticalAlignment="Center">
                                                        <Path Width="16" Height="16"
                                                              Data="{StaticResource SparkIcon}"
                                                              Stretch="Uniform"
                                                              Stroke="{StaticResource TextSecondary}"
                                                              StrokeThickness="1.2" StrokeLineCap="Round"
                                                              StrokeJoin="Round" Fill="Transparent"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="12.5"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- ===================== Projects page ===================== -->
                    <ScrollViewer IsVisible="{Binding IsProjectsPage}" VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="960" HorizontalAlignment="Stretch" Margin="40,28,40,40"
                              RowDefinitions="Auto,Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="page-title" Text="项目" />
                                    <TextBlock Classes="page-subtitle" Text="选择项目进入对话，或添加新的本地项目" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primary" Click="OnAddWorkspaceClicked"
                                        Content="添加项目" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Grid.Row="1" Classes="section-label" Text="本地项目"
                                       Margin="0,18,0,8" />

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Workspaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkspaceItemViewModel">
                                        <Button Classes="row" Height="56" Padding="12,8" Margin="0,0,0,8"
                                                Click="OnWorkspaceClicked">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Width="32" Height="32" Background="#1E1E22"
                                                        CornerRadius="8" VerticalAlignment="Center">
                                                    <Path Width="16" Height="16"
                                                          Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                                          Stroke="{StaticResource TextSecondary}"
                                                          StrokeThickness="1.35" StrokeLineCap="Round"
                                                          StrokeJoin="Round" Fill="Transparent"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                               Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Text="{Binding Path}" FontSize="11"
                                                               Foreground="{StaticResource TextTertiary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="打开" FontSize="12"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- ===================== Automation page ===================== -->
                    <ScrollViewer IsVisible="{Binding IsAutomationPage}" VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="960" HorizontalAlignment="Stretch" Margin="40,28,40,40"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="page-title" Text="自动化任务" />
                                    <TextBlock Classes="page-subtitle"
                                               Text="按间隔让 KL Core 自动执行任务并保存结果" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primary" Click="OnNewAutomationClicked"
                                        Content="新建" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,18,0,16">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="filter" Classes.active="{Binding IsAutomationFilterAll}"
                                            Click="OnAutomationFilterAllClicked" Content="全部" />
                                    <Button Classes="filter" Classes.active="{Binding IsAutomationFilterActive}"
                                            Click="OnAutomationFilterActiveClicked" Content="已开启" />
                                    <Button Classes="filter" Classes.active="{Binding IsAutomationFilterEnded}"
                                            Click="OnAutomationFilterEndedClicked" Content="已结束" />
                                </StackPanel>
                                <Border Grid.Column="2" Classes="search-field" Width="320">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                        <Path Width="13" Height="13" Data="{StaticResource SearchIcon}"
                                              Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                              StrokeThickness="1.35" StrokeLineCap="Round" StrokeJoin="Round"
                                              Fill="Transparent" VerticalAlignment="Center" />
                                        <TextBox x:Name="AutomationSearchBox" Grid.Column="1" Classes="search"
                                                 Text="{Binding AutomationSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="搜索自动化任务" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Row="3" IsVisible="{Binding ShowNoAutomations}" Padding="0,50,0,0">
                                <StackPanel Spacing="12" HorizontalAlignment="Center">
                                    <Path Width="36" Height="36" Data="{StaticResource ClockIcon}"
                                          Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                          StrokeThickness="1.1" StrokeLineCap="Round" StrokeJoin="Round"
                                          Fill="Transparent" HorizontalAlignment="Center" />
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding AutomationEmptyTitle}" FontSize="15"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding AutomationEmptyDescription}" FontSize="12.5"
                                                   Foreground="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <Button Classes="secondary" Click="OnNewAutomationClicked"
                                            Content="新建自动化任务" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <ItemsControl Grid.Row="4" ItemsSource="{Binding Automations}"
                                          IsVisible="{Binding HasAutomations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AutomationItemViewModel">
                                        <Border IsVisible="{Binding IsVisible}"
                                                Background="{StaticResource CardFill}" CornerRadius="12"
                                                Padding="16,12" Margin="0,0,0,10">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                    <Path Width="18" Height="18" Data="{StaticResource ClockIcon}"
                                                          Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                                          StrokeThickness="1.15" StrokeLineCap="Round"
                                                          StrokeJoin="Round" Fill="Transparent"
                                                          VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="{Binding Name}" FontSize="14"
                                                                   FontWeight="Medium"
                                                                   Foreground="{StaticResource TextPrimary}" />
                                                        <TextBlock Text="{Binding Prompt}" FontSize="12"
                                                                   Foreground="{StaticResource TextTertiary}"
                                                                   TextWrapping="Wrap" MaxHeight="40" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="{StaticResource ActiveFill}"
                                                            CornerRadius="999" Padding="9,3"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding StateLabel}" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondary}" />
                                                    </Border>
                                                </Grid>

                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="16"
                                                      Margin="30,0,0,0">
                                                    <TextBlock Text="{Binding IntervalLabel}" FontSize="10"
                                                               Foreground="{StaticResource TextCaption}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding NextRunLabel}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextCaption}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding LastRunLabel}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextCaption}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding StatusLabel}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextCaption}" />
                                                </Grid>

                                                <Border IsVisible="{Binding HasLastResult}"
                                                        Background="{StaticResource ToolCardFill}"
                                                        CornerRadius="8" Padding="12,9" Margin="30,0,0,0">
                                                    <ScrollViewer MaxHeight="96"
                                                                  VerticalScrollBarVisibility="Auto">
                                                        <SelectableTextBlock Text="{Binding LastResult}"
                                                                             FontSize="11" LineHeight="18"
                                                                             Foreground="{StaticResource TextTertiary}"
                                                                             TextWrapping="Wrap" />
                                                    </ScrollViewer>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                            Spacing="8">
                                                    <Button Classes="secondary" Click="OnRunAutomationClicked"
                                                            IsEnabled="{Binding CanRun}"
                                                            Content="{Binding RunButtonLabel}" />
                                                    <Button Classes="secondary" Click="OnToggleAutomationClicked"
                                                            IsEnabled="{Binding CanEdit}"
                                                            Content="{Binding ToggleLabel}" />
                                                    <Button Classes="secondary" Click="OnEditAutomationClicked"
                                                            IsEnabled="{Binding CanEdit}" Content="编辑" />
                                                    <Button Classes="secondary" Click="OnDeleteAutomationClicked"
                                                            IsEnabled="{Binding CanEdit}" Content="删除" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- error banner -->
                    <Border IsVisible="{Binding HasError}" VerticalAlignment="Top"
                            HorizontalAlignment="Center" MaxWidth="720" Margin="20,12,20,0"
                            Background="#2A20221F" BorderBrush="#553B3B2B" BorderThickness="0.5"
                            CornerRadius="10" Padding="12,9" ZIndex="20">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Path Width="14" Height="14" Data="{StaticResource WarningIcon}" Stretch="Uniform"
                                  Stroke="#E6A0A0" StrokeThickness="1.3"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="12"
                                       Foreground="#E6B4B4" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="icon" Width="24" Height="24"
                                    Click="OnDismissErrorClicked" ToolTip.Tip="关闭">
                                <TextBlock Text="×" FontSize="16" Foreground="{StaticResource TextTertiary}" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== Settings overlay ===================== -->
        <Grid x:Name="SettingsHost" Classes="settings-host" Grid.Row="1"
              IsVisible="{Binding IsSettingsOpen}" Margin="52,0,0,0"
              Background="#0F0F11" ZIndex="40">
            <Grid ColumnDefinitions="Auto,*">
                <Border x:Name="SettingsNavPanelBorder" Width="238" Background="#0F0F10"
                        BorderBrush="#1D1D1F" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,Auto,*" Margin="8,11,8,16">
                        <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="8,0" />
                        <Border Grid.Row="1" Height="36" Background="#1D1D1F"
                                CornerRadius="18" Margin="0,16,0,18" Padding="10,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Path Width="13" Height="13" Data="{StaticResource SearchIcon}"
                                      Stretch="Uniform" Stroke="{StaticResource TextTertiary}"
                                      StrokeThickness="1.35" StrokeLineCap="Round" StrokeJoin="Round"
                                      Fill="Transparent" VerticalAlignment="Center" />
                                <TextBox x:Name="SettingsSearchBox" Grid.Column="1" Classes="search"
                                         FontSize="13.5" Padding="0,2,0,0"
                                         TextChanged="OnSettingsSearchChanged"
                                         PlaceholderText="搜索" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                                                                                                                                                                                                                                                <ScrollViewer x:Name="SettingsNavScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      AllowAutoHide="False" Margin="0,0,-7,0"
                                      HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="SettingsNavPanel" Spacing="1" Margin="0,0,7,0" HorizontalAlignment="Left">
                        <TextBlock Classes="section-label" Text="个人" FontSize="14" FontWeight="Medium" Margin="8,0,0,10" />
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsGeneral}" Click="OnSettingsNavClicked" Tag="General">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource SettingsIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="常规" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsNotifications}" Click="OnSettingsNavClicked" Tag="Notifications">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource BellIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="通知" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsImport}" Click="OnSettingsNavClicked" Tag="Import">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource DownloadIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="导入" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsAppearance}" Click="OnSettingsNavClicked" Tag="Appearance">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource SunIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="外观" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsArchived}" Click="OnSettingsNavClicked" Tag="Archived">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource ArchiveIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="已归档的聊天" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsVoice}" Click="OnSettingsNavClicked" Tag="Voice">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource MicIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="语音" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsStorage}" Click="OnSettingsNavClicked" Tag="Storage">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource FolderIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="存储" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsConfig}" Click="OnSettingsNavClicked" Tag="Config">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource PowerIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="配置" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsModels}" Click="OnSettingsNavClicked" Tag="Models">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource GaugeIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="模型与连接" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsPersonalization}" Click="OnSettingsNavClicked" Tag="Personalization">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource SmileyIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="个性化" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsMemory}" Click="OnSettingsNavClicked" Tag="Memory">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource SmileyIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="记忆" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsShortcuts}" Click="OnSettingsNavClicked" Tag="Shortcuts">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource KeyboardIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="键盘快捷键" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsProviders}" Click="OnSettingsNavClicked" Tag="Providers">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource ProvidersIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="模型提供商" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsUsage}" Click="OnSettingsNavClicked" Tag="Usage">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource GaugeIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="使用情况和计费" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <TextBlock Classes="section-label" Text="集成" FontSize="14" FontWeight="Medium" Margin="8,18,0,8" />
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsPlugins}" Click="OnSettingsNavClicked" Tag="Plugins">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource PluginIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="插件" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsPasswords}" Click="OnSettingsNavClicked" Tag="Passwords">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource RingIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="密码" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsComputerUse}" Click="OnSettingsNavClicked" Tag="ComputerUse">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource ToolIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="电脑操控" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsBrowser}" Click="OnSettingsNavClicked" Tag="Browser">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource PanelIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="浏览器" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsCloudPc}" Click="OnSettingsNavClicked" Tag="CloudPc">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource MaximizeIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="云电脑" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <TextBlock Classes="section-label" Text="编码" FontSize="14" FontWeight="Medium" Margin="8,18,0,8" />
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsHooks}" Click="OnSettingsNavClicked" Tag="Hooks">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource CodeIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="钩子" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsConnections}" Click="OnSettingsNavClicked" Tag="Connections">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource ToolIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="连接" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsCodeReview}" Click="OnSettingsNavClicked" Tag="CodeReview">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource CodeReviewIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="代码审查" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsGit}" Click="OnSettingsNavClicked" Tag="Git">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource SortIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="Git" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsEnvironments}" Click="OnSettingsNavClicked" Tag="Environments">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource FolderIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="环境" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        <Button Classes="nav settings-nav" Classes.active="{Binding IsSettingsWorktrees}" Click="OnSettingsNavClicked" Tag="Worktrees">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Path Width="14" Height="14" Data="{StaticResource PanelIcon}" Stretch="Uniform" />
                        <TextBlock Grid.Column="1" Text="Worktrees" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                        </Button>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Visible" AllowAutoHide="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="1,0,14,40" Margin="0,0,7,0"
                                  PointerPressed="OnSettingsScrollerPointerPressed">
                      <StackPanel x:Name="SettingsColumn" MaxWidth="726"
                                  HorizontalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,26,0,42">
                        <TextBlock Text="{Binding SettingsPaneTitle}" FontSize="28" FontWeight="Medium" LetterSpacing="-0.3"
                                   Foreground="{StaticResource TextPrimary}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="0,22,0,-22"
                                    IsVisible="{Binding IsSettingsPlugins}">
                        <Button Classes="secondary settings-button" Height="32" Click="OnOpenPluginDirectoryClicked" Content="浏览目录" />
                        <Button Classes="secondary settings-button" Height="32" Click="OnImportPluginClicked"><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="添加" /><Path Width="10" Height="10" Data="{StaticResource ChevronDownIcon}" Stretch="Uniform" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" /></StackPanel></Button>
                        </StackPanel>
                        </Grid>



                        <TextBlock Text="{Binding SettingsPaneSubtitle}"
                                   IsVisible="{Binding HasSettingsPaneSubtitle}"
                                   FontSize="12.5" Foreground="{StaticResource TextCaption}"
                                   Margin="0,-44,0,54" TextWrapping="Wrap" MaxWidth="680"
                                   HorizontalAlignment="Left" />
                        <Grid x:Name="SettingsPanesPanel">
                            <StackPanel IsVisible="{Binding IsSettingsGeneral}" Spacing="50">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="权限" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="默认权限" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650"><Run Text="默认情况下，"/><Run Text="KL" Foreground="#E3E4E6"/><Run Text=" 可以读取和编辑其工作空间中的文件。需要时，它可以请求额外访问权限。"/></TextBlock>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="完整访问权限" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="600"><Run Text="当 "/><Run Text="KL" Foreground="#E3E4E6"/><Run Text=" 以完整访问权限运行时，它无需你的批准即可编辑你电脑上的任何文件，并运行可访问网络的命令。这会显著增加数据丢失、泄露或意外行为的风险。了解更多关于风险升高的信息。"/></TextBlock>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding SettingsFullAccess, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="常规" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="项目外聊天文件夹" />
                            <TextBlock Classes="settings-desc" Text="在项目外发起的聊天，其数据的默认存储位置。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding KlHomeDirectory}" FontSize="11.5" Foreground="{StaticResource TextCaption}" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Classes="secondary settings-button" Content="打开" Click="OnOpenKlHomeClicked" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="默认文件打开位置" />
                            <TextBlock Classes="settings-desc" Text="默认打开文件和文件夹的位置" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="VS Code" />
                            <ComboBoxItem Content="系统默认" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="集成终端 Shell" />
                            <TextBlock Classes="settings-desc" Text="选择要在集成终端中打开的 Shell。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="PowerShell" />
                            <ComboBoxItem Content="命令提示符" />
                            <ComboBoxItem Content="Git Bash" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="语言" />
                            <TextBlock Classes="settings-desc" Text="应用界面语言" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="简体中文" />
                            <ComboBoxItem Content="English" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="关闭窗口前确认" />
                            <TextBlock Classes="settings-desc" Text="使用关闭标签页的快捷键会导致窗口关闭时，显示警告" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding CloseWindowActionIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="仅在使用“关闭”快捷键时" />
                            <ComboBoxItem Content="始终" />
                            <ComboBoxItem Content="从不" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="默认使用完整视图" />
                            <TextBlock Classes="settings-desc" Text="在新聊天中以完整视图打开内容标签页" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="False" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="登录时启动" />
                            <TextBlock Classes="settings-desc" Text="登录 Windows 后自动打开 KL" HorizontalAlignment="Left" MaxWidth="650" />
                            <TextBlock Text="{Binding LaunchAtLoginStatus}" IsVisible="{Binding HasLaunchAtLoginStatus}"
                                       FontSize="11.5" Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="底部面板" />
                            <TextBlock Classes="settings-desc" Text="在应用标题栏中显示底部面板控件" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="默认终端位置" />
                            <TextBlock Classes="settings-desc" Text="选择终端快捷键和环境操作在何处打开终端标签页" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Button Classes="segment" Classes.active="True" Content="底部" Click="OnSettingsPlaceholderClicked" />
                            <Button Classes="segment" Content="右侧" Click="OnSettingsPlaceholderClicked" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="自动归档不活跃的聊天" />
                            <TextBlock Classes="settings-desc" Text="将一段时间未活动的本地聊天归档" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding AutoArchiveIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="永不" />
                            <ComboBoxItem Content="7 天" />
                            <ComboBoxItem Content="30 天" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="压缩本地保存的聊天历史记录" />
                            <TextBlock Classes="settings-desc" Text="压缩较早的本地聊天历史记录，以节省磁盘空间。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="可用推理强度" />
                            <TextBlock Classes="settings-desc" Text="选择在模型控件中显示哪些推理强度级别。可用性因模型而异。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="管理" VerticalAlignment="Center" Click="OnOpenModelsSettingsClicked" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="打开源许可证" />
                            <TextBlock Classes="settings-desc" Text="捆绑依赖项的第三方声明" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="查看" VerticalAlignment="Center" Click="OnSettingsPlaceholderClicked" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="插件" />
                            <TextBlock Classes="settings-desc" Text="允许 KL 使用已安装的插件" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="编辑器" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="纯文本编辑器" />
                            <TextBlock Classes="settings-desc" Text="编写消息时，将代码、Markdown 和链接保留为纯文本" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="False" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="显示上下文窗口使用情况" />
                            <TextBlock Classes="settings-desc" Text="在会话标题栏显示本会话的 token 用量" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding ShowContextUsage, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="发送快捷键" />
                            <TextBlock Classes="settings-desc" Text="选择按 Enter 时是发送提示词还是换行" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding SendShortcutIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="按 Enter 键" />
                            <ComboBoxItem Content="Ctrl+Enter" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="后续消息处理方式" />
                            <TextBlock Classes="settings-desc" Text="在 KL 运行时将后续消息加入队列，或引导当前运行。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Button Classes="segment" Classes.active="{Binding IsFollowUpQueue}" Content="排队" Tag="queue" Click="OnFollowUpModeClicked" />
                            <Button Classes="segment" Classes.active="{Binding IsFollowUpSteer}" Content="引导" Tag="steer"
                                    Click="OnFollowUpModeClicked" IsEnabled="False" ToolTip.Tip="KL Core 暂不支持在回合运行中引导" />
                            </StackPanel>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="弹出窗口" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="弹出窗口快捷键" />
                            <TextBlock Classes="settings-desc" Text="为弹出窗口设置全局快捷键。不设置则保持关闭。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="关闭" VerticalAlignment="Center" Click="OnSettingsPlaceholderClicked" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="默认使用独立聊天" />
                            <TextBlock Classes="settings-desc" Text="在任何项目外开始新聊天" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="False" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="通知" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="轮次完成通知" />
                            <TextBlock Classes="settings-desc" Text="设置 KL 完成后何时提醒你" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding TurnNotificationIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="仅在未聚焦时" />
                            <ComboBoxItem Content="始终" />
                            <ComboBoxItem Content="从不" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="启用权限通知" />
                            <TextBlock Classes="settings-desc" Text="当对话需要你批准时显示提醒" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding ApprovalNotifications, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="启用问题通知" />
                            <TextBlock Classes="settings-desc" Text="当对话中有人提问时显示提醒" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding QuestionNotifications, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="启用 Dot 通知" />
                            <TextBlock Classes="settings-desc" Text="当 dot 向你发送消息或需要你提供意见时显示提醒" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="通知提示音" />
                            <TextBlock Classes="settings-desc" Text="任务完成、请求权限和提问时的提示音" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="{Binding NotificationSoundIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="默认" />
                            <ComboBoxItem Content="关闭" />
                            </ComboBox>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="趣味实验" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="彩纸礼炮" />
                            <TextBlock Classes="settings-desc" Text="按你的要求，在应用内展示彩纸特效！" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="False" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsNotifications}" Spacing="50">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="KL" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="Codex" />
                            <TextBlock Classes="settings-desc" Text="接收有关 Codex 任务的通知。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="推送" />
                            <ComboBoxItem Content="推送、电子邮件" />
                            <ComboBoxItem Content="关闭" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="个性化提示" />
                            <TextBlock Classes="settings-desc" Text="根据你与 KL 的对话获取实用推荐。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="推送、电子邮件" />
                            <ComboBoxItem Content="推送" />
                            <ComboBoxItem Content="关闭" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="任务" />
                            <TextBlock Classes="settings-desc" Text="当你创建的任务有更新时收到通知。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="subtle" Content="管理任务" Click="OnOpenAutomationFromSettingsClicked" />
                            <ComboBox Classes="settings-select" SelectedIndex="0"><ComboBoxItem Content="推送" /><ComboBoxItem Content="关闭" /></ComboBox>
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="使用情况" />
