                            <TextBlock Classes="settings-title" Text="对比度" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider x:Name="ContrastSlider" Width="140" Minimum="0" Maximum="100" Value="50" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                            <TextBlock Classes="settings-value" Text="{Binding #ContrastSlider.Value, StringFormat={}{0:0}}" Width="26" TextAlignment="Right" TextWrapping="NoWrap" VerticalAlignment="Center" />
                            </StackPanel>
                            </Grid>
                            </StackPanel>
                            </Border>
                            <Border Classes="settings-card">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,10,16,9">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="差异标记" />
                            <TextBlock Classes="settings-desc" Text="使用颜色或 +/- 标记显示更改" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="filter" Classes.active="True" Content="颜色" Click="OnSettingsPlaceholderClicked" />
                            <Button Classes="filter" Content="+/-" Click="OnSettingsPlaceholderClicked" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,10,16,9">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="使用指针光标" />
                            <TextBlock Classes="settings-desc" Text="悬停交互元素时切换为指针光标" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="{Binding UsePointerCursor, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>
                            </StackPanel>




                            <StackPanel IsVisible="{Binding IsSettingsVoice}" Spacing="50">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="常规" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="麦克风" />
                            <TextBlock Classes="settings-desc" Text="用于语音聊天和听写" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="通信 - CABLE Output (VB-Audio Virtual Cable) (默认)" />
                            <ComboBoxItem Content="系统默认" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="语言" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="自动检测" />
                            <ComboBoxItem Content="中文" />
                            <ComboBoxItem Content="English" />
                            </ComboBox>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="听写" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="始终显示实时转写文本" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="False" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="听写快捷键" />
                            <TextBlock Classes="settings-desc" Text="按住即可进行听写，或连续两次启用免提模式" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Classes="settings-value" Text="关闭" VerticalAlignment="Center" /><Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" /></StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,5,16,5">
                            <Button Classes="subtle" Click="OnVoiceAdvancedClicked" Padding="6,2" Margin="-6,0,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="高级" FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <Path x:Name="VoiceAdvancedChevronRight" Width="11" Height="11" Data="{StaticResource ChevronRightIcon}" Stretch="Uniform" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                            <Path x:Name="VoiceAdvancedChevronDown" Width="11" Height="11" Data="{StaticResource ChevronDownIcon}" Stretch="Uniform" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" IsVisible="False" />
                            </StackPanel>
                            </Button>
                            </Grid>
                            <StackPanel x:Name="VoiceAdvancedPanel" IsVisible="False">
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="单击快捷键" />
                            <TextBlock Classes="settings-desc" Text="按一次开始，再按一次结束" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Classes="settings-value" Text="关闭" VerticalAlignment="Center" /><Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" /></StackPanel>
                            </Grid>
                            </StackPanel>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="Lower other app audio" />
                            <TextBlock Classes="settings-desc" Text="Lower the volume of other apps while dictating" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="最近录音" />
                            <TextBlock Classes="settings-desc" Text="你最近的 20 段录音会保存在此设备上" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="settings-value" Text="" MaxWidth="420" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="听写词典" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11"><TextBlock Classes="settings-desc" Text="听写应能识别的单词或短语" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="secondary settings-button" Content="＋ 添加条目" Click="OnSettingsPlaceholderClicked" /></Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="16,0,16,13"><TextBox Classes="settings-input" Text="示例词条" Foreground="{StaticResource TextSecondary}" /><Button Grid.Column="1" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" Click="OnSettingsPlaceholderClicked"><Path Width="13" Height="13" Data="{StaticResource TrashIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" /></Button></Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsStorage}" Spacing="50">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="此设备" />
                            <TextBlock Classes="settings-desc" Text="管理存储在此电脑上的聊天和工作树" HorizontalAlignment="Left" Margin="0,6,0,0" MaxWidth="620" />
                            <StackPanel Spacing="0" Margin="0,12,0,-14">
                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding StorageTotalLabel}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" /><Button Grid.Column="1" Classes="secondary settings-button" Height="26" Content="刷新" Click="OnRefreshStorageClicked" /></Grid>
                            <Border Height="18" CornerRadius="9" ClipToBounds="True" Margin="0,12,0,0">
                            <Grid x:Name="StorageBar" ColumnDefinitions="1*,1*,1*,1*" IsVisible="{Binding HasStorageUsage}"><Border Background="#E3C63B" /><Border Grid.Column="1" Background="#4CD07D" /><Border Grid.Column="2" Background="#4C9FE8" /><Border Grid.Column="3" Background="#6B6B70" /></Grid>
                            </Border>
                            <Grid ColumnDefinitions="*,*,*,*" Margin="0,12,0,0">
                            <StackPanel Spacing="4"><StackPanel Orientation="Horizontal" Spacing="7"><Border Width="9" Height="9" CornerRadius="5" Background="#E3C63B" VerticalAlignment="Center" /><TextBlock Text="聊天存储空间" FontSize="12.5" Foreground="{StaticResource TextSecondary}" /></StackPanel><TextBlock Text="{Binding StorageChatSizeLabel}" FontSize="11.5" Foreground="{StaticResource TextCaption}" Margin="0,-3,0,0" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4"><StackPanel Orientation="Horizontal" Spacing="7"><Border Width="9" Height="9" CornerRadius="5" Background="#4CD07D" VerticalAlignment="Center" /><TextBlock Text="附件" FontSize="12.5" Foreground="{StaticResource TextSecondary}" /></StackPanel><TextBlock Text="{Binding StorageAttachmentSizeLabel}" FontSize="11.5" Foreground="{StaticResource TextCaption}" Margin="0,-3,0,0" /></StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4"><StackPanel Orientation="Horizontal" Spacing="7"><Border Width="9" Height="9" CornerRadius="5" Background="#4C9FE8" VerticalAlignment="Center" /><TextBlock Text="插件" FontSize="12.5" Foreground="{StaticResource TextSecondary}" /></StackPanel><TextBlock Text="{Binding StoragePluginSizeLabel}" FontSize="11.5" Foreground="{StaticResource TextCaption}" Margin="0,-3,0,0" /></StackPanel>
                            <StackPanel Grid.Column="3" Spacing="4"><StackPanel Orientation="Horizontal" Spacing="7"><Border Width="9" Height="9" CornerRadius="5" Background="#6B6B70" VerticalAlignment="Center" /><TextBlock Text="其他" FontSize="12.5" Foreground="{StaticResource TextSecondary}" /></StackPanel><TextBlock Text="{Binding StorageOtherSizeLabel}" FontSize="11.5" Foreground="{StaticResource TextCaption}" Margin="0,-3,0,0" /></StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,14,0,0"><Path Width="9" Height="9" Data="{StaticResource ChevronRightIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" /><TextBlock Text="聊天存储占用明细" FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" /></StackPanel>
                            </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="各文件夹的存储用量" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11"><StackPanel Spacing="3"><TextBlock Classes="settings-title" Text="应用数据文件夹" /><SelectableTextBlock Text="{Binding StateDirectory}" FontSize="11.5" Foreground="{StaticResource TextCaption}" HorizontalAlignment="Left" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="{Binding StorageStatusText}" FontSize="11.5" Foreground="{StaticResource TextCaption}" /><Button Classes="secondary settings-button" Click="OnOpenStateDirectoryClicked" Content="浏览" /></StackPanel></Grid>
                            <Border Classes="settings-divider" />
                            <ItemsControl ItemsSource="{Binding StorageFolders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StorageFolderViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Margin="16,7,16,7">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11"><StackPanel Spacing="3"><TextBlock Classes="settings-title" Text="清理旧聊天" /><TextBlock Classes="settings-desc" Text="永久删除前，请先查看聊天及其子智能体" /></StackPanel><Button Grid.Column="1" Classes="secondary settings-button" Content="查看" Click="OnOpenCleanupClicked" /></Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11"><StackPanel Spacing="3"><TextBlock Classes="settings-title" Text="管理工作树" /><TextBlock Classes="settings-desc" Text="查看工作副本，并选择要保留的旧工作树数量" /></StackPanel><Button Grid.Column="1" Classes="secondary settings-button" Content="管理" Click="OnOpenWorktreesSettingsClicked" /></Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11"><StackPanel Spacing="3"><TextBlock Classes="settings-title" Text="已归档的聊天" /><TextBlock Classes="settings-desc" Text="恢复或删除单个已归档的聊天" /></StackPanel><Button Grid.Column="1" Classes="secondary settings-button" Click="OnSettingsNavClicked" Tag="Archived" Content="管理" /></Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsConfig}" Spacing="50">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="智能体默认设置" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,17,0,24">
                            <ComboBox Width="68" MinWidth="0" MinHeight="26" Padding="8,2,8,2" Classes="settings-select flat-select" HorizontalAlignment="Left" SelectedIndex="0"><ComboBoxItem Content="{Binding ActiveWorkspace.Name}" /></ComboBox>
                            <Button Grid.Column="1" Classes="subtle" Click="OnOpenCoreConfigClicked" Content="打开 config.toml ↗" />
                            </Grid>
                            <Border Classes="settings-card" Margin="0,0,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="批准策略" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650"><Run Text="选择 "/><Run Text="KL" Foreground="#E3E4E6"/><Run Text=" 何时请求批准"/></TextBlock>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center"
                                      SelectedIndex="{Binding ApprovalModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="请求批准" />
                            <ComboBoxItem Content="帮我批准" />
                            <ComboBoxItem Content="完全访问" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="沙盒设置" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650"><Run Text="选择 "/><Run Text="KL" Foreground="#E3E4E6"/><Run Text=" 运行命令时的权限范围"/></TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="settings-value" VerticalAlignment="Center"
                                       Text="{Binding CoreSandboxText}" ToolTip.Tip="由 KL Core 的 config.toml 决定" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="允许网络访问" />
                            <TextBlock Classes="settings-desc" Text="当沙盒设为工作空间写入时允许网络访问" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="网页搜索" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650"><Run Text="选择 "/><Run Text="KL" Foreground="#E3E4E6"/><Run Text=" 访问网络的方式"/></TextBlock>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="缓存" />
                            <ComboBoxItem Content="实时" />
                            <ComboBoxItem Content="关闭" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="输出详细程度" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650"><Run Text="选择 "/><Run Text="KL" Foreground="#E3E4E6"/><Run Text=" 回复包含细节的详细程度"/></TextBlock>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="模型默认" />
                            <ComboBoxItem Content="简洁" />
                            <ComboBoxItem Content="详细" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="推理摘要" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650"><Run Text="选择 "/><Run Text="KL" Foreground="#E3E4E6"/><Run Text=" 总结其推理的方式"/></TextBlock>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="自动" />
                            <ComboBoxItem Content="关闭" />
                            <ComboBoxItem Content="详细" />
                            </ComboBox>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="工作空间依赖项" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="KL 依赖项" />
                            <TextBlock Classes="settings-desc" Text="允许 KL 安装并携带附带的 Node.js 和 Python 工具" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="诊断工作空间中的问题" />
                            <TextBlock Classes="settings-desc" Text="检查当前捆绑包并记录诊断日志" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="诊断" VerticalAlignment="Center" Click="OnRunDoctorClicked" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="重置并安装工作空间" />
                            <TextBlock Classes="settings-desc" Text="下载新的软件包并安装，然后重新加载工具" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="danger" Content="重新安装" Click="OnSettingsPlaceholderClicked" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="当前版本" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="settings-value" Text="{Binding CoreVersionText}" MaxWidth="420" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Classes="settings-heading" Text="KL Core 配置" />
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="刷新" Click="OnRefreshConfigClicked" />
                            </Grid>
                            <TextBlock Text="{Binding ConfigStatusText}" Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="Auto,*" Margin="16,12,16,11" ColumnSpacing="16">
                            <TextBlock Classes="settings-title" Text="配置文件" />
                            <TextBlock Grid.Column="1" Text="{Binding ConfigPathText}" Classes="settings-value"
                                       TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <ItemsControl ItemsSource="{Binding ConfigRows}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConfigValueRow">
                            <Grid ColumnDefinitions="Auto,*" Margin="16,8" ColumnSpacing="16">
                            <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" Foreground="{StaticResource TextCaption}"
                                       TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="点击刷新，从 KL Core 读取配置。" IsVisible="{Binding !ShowConfigRows}"
                                       FontSize="12.5" Foreground="{StaticResource TextCaption}" Margin="16,10,16,14" />
                            <StackPanel IsVisible="{Binding HasDoctorSummary}" Margin="16,4,16,14" Spacing="4">
                            <TextBlock Text="{Binding DoctorSummary}" FontSize="12.5"
                                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding DoctorChecks}" IsVisible="{Binding HasDoctorChecks}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11.5"
                                       Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" />
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsModels}" Spacing="50">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="模型" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="默认模型" />
                            <TextBlock Classes="settings-desc" Text="新聊天使用的 Provider 和模型，由 KL Core 执行。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox Width="250" Classes="settings-select" ItemsSource="{Binding SettingsModelChoices}"
                                      SelectedItem="{Binding SettingsSelectedModel, Mode=TwoWay}" />
                            <Button Classes="secondary settings-button" Content="保存" Click="OnSaveModelClicked" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="推理强度" />
                            <TextBlock Classes="settings-desc" Text="KL Core 默认使用的推理强度；模型控件仍可临时覆盖。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center"
                                      SelectedIndex="{Binding ReasoningEffortIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="默认" />
                            <ComboBoxItem Content="低" />
                            <ComboBoxItem Content="中" />
                            <ComboBoxItem Content="高" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="API Key" />
                            <TextBlock Text="{Binding CoreKeyStatusText}" Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox Width="220" Classes="settings-input" PasswordChar="•"
                                     Text="{Binding SettingsApiKeyDraft, Mode=TwoWay}"
                                     PlaceholderText="输入新的 API Key" />
                            <Button Classes="secondary settings-button" Content="保存 Key" Click="OnSaveApiKeyClicked" />
                            </StackPanel>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="连接状态" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="KL Core" />
                            <TextBlock Classes="settings-desc" Text="{Binding CoreStatusText}" HorizontalAlignment="Left" MaxWidth="650" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SettingsStatus}" IsVisible="{Binding HasSettingsStatus}"
                                       FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource TextCaption}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" VerticalAlignment="Center"
                                    Content="{Binding TestConnectionButtonText}" IsEnabled="{Binding CanTestConnection}"
                                    Click="OnTestConnectionClicked" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="版本" />
                            <TextBlock Classes="settings-desc" Text="{Binding CoreVersionText}" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="诊断" Click="OnRunDoctorClicked" />
                            </Grid>
                            <StackPanel IsVisible="{Binding HasDoctorSummary}" Margin="16,2,16,12" Spacing="4">
                            <TextBlock Text="{Binding DoctorSummary}" FontSize="12.5"
                                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding DoctorChecks}" IsVisible="{Binding HasDoctorChecks}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11.5"
                                       Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" />
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="配置文件" />
                            <TextBlock Classes="settings-desc" Text="{Binding ConfigFilePath}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="打开 config.toml" Click="OnOpenCoreConfigClicked" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsPersonalization}" Spacing="50">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="KL 记忆" />
                            <TextBlock Classes="settings-desc" Text="配置 KL 如何管理记忆" Margin="0,6,0,0" HorizontalAlignment="Left" MaxWidth="650" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="启用记忆" />
                            <TextBlock Classes="settings-desc" Text="让 KL 根据你的聊天、文件和已连接的应用为你提供个性化体验。记忆可能包含你提供的敏感信息。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="记忆摘要" />
                            <TextBlock Classes="settings-desc" Text="查看 KL 对你的了解概览。对于希望它始终记住的信息，可以使用自定义指令。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="管理" VerticalAlignment="Center" Click="OnOpenMemorySettingsClicked" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <StackPanel Margin="16,0,16,12"><TextBlock Classes="settings-desc" Text="KL 可能会使用记忆功能，对发送给搜索服务的查询进行个性化处理。" /></StackPanel>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="settings-heading" Text="KL 记忆（本机）" />
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="本地主机" />
                            <ComboBoxItem Content="云端" />
                            </ComboBox>
                            </Grid>
                            <TextBlock Classes="settings-desc" Text="配置 KL 在本机管理记忆的方式" Margin="0,6,0,0" HorizontalAlignment="Left" MaxWidth="650" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="启用 KL 记忆功能" />
                            <TextBlock Classes="settings-desc" Text="根据本机上的聊天创建记忆，并使用这些记忆为此后的本地聊天提供个性化体验" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="允许从使用工具的聊天中生成记忆" />
                            <TextBlock Classes="settings-desc" Text="从使用过 MCP 工具或网页搜索的聊天生成记忆" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="删除 KL 记忆" />
                            <TextBlock Classes="settings-desc" Text="删除本机上的全部 KL 记忆" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="danger" Content="删除" Click="OnDeleteAllMemoriesClicked" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="写作" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="参考我的写作风格" />
                            <TextBlock Classes="settings-desc" Text="让 KL 参考你的聊天记录、资料库中的文件和已连接的应用，按你的风格写作" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="False" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="参考照片" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="参考照片" />
                            <TextBlock Classes="settings-desc" Text="创建自己的图像时，KL 会以这张照片作为参考。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <TextBlock Classes="settings-value" Text="添加" VerticalAlignment="Center" /><Path Classes="row-chevron" Width="10" Height="10" Data="{StaticResource ChevronRightIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="全身参考照片" />
                            <TextBlock Classes="settings-desc" Text="用于展示你穿戴服装和配饰的效果" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <TextBlock Classes="settings-value" Text="添加" VerticalAlignment="Center" /><Path Classes="row-chevron" Width="10" Height="10" Data="{StaticResource ChevronRightIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                            </StackPanel>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="基础风格和语气" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="基础风格和语气" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="默认" />
                            <ComboBoxItem Content="亲切" />
                            <ComboBoxItem Content="专业" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="亲切程度" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="默认" />
                            <ComboBoxItem Content="低" />
                            <ComboBoxItem Content="高" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="热情程度" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="默认" />
                            <ComboBoxItem Content="低" />
                            <ComboBoxItem Content="高" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="表情符号" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="默认" />
                            <ComboBoxItem Content="少用" />
                            <ComboBoxItem Content="多用" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="可视化回答" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="默认" />
                            <ComboBoxItem Content="关闭" />
                            <ComboBoxItem Content="开启" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="标题和列表" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="默认" />
                            <ComboBoxItem Content="简洁" />
                            <ComboBoxItem Content="详细" />
                            </ComboBox>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="自定义指令" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="ChatGPT" />
                            <TextBlock Classes="settings-desc" Text="为 KL 提供适用于所有聊天的额外指令和背景信息。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Path Classes="row-chevron" Width="10" Height="10" Data="{StaticResource ChevronRightIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="Codex" />
                            <TextBlock Classes="settings-desc" Text="适用于桌面端和网页端的 Codex Cloud 聊天" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Path Classes="row-chevron" Width="10" Height="10" Data="{StaticResource ChevronRightIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="AGENTS.md" />
                            <TextBlock Classes="settings-desc" Text="编辑所选机器上的 AGENTS.md 文件。代码仓库的说明也可能适用。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnEditAgentsClicked" ToolTip.Tip="编辑 AGENTS.md">
                            <Path Classes="row-chevron" Width="10" Height="10" Data="{StaticResource ChevronRightIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                            </Button>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="其他设置" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="快速回答" />
                            <TextBlock Classes="settings-desc" Text="KL 有时可以利用其通用知识，快速提供深入的回答。这些回答并非个性化回答，也不会使用你的记忆。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="提示词建议" />
                            <TextBlock Classes="settings-desc" Text="KL 可根据搜索已连接的插件生成建议" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="参考录音历史记录" />
                            <TextBlock Classes="settings-desc" Text="允许 KL 在回复时参考之前的所有录音转写和笔记。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="False" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="网页搜索" />
                            <TextBlock Classes="settings-desc" Text="让 KL 自动搜索网页以查找答案" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="KL 语音" />
                            <TextBlock Classes="settings-desc" Text="在 KL 中启用语音" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="搜索资料库" />
                            <TextBlock Classes="settings-desc" Text="允许 KL 自动搜索资料库中的文件以查找答案" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>


                            <StackPanel IsVisible="{Binding IsSettingsMemory}" Spacing="50">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Classes="settings-heading" Text="记忆条目" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="segment" Classes.active="{Binding IsMemoryScopeUser}" Click="OnMemoryScopeUserClicked" Content="用户" />
                            <Button Classes="segment" Classes.active="{Binding IsMemoryScopeWorkspace}" Click="OnMemoryScopeWorkspaceClicked" Content="工作区" />
                            </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding MemoryScopeHint}" Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11" ColumnSpacing="10">
                            <TextBlock Text="{Binding MemoryStatus}" Classes="settings-desc" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary settings-button" Content="刷新" Click="OnRefreshMemoryClicked" />
                            <Button Classes="secondary settings-button" Content="新建" Click="OnNewMemoryClicked" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <ItemsControl ItemsSource="{Binding MemoryEntries}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MemoryEntryRow">
                            <Button Classes="more-menu-item" Height="36" Click="OnMemoryEntryClicked" Tag="{Binding Name}">
                            <Grid ColumnDefinitions="*,Auto" Margin="6,0" ColumnSpacing="12">
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" FontSize="11.5" Foreground="{StaticResource TextCaption}" VerticalAlignment="Center" />
                            </Grid>
                            </Button>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="还没有记忆条目" IsVisible="{Binding !ShowMemoryEntries}"
                                       FontSize="12.5" Foreground="{StaticResource TextCaption}" Margin="16,10,16,14" />
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="编辑条目" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel Spacing="10" Margin="16,12,16,11">
                            <TextBox Classes="settings-input" Text="{Binding MemoryName, Mode=TwoWay}" PlaceholderText="条目名称" />
                            <TextBox Classes="settings-input" Text="{Binding MemoryContent, Mode=TwoWay}"
                                     AcceptsReturn="True" Height="170" TextWrapping="Wrap"
                                     PlaceholderText="记忆内容" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Classes="danger" Content="删除条目" Click="OnDeleteMemoryClicked" />
                            <Button Classes="primary" Content="保存" Click="OnSaveMemoryClicked" IsEnabled="{Binding CanSaveMemory}" />
                            </StackPanel>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsShortcuts}" Spacing="50">
                            <Border Classes="search-field" Margin="0,6,0,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Path Width="13" Height="13" Data="{StaticResource SearchIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.35" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Classes="search" PlaceholderText="搜索快捷键" />
                            </Grid>
                            </Border>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="数字快捷键" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11"><StackPanel Spacing="3"><TextBlock Classes="settings-title" Text="数字快捷键" /><TextBlock Classes="settings-desc" Text="使用 Ctrl+1-9 切换页面，使用 Alt+1-9 切换聊天" /></StackPanel><ComboBox Grid.Column="1" Classes="settings-select" SelectedIndex="{Binding NumberShortcutsIndex, Mode=TwoWay}"><ComboBoxItem Content="Ctrl+1-9 切换页面" /><ComboBoxItem Content="关闭" /></ComboBox></Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="快捷键列表" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,16,11" ColumnSpacing="12">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="新聊天" />
                            <TextBlock Classes="settings-desc" Text="开始新聊天" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="Ctrl+N" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="Ctrl+Shift+O" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            <Button Grid.Column="3" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource TrashIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,16,11" ColumnSpacing="12">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="新建临时聊天" />
                            <TextBlock Classes="settings-desc" Text="开始聊天，此聊天不会显示在历史记录中" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="Ctrl+Shift+N" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            <Button Grid.Column="3" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource TrashIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,16,11" ColumnSpacing="12">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="归档聊天" />
                            <TextBlock Classes="settings-desc" Text="归档当前聊天" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="Ctrl+Shift+A" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            <Button Grid.Column="3" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource TrashIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,16,11" ColumnSpacing="12">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="新建独立聊天" />
                            <TextBlock Classes="settings-desc" Text="在项目外开始新聊天" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="Ctrl+Alt+O" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
