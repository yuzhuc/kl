                            </Button>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,16,11" ColumnSpacing="12">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="复制最后一个代码块" />
                            <TextBlock Classes="settings-desc" Text="复制当前聊天中助手提供的最后一个代码块" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="Ctrl+Shift+;" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            <Button Grid.Column="3" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource TrashIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,16,11" ColumnSpacing="12">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="删除聊天" />
                            <TextBlock Classes="settings-desc" Text="确认是否要删除当前聊天" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="未分配" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            <Button Grid.Column="3" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource TrashIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,16,11" ColumnSpacing="12">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="标记为未读" />
                            <TextBlock Classes="settings-desc" Text="将当前聊天标记为未读" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="Ctrl+Shift+U" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            <Button Grid.Column="3" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource TrashIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,16,11" ColumnSpacing="12">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="在新窗口中打开" />
                            <TextBlock Classes="settings-desc" Text="在新窗口中打开当前聊天" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="未分配" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            <Button Grid.Column="3" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource TrashIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,16,11" ColumnSpacing="12">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="切换置顶状态" />
                            <TextBlock Classes="settings-desc" Text="置顶或取消置顶当前聊天" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="Ctrl+Alt+P" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            <Button Grid.Column="3" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource TrashIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,16,11" ColumnSpacing="12">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="发送消息" />
                            <TextBlock Classes="settings-desc" Text="把输入框内容发送给 KL" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="Ctrl+Enter" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            <Button Grid.Column="3" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource TrashIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,16,11" ColumnSpacing="12">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="搜索会话" />
                            <TextBlock Classes="settings-desc" Text="在侧边栏中搜索聊天" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="Ctrl+F" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            <Button Grid.Column="3" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource TrashIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,16,11" ColumnSpacing="12">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="打开设置" />
                            <TextBlock Classes="settings-desc" Text="打开或关闭设置页面" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="Ctrl+," FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            <Button Grid.Column="3" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource TrashIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,12,16,11" ColumnSpacing="12">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="关闭菜单 / 拒绝批准" />
                            <TextBlock Classes="settings-desc" Text="关闭浮层或拒绝一次工具批准" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#2A2A2D" CornerRadius="6" Padding="7,2"><TextBlock Text="Esc" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource EditIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            <Button Grid.Column="3" Classes="subtle" Width="26" Height="26" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSettingsPlaceholderClicked">
                            <Path Width="13" Height="13" Data="{StaticResource TrashIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Button>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsProviders}" Spacing="50">
                            <StackPanel Spacing="0">
                            <StackPanel Spacing="0" IsVisible="{Binding IsProviderListOpen}">
                            <TextBlock Classes="settings-heading" Text="模型提供商" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="提供商连接" />
                            <TextBlock Text="{Binding ProviderSummaryText}" Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="620" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="secondary settings-button" Content="刷新" Click="OnRefreshProvidersClicked" />
                            <Button Classes="secondary settings-button" Content="添加提供商" Click="OnAddProviderClicked" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Border IsVisible="{Binding IsProviderFormOpen}" Background="#1B1B1E" BorderBrush="#34343A" BorderThickness="1" CornerRadius="10" Margin="16,12,16,6" Padding="14">
                            <StackPanel Spacing="11">
                            <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                            <TextBlock Text="接入新的模型提供商" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="选择预设后填写 API Key 与模型；保存写入 Core 配置，重新连接后生效。" FontSize="11.5" Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="subtle" Content="取消" Click="OnCancelProviderClicked" VerticalAlignment="Top" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel Spacing="4">
                            <TextBlock Text="提供商预设" Classes="settings-desc" />
                            <ComboBox Classes="settings-select" HorizontalAlignment="Stretch" ItemsSource="{Binding ProviderPresets}" SelectedItem="{Binding SelectedProviderPreset, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProviderPreset">
                            <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                            </ComboBox.ItemTemplate>
                            </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="接口协议" Classes="settings-desc" />
                            <ComboBox Classes="settings-select" HorizontalAlignment="Stretch" SelectedIndex="{Binding ProviderProtocolIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="OpenAI Chat" />
                            <ComboBoxItem Content="Anthropic" />
                            <ComboBoxItem Content="OpenAI Responses" />
                            </ComboBox>
                            </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel Spacing="4">
                            <TextBlock Text="提供商 ID" Classes="settings-desc" />
                            <TextBox Classes="settings-input" Text="{Binding ProviderDraftId, Mode=TwoWay}" PlaceholderText="deepseek" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="模型 ID" Classes="settings-desc" />
                            <TextBox Classes="settings-input" Text="{Binding ProviderDraftModel, Mode=TwoWay}" PlaceholderText="deepseek-chat" />
                            </StackPanel>
                            </Grid>
                            <StackPanel Spacing="4">
                            <TextBlock Text="Base URL" Classes="settings-desc" />
                            <TextBox Classes="settings-input" Text="{Binding ProviderDraftBaseUrl, Mode=TwoWay}" PlaceholderText="https://api.deepseek.com" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="4">
                            <TextBlock Text="API Key（可选）" Classes="settings-desc" />
                            <TextBox Classes="settings-input" PasswordChar="•" Text="{Binding ProviderDraftApiKey, Mode=TwoWay}" PlaceholderText="只保存在本机凭据目录" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="primary" Content="接入提供商" Click="OnSaveProviderClicked" VerticalAlignment="Bottom" />
                            </Grid>
                            <TextBlock Text="{Binding ProviderFormStatus}" IsVisible="{Binding HasProviderFormStatus}" FontSize="11.5" Foreground="#E36B6B" TextWrapping="Wrap" />
                            </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding ProviderStatusText}" IsVisible="{Binding HasProviderStatus}" FontSize="11.5" Foreground="{StaticResource TextCaption}" Margin="16,0,16,10" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding ProviderCards}" IsVisible="{Binding HasProviderCards}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProviderCardRow">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18" Margin="16,11,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" FontSize="11.5" Foreground="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" MaxWidth="520" HorizontalAlignment="Left" />
                            <Button Classes="link" IsVisible="{Binding HasWebsite}" Tag="{Binding Website}" Click="OnOpenProviderWebsiteClicked" HorizontalAlignment="Left" Padding="0">
                            <TextBlock Text="{Binding Website}" FontSize="11.5" Foreground="#7EA7E8" TextDecorations="Underline" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                            </Button>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="编辑" Click="OnEditProviderClicked" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="2" Classes="setting" IsChecked="{Binding Enabled, Mode=TwoWay}" Click="OnProviderEnabledChanged" VerticalAlignment="Center" ToolTip.Tip="启用或停用此提供商" />
                            </Grid>
                            <Border Classes="settings-divider" Margin="16,0,16,0" />
                            </StackPanel>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel IsVisible="{Binding ShowNoProviderCards}" Margin="16,6,16,14" Spacing="7">
                            <TextBlock Text="尚未接入模型提供商" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="先配置 DeepSeek、OpenCode 或任意 OpenAI 兼容网关，保存后会自动出现在这里。" FontSize="11.5" Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="#232326" CornerRadius="6" Padding="8,3"><TextBlock Text="DeepSeek" FontSize="11" Foreground="{StaticResource TextSecondary}" /></Border>
                            <Border Background="#232326" CornerRadius="6" Padding="8,3"><TextBlock Text="OpenCode" FontSize="11" Foreground="{StaticResource TextSecondary}" /></Border>
                            <Border Background="#232326" CornerRadius="6" Padding="8,3"><TextBlock Text="OpenAI" FontSize="11" Foreground="{StaticResource TextSecondary}" /></Border>
                            <Border Background="#232326" CornerRadius="6" Padding="8,3"><TextBlock Text="Anthropic" FontSize="11" Foreground="{StaticResource TextSecondary}" /></Border>
                            </StackPanel>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,4,16,12">
                            <TextBlock Text="提供商与密钥由 KL Core 管理，密钥不会显示在这里。" FontSize="11.5" Foreground="{StaticResource TextCaption}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="subtle" Content="打开 config.toml" Click="OnOpenCoreConfigClicked" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>

                            <StackPanel Spacing="0" IsVisible="{Binding IsProviderDetailOpen}">
                            <Button Classes="link" Content="← 返回提供商列表" Click="OnCloseProviderDetailClicked" HorizontalAlignment="Left" Margin="0,0,0,14" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                            <StackPanel Spacing="4">
                            <TextBlock Text="{Binding ProviderDetailName}" FontSize="24" FontWeight="Medium" LetterSpacing="-0.3" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding ProviderDetailId}" FontSize="11.5" Foreground="{StaticResource TextCaption}" />
                            <Button Classes="link" IsVisible="{Binding HasProviderDetailWebsite}" Tag="{Binding ProviderDetailWebsite}" Click="OnOpenProviderWebsiteClicked" HorizontalAlignment="Left" Padding="0">
                            <TextBlock Text="{Binding ProviderDetailWebsite}" FontSize="11.5" Foreground="#7EA7E8" TextDecorations="Underline" />
                            </Button>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="返回列表" Click="OnCloseProviderDetailClicked" VerticalAlignment="Top" />
                            </Grid>

                            <TextBlock Classes="settings-heading" Text="提供商信息" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel Margin="16,12,16,12" Spacing="10">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel Spacing="4">
                            <TextBlock Text="供应商名称" Classes="settings-desc" />
                            <TextBox Classes="settings-input" Text="{Binding ProviderEditName, Mode=TwoWay}" PlaceholderText="DeepSeek" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="备注" Classes="settings-desc" />
                            <TextBox Classes="settings-input" Text="{Binding ProviderEditNote, Mode=TwoWay}" PlaceholderText="例如：团队共享额度" />
                            </StackPanel>
                            </Grid>
                            <StackPanel Spacing="4">
                            <TextBlock Text="官网链接" Classes="settings-desc" />
                            <TextBox Classes="settings-input" Text="{Binding ProviderEditWebsite, Mode=TwoWay}" PlaceholderText="https://www.deepseek.com" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="名称、备注和官网链接只保存在本机。" FontSize="11.5" Foreground="{StaticResource TextCaption}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="primary" Content="保存信息" Click="OnSaveProviderProfileClicked" />
                            </Grid>
                            <TextBlock Text="{Binding ProviderEditStatus}" IsVisible="{Binding HasProviderEditStatus}" FontSize="11.5" Foreground="#E36B6B" TextWrapping="Wrap" />
                            </StackPanel>
                            </Border>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,30,0,17">
                            <TextBlock Classes="settings-heading" Text="模型" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="添加模型" Click="OnAddProviderModelClicked" />
                            </Grid>
                            <Border Classes="settings-card">
                            <StackPanel>
                            <ItemsControl ItemsSource="{Binding ProviderModels}" IsVisible="{Binding HasProviderModels}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProviderModelRow">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="16,10,16,10">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Id}" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="编辑" Click="OnEditProviderModelClicked" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="danger" Content="删除" Click="OnDeleteProviderModelClicked" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" Margin="16,0,16,0" />
                            </StackPanel>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel IsVisible="{Binding ShowNoProviderModels}" Margin="16,6,16,14" Spacing="4">
                            <TextBlock Text="这个提供商还没有模型" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="添加模型后，KL 才能在聊天中选择它。" FontSize="11.5" Foreground="{StaticResource TextCaption}" />
                            </StackPanel>
                            <Border IsVisible="{Binding IsProviderModelFormOpen}" Background="#1B1B1E" BorderBrush="#34343A" BorderThickness="1" CornerRadius="10" Margin="16,12,16,14" Padding="14">
                            <StackPanel Spacing="11">
                            <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                            <TextBlock Text="{Binding ProviderModelFormTitle}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="模型 URL 使用完整的 chat/completions、messages 或 responses 地址。" FontSize="11.5" Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="subtle" Content="取消" Click="OnCancelProviderModelClicked" VerticalAlignment="Top" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel Spacing="4">
                            <TextBlock Text="模型 ID" Classes="settings-desc" />
                            <TextBox Classes="settings-input" Text="{Binding ProviderModelDraftId, Mode=TwoWay}" PlaceholderText="deepseek-chat" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="接口协议" Classes="settings-desc" />
                            <ComboBox Classes="settings-select" HorizontalAlignment="Stretch" SelectedIndex="{Binding ProviderModelProtocolIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="OpenAI Chat" />
                            <ComboBoxItem Content="Anthropic" />
                            <ComboBoxItem Content="OpenAI Responses" />
                            </ComboBox>
                            </StackPanel>
                            </Grid>
                            <StackPanel Spacing="4">
                            <TextBlock Text="模型 URL" Classes="settings-desc" />
                            <TextBox Classes="settings-input" Text="{Binding ProviderModelDraftUrl, Mode=TwoWay}" PlaceholderText="https://api.deepseek.com/chat/completions" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <StackPanel Spacing="4">
                            <TextBlock Text="上下文窗口" Classes="settings-desc" />
                            <TextBox Classes="settings-input" Text="{Binding ProviderModelDraftContextWindow, Mode=TwoWay}" PlaceholderText="128000" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="压缩阈值" Classes="settings-desc" />
                            <TextBox Classes="settings-input" Text="{Binding ProviderModelDraftCompactThreshold, Mode=TwoWay}" PlaceholderText="0.8" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="最大输出 tokens" Classes="settings-desc" />
                            <TextBox Classes="settings-input" Text="{Binding ProviderModelDraftMaxOutput, Mode=TwoWay}" PlaceholderText="8192" />
                            </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="保存会写入 KL Core 配置。" FontSize="11.5" Foreground="{StaticResource TextCaption}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="primary" Content="保存模型" Click="OnSaveProviderModelClicked" />
                            </Grid>
                            <TextBlock Text="{Binding ProviderModelFormStatus}" IsVisible="{Binding HasProviderModelFormStatus}" FontSize="11.5" Foreground="#E36B6B" TextWrapping="Wrap" />
                            </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding ProviderDetailStatus}" IsVisible="{Binding HasProviderDetailStatus}" FontSize="11.5" Foreground="{StaticResource TextCaption}" Margin="16,0,16,12" TextWrapping="Wrap" />
                            </StackPanel>
                            </Border>

                            <TextBlock Classes="settings-heading" Text="API Key" Margin="0,30,0,0" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel Margin="16,12,16,12" Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                            <TextBlock Text="供应商凭据" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding ProviderDetailKeyStatus}" FontSize="11.5" Foreground="{StaticResource TextCaption}" />
                            </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox Classes="settings-input" PasswordChar="•" Text="{Binding ProviderDetailApiKey, Mode=TwoWay}" PlaceholderText="输入新的 API Key" />
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="保存 Key" Click="OnSaveProviderApiKeyClicked" />
                            </Grid>
                            <TextBlock Text="密钥只保存在本机凭据目录，不会写入 config.toml。" FontSize="11.5" Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" />
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsUsage}" Spacing="50">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,-8,0,-20">
                            <Button Classes="filter" Classes.active="True" Content="概览" Tag="usage:overview" Click="OnSettingsTabClicked" />
                            <Button Classes="filter" Content="分析" Tag="usage:analysis" Click="OnSettingsTabClicked" />
                            </StackPanel>
                            <StackPanel Spacing="0" Classes="settings-tab-page" Tag="usage:overview">
                            <TextBlock Classes="settings-heading" Text="当前套餐" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11"><StackPanel Spacing="3"><TextBlock Text="KL 免费版" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" /><TextBlock Text="每月 ¥0" FontSize="12" Foreground="{StaticResource TextCaption}" /></StackPanel><Button Grid.Column="1" Classes="secondary settings-button" Content="查看套餐" Click="OnSettingsPlaceholderClicked" /></Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0" Classes="settings-tab-page" Tag="usage:overview">
                            <TextBlock Classes="settings-heading" Text="套餐限额" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" Margin="0,6,0,10" MaxWidth="620" Text="Codex、Work、工作空间智能体和 KL for Excel 共享使用额度。聊天模式下的对话不计入此用量。" />
                            <Border Classes="settings-card"><StackPanel Margin="16,12,16,11" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="settings-title" Text="每月使用限额" /><TextBlock Grid.Column="1" Classes="settings-value" Text="剩余 100%" /></Grid>
                            <TextBlock Classes="settings-desc" Text="30 天 0 小时后重置" />
                            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="100" Background="#2A2A2E" Foreground="#E3E4E6" Margin="0,0,0,0" />
                            </StackPanel></Border>
                            </StackPanel>
                            <StackPanel Spacing="0" Classes="settings-tab-page" Tag="usage:overview">
                            <Border Classes="settings-card" Margin="0,2,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="允许助手使用用量重置次数" />
                            <TextBlock Classes="settings-desc" Text="仅当你在对话中明确请求重置，且当前限额的剩余用量不超过 10% 时，才允许助手使用重置次数。系统绝不会自动使用重置次数。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0" Classes="settings-tab-page" Tag="usage:overview">
                            <TextBlock Classes="settings-heading" Text="使用限额重置" />
                            <TextBlock Classes="settings-desc" Text="使用一次重置，即可恢复你的 5 小时限额、每周限额，或同时恢复两者" HorizontalAlignment="Left" Margin="0,6,0,0" MaxWidth="620" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="16,12,16,11" ColumnSpacing="10"><TextBlock Classes="settings-title" Text="可用 0" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="filter" Classes.active="True" Content="历史记录" Click="OnSettingsPlaceholderClicked" /><TextBlock Grid.Column="3" Classes="settings-desc" Text="过去 30 天" VerticalAlignment="Center" /></Grid>
                            <Border Classes="settings-divider" />
                            <TextBlock Text="过去 30 天内没有储备重置次数的活动记录" FontSize="12.5" Foreground="{StaticResource TextCaption}" Margin="16,0,16,13" />
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0" Classes="settings-tab-page" Tag="usage:analysis"
                                        IsVisible="False">
                            <TextBlock Classes="settings-heading" Text="分析" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel Spacing="14" Margin="16,12,16,11">
                            <TextBlock Classes="settings-desc" Text="本地已记录的 token 用量；最近的 12 个会话。" />
                            <ItemsControl ItemsSource="{Binding UsageBars}" IsVisible="{Binding HasUsageBars}"
                                          Height="120" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                            <UniformGrid Columns="12" />
                            </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UsageBarRow">
                            <Border Width="26" Height="{Binding Height}" CornerRadius="4" Background="#2F6BFF"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="还没有本地用量记录" IsVisible="{Binding !HasUsageBars}"
                                       FontSize="12.5" Foreground="{StaticResource TextCaption}" />
                            <TextBlock Text="过去 12 个会话" FontSize="11.5" Foreground="{StaticResource TextCaption}" />
                            </StackPanel>
                            </Border>
                            </StackPanel>

                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="本地用量" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="已记录用量" />
                            <TextBlock Classes="settings-desc" Text="只统计本版本之后完成的回合；更早的会话没有用量数据。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="28" VerticalAlignment="Center"><StackPanel Spacing="2"><TextBlock Classes="settings-value" Text="{Binding UsageTokensText}" /><TextBlock Classes="settings-desc" Text="输入 / 输出 tokens" /></StackPanel><StackPanel Spacing="2"><TextBlock Classes="settings-value" Text="{Binding UsageCostText}" /><TextBlock Classes="settings-desc" Text="费用（USD）" /></StackPanel></StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <StackPanel Margin="8,6"><ItemsControl ItemsSource="{Binding UsageRows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:UsageSessionRow"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="20" Margin="12,9"><TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Classes="settings-key" Text="{Binding Tokens}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" MinWidth="72" TextAlignment="Right" Classes="settings-key" Text="{Binding Cost}" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="还没有记录到用量" IsVisible="{Binding !ShowUsageRows}" FontSize="12.5" Foreground="{StaticResource TextCaption}" Margin="12,10" /></StackPanel>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>


                            <StackPanel IsVisible="{Binding IsSettingsPlugins}" Spacing="50">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,-8,0,-8">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Classes="filter" Classes.active="True" Tag="plugins:plugins" Click="OnSettingsTabClicked"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="插件" /><TextBlock Text="{Binding Plugins.Count}" Foreground="{StaticResource TextCaption}" /></StackPanel></Button>
                            <Button Classes="filter" Tag="plugins:apps" Click="OnSettingsTabClicked"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="应用" /><TextBlock Text="0" Foreground="{StaticResource TextCaption}" /></StackPanel></Button>
                            <Button Classes="filter" Tag="plugins:mcp" Click="OnSettingsTabClicked"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="MCP" /><TextBlock Text="{Binding McpTools.Count}" Foreground="{StaticResource TextCaption}" /></StackPanel></Button>
                            <Button Classes="filter" Tag="plugins:market" Click="OnSettingsTabClicked"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="市场" /><TextBlock Text="0" Foreground="{StaticResource TextCaption}" /></StackPanel></Button>
                            </StackPanel>
                            <Border Grid.Column="1" Classes="search-field" Width="223" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Path Width="13" Height="13" Data="{StaticResource SearchIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.35" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Classes="search" PlaceholderText="搜索插件" />
                            </Grid>
                            </Border>
                            </Grid>
                            <StackPanel Spacing="0" Classes="settings-tab-page" Tag="plugins:plugins">
                            <Border Classes="settings-card">
                            <StackPanel>
                            <ItemsControl ItemsSource="{Binding Plugins}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PluginItemViewModel"><Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Margin="16,12,16,11"><Border Width="32" Height="32" CornerRadius="8" Background="#232326"><Path Width="16" Height="16" Data="{StaticResource PluginIcon}" Stretch="Uniform" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" /><TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" /></StackPanel><ToggleSwitch Grid.Column="2" Classes="setting" IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center" IsCheckedChanged="OnPluginToggled" ToolTip.Tip="{Binding StatusText}" /><Path Classes="row-chevron" Grid.Column="3" Width="10" Height="10" Data="{StaticResource ChevronRightIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.4" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="还没有安装插件" IsVisible="{Binding !HasPlugins}" FontSize="12.5" Foreground="{StaticResource TextCaption}" Margin="16,12,16,11" />
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0" Classes="settings-tab-page" Tag="plugins:mcp" IsVisible="False">
                            <TextBlock Classes="settings-heading" Text="MCP 工具" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11"><StackPanel Spacing="3"><TextBlock Classes="settings-title" Text="已连接的工具" /><TextBlock Classes="settings-desc" Text="{Binding McpStatusText}" HorizontalAlignment="Left" MaxWidth="520" /></StackPanel><Button Grid.Column="1" Classes="secondary settings-button" Click="OnRefreshMcpToolsClicked" Content="刷新" /></Grid>
                            <Border Classes="settings-divider" />
                            <ItemsControl ItemsSource="{Binding McpTools}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:McpToolRow"><StackPanel Margin="16,10" Spacing="3"><TextBlock Text="{Binding Name}" FontSize="12.5" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextCaption}" MaxWidth="560" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                           <StackPanel Spacing="0" Classes="settings-tab-page" Tag="plugins:apps"
                                        IsVisible="False">
                            <TextBlock Classes="settings-heading" Text="应用" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <TextBlock Text="尚未发现可连接的应用" FontSize="12.5"
                                       Foreground="{StaticResource TextCaption}" Margin="16,18" />
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0" Classes="settings-tab-page" Tag="plugins:market"
                                        IsVisible="False">
                            <TextBlock Classes="settings-heading" Text="市场" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <TextBlock Text="市场目录将在接入后显示" FontSize="12.5"
                                       Foreground="{StaticResource TextCaption}" Margin="16,18" />
                            </Border>
                            </StackPanel>
                            </StackPanel>

                             <StackPanel IsVisible="{Binding IsSettingsPasswords}" Spacing="50">
                            <Border Classes="search-field" Margin="0,6,0,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Path Width="13" Height="13" Data="{StaticResource SearchIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.35" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Classes="search" PlaceholderText="搜索密码" />
                            </Grid>
                            </Border>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="KL 凭据" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="Provider API Key" />
                            <TextBlock Text="{Binding CoreKeyStatusText}" Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="管理" Click="OnOpenModelsSettingsClicked" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="远程 Core 访问令牌" />
                            <TextBlock Text="{Binding RemoteTokenStatusText}" Classes="settings-desc" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary settings-button" Content="刷新" Click="OnRefreshCredentialsClicked" />
                            <Button Classes="secondary settings-button" Content="打开目录" Click="OnOpenCredentialsClicked" />
                            </StackPanel>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsComputerUse}" Spacing="50">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="控制" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="16,12,16,11"><Border Width="32" Height="32" CornerRadius="8" Background="#232326"><TextBlock Text="C" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="Google Chrome" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" /><TextBlock Text="● 未安装浏览器扩展程序" FontSize="11.5" Foreground="#E36B6B" /></StackPanel><Button Grid.Column="2" Classes="secondary settings-button" Content="安装" VerticalAlignment="Center" Click="OnSettingsPlaceholderClicked" /></Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="16,12,16,11"><Border Width="32" Height="32" CornerRadius="8" Background="#232326"><TextBlock Text="E" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="Microsoft Edge" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" /><TextBlock Text="● 未安装浏览器扩展程序" FontSize="11.5" Foreground="#E36B6B" /></StackPanel><Button Grid.Column="2" Classes="secondary settings-button" Content="安装" VerticalAlignment="Center" Click="OnSettingsPlaceholderClicked" /></Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="16,12,16,11"><Border Width="32" Height="32" CornerRadius="8" Background="#232326"><TextBlock Text="X" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="Microsoft Excel" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" /><TextBlock Text="允许 KL 使用 Microsoft Excel 加载项以获得更多控制权限" FontSize="12" Foreground="{StaticResource TextCaption}" /></StackPanel><ToggleSwitch Grid.Column="2" Classes="setting" IsChecked="True" VerticalAlignment="Center" /></Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="16,12,16,11"><Border Width="32" Height="32" CornerRadius="8" Background="#232326"><TextBlock Text="W" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="Microsoft Word" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" /><TextBlock Text="允许 KL 使用 Microsoft Word 加载项，以获得更多控制权限" FontSize="12" Foreground="{StaticResource TextCaption}" /></StackPanel><ToggleSwitch Grid.Column="2" Classes="setting" IsChecked="True" VerticalAlignment="Center" /></Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="始终允许的应用" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <TextBlock Text="暂无" FontSize="12.5" Foreground="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="16,22" />
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsBrowser}" Spacing="50">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0"><Path Width="15" Height="15" Data="{StaticResource RefreshIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" VerticalAlignment="Center" /><TextBlock Text="正在加载插件..." FontSize="12.5" Foreground="{StaticResource TextCaption}" VerticalAlignment="Center" /></StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="常规" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="网页 URL 和链接打开位置" />
                            <TextBlock Classes="settings-desc" Text="在代码审查设置中管理 Codex 的 Pull Request 链接" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="ChatGPT" />
                            <ComboBoxItem Content="系统浏览器" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="本地 URL 打开位置" />
                            <TextBlock Classes="settings-desc" Text="本地开发站点默认打开位置" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="ChatGPT" />
                            <ComboBoxItem Content="系统浏览器" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="显示完整网址" />
                            <TextBlock Classes="settings-desc" Text="在地址栏中显示路径、查询参数和片段" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="False" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="浏览数据" />
                            <TextBlock Classes="settings-desc" Text="清除应用内浏览器中的浏览历史记录、网站数据、缓存和下载历史记录" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="清除浏览数据" Click="OnSettingsPlaceholderClicked" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="浏览历史" />
                            <TextBlock Classes="settings-desc" Text="查看和管理在内置浏览器中访问过的页面" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="管理" Click="OnSettingsPlaceholderClicked" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="批注截图" />
                            <TextBlock Classes="settings-desc" Text="截图可帮助 KL 更好地理解和处理评论，但会增加套餐用量" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="始终包含" />
                            <ComboBoxItem Content="关闭" />
                            </ComboBox>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="自动填充和密码" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="密码管理器" />
                            <TextBlock Classes="settings-desc" Text="添加、删除和编辑已保存的密码" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="管理" Click="OnSettingsPlaceholderClicked" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="联系信息" />
                            <TextBlock Classes="settings-desc" Text="添加、删除和编辑已保存的地址、电话号码和电子邮箱地址" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="管理" Click="OnSettingsPlaceholderClicked" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="扩展程序" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="扩展程序管理器" />
                            <TextBlock Classes="settings-desc" Text="安装、移除和配置浏览器扩展程序" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="管理" Click="OnSettingsPlaceholderClicked" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="下载" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="位置" />
                            <TextBlock Classes="settings-desc" Text="系统下载文件夹" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="更改" Click="OnSettingsPlaceholderClicked" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="下载前询问保存位置" />
                            <TextBlock Classes="settings-desc" Text="对在内置浏览器中发起的下载显示保存对话框" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="False" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="下载历史记录" />
                            <TextBlock Classes="settings-desc" Text="查看和管理从内置浏览器下载的文件" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="管理" Click="OnSettingsPlaceholderClicked" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="浏览器权限" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="网站设置" />
                            <TextBlock Classes="settings-desc" Text="管理内置浏览器中的摄像头和麦克风权限" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="管理" Click="OnSettingsPlaceholderClicked" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsCloudPc}" Spacing="50">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="远程 KL Core" />
                            <TextBlock Classes="settings-desc" Text="把 KL Core 部署到另一台电脑（或云电脑），通过 IP + 端口连接；回合和工具都在那台机器上执行。"
                                       HorizontalAlignment="Left" Margin="0,6,0,0" MaxWidth="650" TextWrapping="Wrap" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="当前连接" />
                            <TextBlock Text="{Binding RemoteCoreConnectionLabel}" Classes="settings-desc"
                                       FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="配置"
                                    VerticalAlignment="Center" Click="OnOpenRemoteCoreSettingsClicked" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="常规" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="ChatGPT Work 的 Cookie" />
                            <TextBlock Classes="settings-desc" Text="管理 ChatGPT Work 使用的 Cookie" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Path Classes="row-chevron" Width="10" Height="10" Data="{StaticResource ChevronRightIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" />
                            </StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="ChatGPT Work 网站授权" />
                            <TextBlock Classes="settings-desc" Text="选择是否让 ChatGPT Work 在打开网站前征求你的同意。此设置仅适用于 ChatGPT Work。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="自动批准" />
                            <ComboBoxItem Content="每次都询问" />
                            </ComboBox>
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="网站权限" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11"><TextBlock Text="添加站点以覆盖默认权限" FontSize="12" Foreground="{StaticResource TextCaption}" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="secondary settings-button" Content="添加网站" Click="OnSettingsPlaceholderClicked" /></Grid>
                            <Border Classes="settings-divider" />
                            <TextBlock Text="暂无网站权限" FontSize="12.5" Foreground="{StaticResource TextCaption}" Margin="16,0,16,13" />
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsHooks}" Spacing="50">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                            <TextBlock Text="KL Core 在启动时读取 hooks.toml；工具执行前后会运行匹配的钩子。" FontSize="12.5" Foreground="{StaticResource TextCaption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="secondary settings-button" Content="打开 hooks.toml" Click="OnOpenHooksClicked" />
                            <Button Classes="subtle" Width="28" Height="28" Padding="0" HorizontalContentAlignment="Center" Click="OnRefreshHooksClicked"><Path Width="14" Height="14" Data="{StaticResource RefreshIcon}" Stretch="Uniform" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.3" /></Button>
                            </StackPanel>
                            </Grid>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="配置状态" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="16,12,16,11"><Border Width="30" Height="30" CornerRadius="8" Background="#232326"><Path Width="15" Height="15" Data="{StaticResource CodeIcon}" Stretch="Uniform" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="hooks.toml" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" /><TextBlock Text="{Binding HooksStatusText}" FontSize="12" Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding HooksFilePath}" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextCaption}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" /></Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsConnections}" Spacing="50">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,-8,0,-20">
                            <Button Classes="filter" Classes.active="True" Content="控制此电脑" Tag="connect:this" Click="OnSettingsTabClicked" />
                            <Button Classes="filter" Content="控制其他设备" Tag="connect:other" Click="OnSettingsTabClicked" />
                            <Button Classes="filter" Content="SSH" Tag="connect:ssh" Click="OnSettingsTabClicked" />
                            </StackPanel>
                            <StackPanel Spacing="0" Classes="settings-tab-page" Tag="connect:this">
                            <TextBlock Classes="settings-heading" Text="可控制此电脑的设备" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="16,34"><StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"><Path Width="24" Height="30" Data="{StaticResource PanelIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.2" Fill="Transparent" /><Path Width="34" Height="26" Data="{StaticResource PanelIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.2" Fill="Transparent" /></StackPanel><TextBlock Text="添加设备以远程控制此电脑" FontSize="12.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" /><Button Classes="secondary settings-button" Content="添加" HorizontalAlignment="Center" Click="OnOpenRemoteCoreSettingsClicked" /></StackPanel>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0" Classes="settings-tab-page" Tag="connect:other"
                                        IsVisible="False">
                            <TextBlock Classes="settings-heading" Text="远程 KL Core" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="地址" />
                            <TextBlock Classes="settings-desc" Text="另一台电脑上通过 --listen 暴露的地址" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Classes="settings-input" Width="260" VerticalAlignment="Center"
                                     PlaceholderText="tcp://192.168.1.20:8787"
                                     Text="{Binding RemoteCoreEndpointDraft, Mode=TwoWay}" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="访问令牌" />
                            <TextBlock Classes="settings-desc" Text="与服务器 --token 的值一致；本机地址可留空" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Classes="settings-input" Width="260" VerticalAlignment="Center"
                                     PasswordChar="●"
                                     Text="{Binding RemoteCoreTokenDraft, Mode=TwoWay}" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <TextBlock Text="{Binding RemoteCoreStatus}" IsVisible="{Binding HasRemoteCoreStatus}"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Classes="subtle" Click="OnClearRemoteCoreClicked" Content="清除" />
                            <Button Classes="secondary settings-button" Click="OnSaveRemoteCoreClicked" Content="保存" />
                            </StackPanel>
                            </Grid>
                            </StackPanel>
                            </Border>
                            <TextBlock Classes="settings-desc" Margin="0,10,0,0"
                                       Text="保存后重启 KL 生效；配置后不再启动本机 Core。" />
                            </StackPanel>
                            <StackPanel Spacing="0" Classes="settings-tab-page" Tag="connect:ssh"
                                        IsVisible="False">
                            <TextBlock Classes="settings-heading" Text="SSH" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <TextBlock Text="通过 SSH 连接远程主机时会话将显示在此处" FontSize="12.5"
                                       Foreground="{StaticResource TextCaption}" Margin="16,18" />
                            </Border>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsCodeReview}" Spacing="50">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,-8,0,-20">
                            <Button Classes="filter" Classes.active="True" Content="偏好设置" Tag="review:prefs" Click="OnSettingsTabClicked" />
                            <Button Classes="filter" Content="审查智能体" Tag="review:agent" Click="OnSettingsTabClicked" />
                            </StackPanel>
                            <StackPanel Spacing="0" Classes="settings-tab-page" Tag="review:prefs">
                            <TextBlock Classes="settings-heading" Text="代码仓库" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11"><TextBlock Classes="settings-desc" Text="选择一个代码仓库，为其配置自动审查" VerticalAlignment="Center" /><ComboBox Grid.Column="1" Classes="settings-select" SelectedIndex="0"><ComboBoxItem Content="GitHub" /><ComboBoxItem Content="GitLab" /></ComboBox></Grid>
                            <Border Classes="settings-divider" />
                            <Border Classes="search-field" Margin="16,0,16,12"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Path Width="13" Height="13" Data="{StaticResource SearchIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.35" VerticalAlignment="Center" /><TextBox Grid.Column="1" Classes="search" PlaceholderText="搜索代码仓库" /></Grid></Border>
                            <Border Classes="settings-divider" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,16,13"><Path Width="14" Height="14" Data="{StaticResource RefreshIcon}" Stretch="Uniform" Stroke="{StaticResource TextTertiary}" StrokeThickness="1.3" VerticalAlignment="Center" /><TextBlock Text="正在加载代码仓库..." FontSize="12" Foreground="{StaticResource TextCaption}" VerticalAlignment="Center" /></StackPanel>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0" Classes="settings-tab-page" Tag="review:prefs">
                            <TextBlock Classes="settings-heading" Text="个人偏好" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="自动代码审查" />
                            <TextBlock Classes="settings-desc" Text="如果代码仓库的审查设置与你的个人偏好不同，则以代码仓库的设置为准" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="False" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="审核触发条件" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650"><Run Text="选择 "/><Run Text="KL" Foreground="#E3E4E6"/><Run Text=" 何时审查你的 Pull Request"/></TextBlock>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="打开 PR 时" />
                            <ComboBoxItem Content="推送时" />
                            <ComboBoxItem Content="关闭" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="全面代码审查" />
                            <TextBlock Classes="settings-desc" Text="继续查找结果，直到 KL 不再发现新问题" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="False" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0" Classes="settings-tab-page" Tag="review:agent"
                                        IsVisible="False">
                            <TextBlock Classes="settings-heading" Text="审查智能体" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="审查模型" />
                            <TextBlock Classes="settings-desc" Text="选择运行代码审查时使用的模型" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="模型默认" />
                            <ComboBoxItem Content="继承聊天模型" />
                            </ComboBox>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="审查范围" />
                            <TextBlock Classes="settings-desc" Text="选择审查智能体检查改动的方式" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="settings-select" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="仅改动的行" />
                            <ComboBoxItem Content="完整文件" />
                            </ComboBox>
                            </Grid>
                            </StackPanel>
                            </Border>
                            <StackPanel Spacing="0" Margin="0,50,0,0">
                            <TextBlock Classes="settings-heading" Text="审查指令" />
                            <TextBlock Classes="settings-desc" Text="将添加到审查智能体的提示中" Margin="0,8,0,0" HorizontalAlignment="Left" />
                            <TextBox Classes="settings-textarea" Margin="0,10,0,0" PlaceholderText="添加审查智能体指引..." />
                            </StackPanel>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsGit}" Spacing="50">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Classes="settings-heading" Text="当前项目" />
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="刷新" Click="OnRefreshGitClicked" />
                            </Grid>
                            <Border Classes="settings-card" Margin="0,11,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="分支" />
                            <TextBlock Text="{Binding GitBranchText}" Classes="settings-desc"
                                       FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Left" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding WorkspacePath}" FontSize="11.5"
                                       Foreground="{StaticResource TextCaption}" MaxWidth="320"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <TextBlock Classes="settings-title" Text="状态" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding GitStatusText}" FontSize="12"
                                       Foreground="{StaticResource TextCaption}" TextWrapping="Wrap"
                                       TextAlignment="Right" MaxWidth="480" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="分支前缀" />
                            <TextBlock Classes="settings-desc" Text="KL 创建新分支时使用的前缀" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Classes="settings-input" Width="260" VerticalAlignment="Center" PlaceholderText="" Text="kl/" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="Pull Request 合并方法" />
                            <TextBlock Classes="settings-desc" HorizontalAlignment="Left" MaxWidth="650"><Run Text="选择 "/><Run Text="KL" Foreground="#E3E4E6"/><Run Text=" 合并 Pull Request 的方式"/></TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"><Button Classes="filter" Classes.active="True" Content="合并" Click="OnSettingsPlaceholderClicked" /><Button Classes="filter" Content="压缩合并" Click="OnSettingsPlaceholderClicked" /></StackPanel>
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="始终强制推送" />
                            <TextBlock Classes="settings-desc" Text="从 KL 推送时使用 --force-with-lease" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="False" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="创建草稿 Pull Request" />
                            <TextBlock Classes="settings-desc" Text="从 KL 创建 PR 时默认使用草稿 Pull Request" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="审查结果呈现方式" />
                            <TextBlock Classes="settings-desc" Text="尽可能在当前聊天中启动 /review，或启动单独的审查聊天" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"><Button Classes="filter" Classes.active="True" Content="内联" Click="OnSettingsPlaceholderClicked" /><Button Classes="filter" Content="单独" Click="OnSettingsPlaceholderClicked" /></StackPanel>
                            </Grid>
                            </StackPanel>
                            </Border>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="提交指令" />
                            <TextBlock Classes="settings-desc" Text="将添加到提交信息生成提示中" Margin="0,8,0,0" HorizontalAlignment="Left" />
                            <TextBox Classes="settings-textarea" Margin="0,10,0,0" PlaceholderText="添加提交信息指引..." />
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="Pull Request 指令" />
                            <TextBlock Classes="settings-desc" Text="将添加到 PR 标题/描述生成提示中" Margin="0,8,0,0" HorizontalAlignment="Left" />
                            <TextBox Classes="settings-textarea" Margin="0,10,0,0" PlaceholderText="添加 Pull Request 指引..." />
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsEnvironments}" Spacing="50">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="选择项目" />
                            <StackPanel Spacing="10" Margin="0,10,0,0"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="" /><Button Grid.Column="1" Classes="secondary settings-button" Click="OnAddWorkspaceClicked" Content="添加项目" /></Grid>
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <ItemsControl ItemsSource="{Binding Workspaces}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:WorkspaceItemViewModel"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="16,12,16,11"><Path Width="16" Height="16" Data="{StaticResource FolderIcon}" Stretch="Uniform" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.2" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" /><TextBlock Text="{Binding Path}" FontSize="11.5" Foreground="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" /></StackPanel><Button Grid.Column="2" Classes="subtle" Width="28" Height="28" Padding="0" HorizontalContentAlignment="Center" Click="OnWorkspaceEditClicked"><Path Width="13" Height="13" Data="{StaticResource PlusIcon}" Stretch="Uniform" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.3" /></Button></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                            </Border></StackPanel>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsWorktrees}" Spacing="50">
                            <StackPanel Spacing="0">
                            <TextBlock Classes="settings-heading" Text="创建与清理" />
                            <Border Classes="settings-card" Margin="0,17,0,0">
                            <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="工作树根目录" />
                            <TextBlock Classes="settings-desc" Text="留空以使用默认位置" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Classes="settings-input" Width="300" VerticalAlignment="Center" PlaceholderText="" Text="~/.kl/worktrees" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="创建工作树前始终获取上游更新" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="False" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="自动删除旧工作树" />
                            <TextBlock Classes="settings-desc" Text="先保存一份恢复快照" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="保留的工作树数量" />
                            <TextBlock Classes="settings-desc" Text="较旧的工作树会自动删除。已置顶或进行中的聊天所用的工作树会保留。" HorizontalAlignment="Left" MaxWidth="650" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Classes="settings-input" Width="120" VerticalAlignment="Center" PlaceholderText="" Text="15" />
                            </Grid>
                            <Border Classes="settings-divider" />
                            <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,11">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Classes="settings-title" Text="删除工作树前询问" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="setting" IsChecked="True" VerticalAlignment="Center" />
                            </Grid>
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Classes="settings-heading" Text="托管的工作树" />
                            <Button Grid.Column="1" Classes="secondary settings-button" Content="刷新" Click="OnRefreshWorktreesClicked" />
                            </Grid>
                            <TextBlock Text="{Binding WorktreesStatusText}" FontSize="12" Foreground="{StaticResource TextCaption}" Margin="0,0,0,10" />
                            <Border Classes="settings-card" Margin="0,7,0,0">
                            <StackPanel>
                            <ItemsControl ItemsSource="{Binding Worktrees}">
                            <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorktreeRow">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="16,10">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Branch}" FontSize="13" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Path}" FontSize="11.5" FontFamily="Cascadia Mono, Consolas"
                                       Foreground="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentLabel}" FontSize="11"
                                       Foreground="{StaticResource TextCaption}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="subtle" Width="28" Height="28" Padding="0"
                                    HorizontalContentAlignment="Center" Click="OnOpenWorktreeClicked"
                                    ToolTip.Tip="在资源管理器中打开">
                            <Path Width="13" Height="13" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                  Stroke="{StaticResource TextSecondary}" StrokeThickness="1.3" />
                            </Button>
                            </Grid>
                            </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="尚无工作树" IsVisible="{Binding !HasWorktrees}"
                                       FontSize="12.5" Foreground="{StaticResource TextCaption}" Margin="16,12,16,11" />
                            </StackPanel>
                            </Border>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsSettingsArchived}" Spacing="50">
                                                                                                                                                                                                                                                                                            <StackPanel Spacing="0">
                                                                                                                                                                                                                                                                                                <TextBlock Classes="settings-heading" Text="已归档的聊天" />
                                                                                                                                                                                                                                                                                                <TextBlock Classes="settings-desc" Margin="0,6,0,10"
                                                                                                                                                                                                                                                                                                           Text="归档的聊天不会出现在侧边栏；点击右侧按钮可恢复。" />
                                                                                                                                                                                                                                                                                                <Border Classes="settings-card">
                                                                                                                                                                                                                                                                                                    <StackPanel Margin="8,6">
                                                                                                                                                                                                                                                                                                        <ItemsControl ItemsSource="{Binding ArchivedSessions}">
                                                                                                                                                                                                                                                                                                            <ItemsControl.ItemTemplate>
                                                                                                                                                                                                                                                                                                                <DataTemplate x:DataType="vm:SessionItemViewModel">
                                                                                                                                                                                                                                                                                                                    <Grid Classes="session-row-container"
                                                                                                                                                                                                                                                                                                                          ColumnDefinitions="*,Auto" Margin="8,2">
                                                                                                                                                                                                                                                                                                                        <Button Classes="nav" Height="NaN" Padding="10,6"
                                                                                                                                                                                                                                                                                                                                Click="OnSessionClicked"
                                                                                                                                                                                                                                                                                                                                ToolTip.Tip="{Binding Workspace.Path}">
                                                                                                                                                                                                                                                                                                                            <StackPanel Spacing="2">
                                                                                                                                                                                                                                                                                                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                                                                                                                                                                                                                                                                                                           TextTrimming="CharacterEllipsis"
                                                                                                                                                                                                                                                                                                                                           VerticalAlignment="Center" />
                                                                                                                                                                                                                                                                                                                                <TextBlock Text="{Binding UpdatedLabel}"
                                                                                                                                                                                                                                                                                                                                           FontSize="11"
                                                                                                                                                                                                                                                                                                                                           Foreground="{StaticResource TextCaption}" />
                                                                                                                                                                                                                                                                                                                            </StackPanel>
                                                                                                                                                                                                                                                                                                                        </Button>
                                                                                                                                                                                                                                                                                                                        <Button Grid.Column="1" Classes="row-action"
                                                                                                                                                                                                                                                                                                                                Opacity="1"
                                                                                                                                                                                                                                                                                                                                VerticalAlignment="Center"
                                                                                                                                                                                                                                                                                                                                Click="OnUnarchiveSessionClicked"
                                                                                                                                                                                                                                                                                                                                ToolTip.Tip="取消归档">
                                                                                                                                                                                                                                                                                                                            <Path Width="13" Height="13"
                                                                                                                                                                                                                                                                                                                                  Data="{StaticResource RefreshIcon}"
                                                                                                                                                                                                                                                                                                                                  Stretch="Uniform" />
                                                                                                                                                                                                                                                                                                                        </Button>
                                                                                                                                                                                                                                                                                                                    </Grid>
                                                                                                                                                                                                                                                                                                                </DataTemplate>
                                                                                                                                                                                                                                                                                                            </ItemsControl.ItemTemplate>
                                                                                                                                                                                                                                                                                                        </ItemsControl>
                                                                                                                                                                                                                                                                                                        <TextBlock Text="没有已归档的聊天"
                                                                                                                                                                                                                                                                                                                   IsVisible="{Binding !ShowArchivedSessions}"
                                                                                                                                                                                                                                                                                                                   FontSize="12.5"
                                                                                                                                                                                                                                                                                                                   Foreground="{StaticResource TextCaption}"
                                                                                                                                                                                                                                                                                                                   Margin="12,10" />
                                                                                                                                                                                                                                                                                                    </StackPanel>
                                                                                                                                                                                                                                                                                                </Border>
                                                                                                                                                                                                                                                                                            </StackPanel>
                                                                                                                                                                                                                                                                                        </StackPanel>

<TextBlock x:Name="SettingsNoMatch" Text="没有匹配的设置项" IsVisible="False"
                                       FontSize="12.5" Foreground="{StaticResource TextTertiary}"
                                       Padding="4,8" />
                        </Grid>
                      </StackPanel>
                    </ScrollViewer>
                    <!-- drag handle: resize the settings nav column, same feel as the sidebar splitter -->
                    <Border x:Name="SettingsNavResizeHandle" HorizontalAlignment="Left" Width="8" Margin="-1,0,0,0" Background="Transparent"
                            Classes="sidebar-resize" Cursor="SizeWestEast" ZIndex="80"
                            PointerPressed="OnSettingsNavResizePressed"
                            PointerMoved="OnSettingsNavResizeMoved"
                            PointerReleased="OnSettingsNavResizeReleased">
                        <Border Width="1" HorizontalAlignment="Left" Classes="resize-line" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===================== Rail hover hint ===================== -->
        <Canvas x:Name="RailHintLayer" Grid.RowSpan="2" IsHitTestVisible="False">
            <Border x:Name="RailHintCard" IsVisible="False" Opacity="0"
                    Background="{DynamicResource MenuFill}" BorderThickness="1"
                    BorderBrush="{DynamicResource LineStrong}"
                    CornerRadius="8" Padding="9,5"
                    BoxShadow="0 6 20 0 #66000000">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
                    </Transitions>
                </Border.Transitions>
                <TextBlock x:Name="RailHintText" FontSize="12"
                           Foreground="{StaticResource TextPrimary}" />
            </Border>
        </Canvas>

        <!-- ===================== More menu popup ===================== -->
        <primitives:Popup x:Name="MorePopup" Placement="RightEdgeAlignedTop" HorizontalOffset="4"
                          IsLightDismissEnabled="False" ShouldUseOverlayLayer="True"
                          Opened="OnMorePopupOpened" Closed="OnMorePopupClosed">
            <Border x:Name="MoreMenuCard" MinWidth="210"
                    Background="{DynamicResource MoreMenuFill}"
                    BorderThickness="0" CornerRadius="10" Padding="4" Opacity="0"
                    PointerEntered="OnMoreMenuPointerEntered"
                    PointerExited="OnMoreMenuPointerExited">
                <Border.RenderTransform>
                    <TranslateTransform X="-3">
                        <TranslateTransform.Transitions>
                            <Transitions>
                                <DoubleTransition Property="X" Duration="0:0:0.10" />
                            </Transitions>
                        </TranslateTransform.Transitions>
                    </TranslateTransform>
                </Border.RenderTransform>
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="1">
                    <Button Classes="more-menu-item" Click="OnMoreProjectClicked">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Path Width="16" Height="16" Data="{StaticResource FolderIcon}" Stretch="Uniform" />
                            <TextBlock Grid.Column="1" Text="项目" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="more-menu-pin" Classes.pinned="{Binding IsAddProjectPinned}"
                                    Click="OnToggleAddProjectPinnedClicked">
                                <Path x:Name="PinProjectGlyph" Width="12" Height="12"
                                      Data="{StaticResource PinIcon}" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Button>
                    <Button Classes="more-menu-item" Click="OnMoreCodeReviewClicked">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Path Width="16" Height="16" Data="{StaticResource CodeReviewIcon}"
                                  Stretch="Uniform" />
                            <TextBlock Grid.Column="1" Text="代码审查" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Classes="more-menu-pin" Classes.pinned="{Binding IsCodeReviewPinned}"
                                    Click="OnToggleCodeReviewPinnedClicked">
                                <Path x:Name="PinReviewGlyph" Width="12" Height="12"
                                      Data="{StaticResource PinIcon}" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </primitives:Popup>

        <!-- section menu overlay: drawn inside the main window, no extra popup windows -->
        <Grid x:Name="SectionMenuOverlay" Grid.RowSpan="2" ZIndex="44" IsVisible="False" Opacity="0">
            <Grid.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.10" />
                </Transitions>
            </Grid.Transitions>
            <Border Background="Transparent" PointerPressed="OnSectionMenuDismissPressed" />
            <Canvas x:Name="SectionMenuCanvas">
                <StackPanel x:Name="SectionMenuStack" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top"
                                    Canvas.Left="0" Canvas.Top="0">
                        <Border x:Name="ProjectSectionMenuCard" Width="216"
                                VerticalAlignment="Top"
                                Background="#202022"
                                BorderBrush="#2E2E31" BorderThickness="1"
                                CornerRadius="12" Padding="6"
                                BoxShadow="0 18 44 0 #99000000"
                                PointerMoved="OnProjectSectionMenuPointerMoved"
                                PointerExited="OnProjectSectionMenuCardPointerExited">
                            <StackPanel Spacing="1">
                                <Button Classes="more-menu-item" Click="OnOrganizeSidebarRowClicked"
                                        PointerEntered="OnOrganizeSidebarRowEntered"
                                        PointerExited="OnProjectSectionMenuRowExited">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource PanelIcon}" Stretch="Uniform" />
                                        <TextBlock Grid.Column="1" Text="整理侧边栏" VerticalAlignment="Center" />
                                        <Path Grid.Column="2" Width="9" Height="9"
                                              Data="{StaticResource ChevronRightSmallIcon}" Stretch="Uniform"
                                              StrokeThickness="1.4" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Classes="more-menu-item" Click="OnSessionSortRowClicked"
                                        PointerEntered="OnSessionSortRowEntered"
                                        PointerExited="OnProjectSectionMenuRowExited">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <Path Width="14" Height="14" Data="{StaticResource SortIcon}" Stretch="Uniform"
                                              StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" />
                                        <TextBlock Grid.Column="1" Text="聊天排序方式" VerticalAlignment="Center" />
                                        <Path Grid.Column="2" Width="9" Height="9"
                                              Data="{StaticResource ChevronRightSmallIcon}" Stretch="Uniform"
                                              StrokeThickness="1.4" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ProjectSectionSubmenuCard" IsVisible="False" Width="190"
                                VerticalAlignment="Top"
                                Background="#1E1E21"
                                BorderBrush="#2C2C2F" BorderThickness="1"
                                CornerRadius="12" Padding="6"
                                BoxShadow="0 14 34 0 #99000000"
                                Margin="0,6,0,0"
                                PointerEntered="OnProjectSectionSubmenuPointerEntered"
                                PointerExited="OnProjectSectionSubmenuPointerExited">
                            <Grid>
                                <StackPanel x:Name="OrganizeSidebarOptions" Spacing="1">
                                    <Button Classes="more-menu-item" Click="OnGroupByProjectClicked">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                            <Path Width="14" Height="14" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                                  Stroke="#A0A1A3" StrokeThickness="1.3" StrokeLineCap="Round"
                                                  StrokeJoin="Round" Fill="Transparent" />
                                            <TextBlock Grid.Column="1" Text="分项目显示" VerticalAlignment="Center"
                                                       Foreground="#C6C7C9" />
                                            <Path Grid.Column="2" Width="14" Height="14"
                                                  Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                                  Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  IsVisible="{Binding IsSidebarGrouped}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Classes="more-menu-item" Click="OnMergeDisplayClicked">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                            <Path Width="14" Height="14" Data="{StaticResource QueueIcon}" Stretch="Uniform"
                                                  StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" />
                                            <TextBlock Grid.Column="1" Text="合并显示" VerticalAlignment="Center"
                                                       Foreground="#C6C7C9" />
                                            <Path Grid.Column="2" Width="14" Height="14"
                                                  Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                                  Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  IsVisible="{Binding !IsSidebarGrouped}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="SessionSortOptions" Spacing="1" IsVisible="False">
                                    <Button Classes="more-menu-item" Click="OnSortByUpdatedClicked">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                            <Path Width="14" Height="14" Data="{StaticResource ClockIcon}" Stretch="Uniform" />
                                            <TextBlock Grid.Column="1" Text="最近更新" VerticalAlignment="Center" />
                                            <Path Grid.Column="2" Width="14" Height="14"
                                                  Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                                  Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  IsVisible="{Binding IsSessionSortByUpdated}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <Button Classes="more-menu-item" Click="OnSortByCreatedClicked">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                            <Path Width="14" Height="14" Data="{StaticResource ClockIcon}" Stretch="Uniform" />
                                            <TextBlock Grid.Column="1" Text="创建时间" VerticalAlignment="Center" />
                                            <Path Grid.Column="2" Width="14" Height="14"
                                                  Data="{StaticResource CheckIcon}" Stretch="Uniform"
                                                  Stroke="{StaticResource SidebarText}" StrokeThickness="1.6"
                                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  IsVisible="{Binding IsSessionSortByCreated}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        </StackPanel>
            </Canvas>
        </Grid>

        <!-- ===================== Hover preview cards ===================== -->
        <Canvas x:Name="PreviewCanvas" Grid.RowSpan="2" ZIndex="45">
            <Border x:Name="DropIndicator" IsVisible="False" Height="2"
                    Background="#7EA6F2" CornerRadius="1"
                    BoxShadow="0 0 6 0 #667EA6F2"
                    IsHitTestVisible="False" />
            <Border x:Name="SessionPreviewCard" IsVisible="False" Width="318"
                    Background="#202022" CornerRadius="12" Padding="8,5,6,8"
                    BoxShadow="0 10 28 0 #14000000" Opacity="0"
                    PointerEntered="OnPreviewCardPointerEntered"
                    PointerExited="OnPreviewCardPointerExited"
                    x:CompileBindings="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#E3E4E6" TextWrapping="NoWrap" MaxWidth="210"
                                       TextTrimming="CharacterEllipsis" LineHeight="20" />
                            <Path Width="12" Height="12" Data="{StaticResource MonitorIcon}" Stretch="Uniform"
                                  Stroke="{StaticResource SidebarLabel}" StrokeThickness="1.2"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" Margin="0,1,0,0" ToolTip.Tip="本地项目" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding RelativeLabel}" FontSize="11.5"
                                   Foreground="#7C7C7E" VerticalAlignment="Center" Margin="0,1,0,0" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Path Width="12" Height="12" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                              Stroke="{StaticResource SidebarLabel}" StrokeThickness="1.25"
                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Workspace.Name}" FontSize="12.5"
                                   Foreground="#BDBEC1" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="WorkspacePreviewCard" IsVisible="False" Width="318"
                    Background="#202022" CornerRadius="12" Padding="8,5,6,8"
                    BoxShadow="0 10 28 0 #14000000" Opacity="0"
                    PointerEntered="OnPreviewCardPointerEntered"
                    PointerExited="OnPreviewCardPointerExited"
                    x:CompileBindings="False">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                    </Transitions>
                </Border.Transitions>
                <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                        <Path Width="14" Height="14" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                              Stroke="{StaticResource SidebarText}" StrokeThickness="1.3"
                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                              VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#E3E4E6"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                        <Path Grid.Column="2" Width="13" Height="13" Data="{StaticResource PinIcon}"
                              Stretch="Uniform" IsVisible="{Binding IsPinned}"
                              Stroke="{StaticResource SidebarTextHover}" StrokeThickness="1.3"
                              StrokeLineCap="Round" StrokeJoin="Round"
                              Fill="{StaticResource SidebarTextHover}"
                              RenderTransform="rotate(45deg)" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                            <Path Width="13" Height="13" Data="{StaticResource ClockIcon}" Stretch="Uniform"
                                  Stroke="{StaticResource SidebarLabel}" StrokeThickness="1.25"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ChatCountLabel}" FontSize="12"
                                       Foreground="{StaticResource SidebarLabel}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                            <Path Width="13" Height="13" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                  Stroke="{StaticResource SidebarLabel}" StrokeThickness="1.25"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12"
                                       Foreground="{StaticResource SidebarLabel}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                            <Path Width="13" Height="13" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                  Stroke="{StaticResource SidebarLabel}" StrokeThickness="1.25"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ParentPath}" FontSize="12"
                                       Foreground="{StaticResource SidebarLabel}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource LineStrong}" />
                    <Button Classes="row" Height="28" Padding="7,0" CornerRadius="6"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="OnWorkspaceEditClicked">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                            <Path Width="13" Height="13" Data="{StaticResource SettingsIcon}" Stretch="Uniform"
                                  Stroke="{StaticResource SidebarText}" StrokeThickness="1.25"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="编辑项目" FontSize="12"
                                       Foreground="{StaticResource SidebarText}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- ===================== Command palette (Codex search) ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsSearchPaletteOpen}" Background="Transparent" ZIndex="55"
              PointerPressed="OnPaletteBackdropPressed">
            <Border Width="768" MaxHeight="560" Margin="0,147,0,0" Classes="overlay-card"
                    Classes.open="{Binding IsSearchPaletteOpen}"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Background="#0F0F10" BorderBrush="#1E1E20" BorderThickness="1"
                    CornerRadius="12" BoxShadow="0 20 48 0 #B3000000">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" Height="52" ColumnDefinitions="*,Auto" Margin="16,0,12,0">
                        <TextBox x:Name="PaletteSearchBox" Grid.Column="0" Classes="search"
                                 Background="Transparent" BorderThickness="0" FontSize="14"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="搜索聊天或运行命令"
                                 KeyDown="OnPaletteSearchKeyDown" />

                    </Grid>
                    <Border Grid.Row="1" Height="1" Background="#1E1E20" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,6,8,8">
                            <StackPanel IsVisible="{Binding ShowPaletteActions}">
                                <TextBlock Text="快捷操作" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                           Margin="8,6,0,6" />
                                <Button Classes="palette-row" Click="OnPaletteNewChatClicked">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <Path Width="15" Height="15" Data="{StaticResource EditIcon}" Stretch="Uniform" />
                                        <TextBlock Grid.Column="1" Text="新聊天" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Background="#2D2D2E" CornerRadius="5" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="Ctrl+N" FontSize="10.5" Foreground="#B7B8BA" /></Border>
                                    </Grid>
                                </Button>
                                <Button Classes="palette-row" Click="OnPaletteOpenFolderClicked">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                        <Path Width="15" Height="15" Data="{StaticResource FolderIcon}" Stretch="Uniform" />
                                        <TextBlock Grid.Column="1" Text="打开文件夹" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Background="#2D2D2E" CornerRadius="5" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="Ctrl+O" FontSize="10.5" Foreground="#B7B8BA" /></Border>
                                    </Grid>
                                </Button>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding ShowPaletteChats}">
                                <TextBlock Text="最近聊天" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                           Margin="8,12,0,0" />
                                <ItemsControl ItemsSource="{Binding PaletteSessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SessionItemViewModel">
                                            <Button Classes="palette-row" Click="OnPaletteSessionClicked" Tag="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                    <Ellipse Width="11" Height="11" Stroke="#8E8F91"
                                                             StrokeThickness="1.4" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Workspace.Name}" FontSize="11"
                                                               Foreground="{StaticResource TextCaption}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel IsVisible="{Binding ShowPaletteFiles}">
                                <TextBlock Text="文件" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                           Margin="8,12,0,6" />
                                <ItemsControl ItemsSource="{Binding PaletteFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PaletteFileGroupViewModel">
                                            <Button Classes="palette-row" Click="OnPaletteFileClicked"
                                                    Tag="{Binding}" ToolTip.Tip="插入文件引用">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                    <Path Width="14" Height="14" Data="{StaticResource FolderIcon}"
                                                          Stretch="Uniform" />
                                                    <controls:HighlightTextBlock Grid.Column="1"
                                                                                 Text="{Binding Name}" FontSize="13"
                                                                                 HighlightQuery="{Binding Query}"
                                                                                 TextTrimming="CharacterEllipsis"
                                                                                 TextWrapping="NoWrap"
                                                                                 VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Folder}" FontSize="11"
                                                               Foreground="{StaticResource TextCaption}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding ShowPaletteText}">
                                <TextBlock Text="文本" FontSize="11.5" Foreground="{StaticResource TextTertiary}"
                                           Margin="8,12,0,6" />
                                <ItemsControl ItemsSource="{Binding PaletteTextMatches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PaletteFileGroupViewModel">
                                            <StackPanel Spacing="1" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                                      Margin="10,6,10,4">
                                                    <Path Width="13" Height="13"
                                                          Data="{StaticResource FolderIcon}" Stretch="Uniform" />
                                                    <TextBlock Grid.Column="1" Text="{Binding RelativePath}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock Grid.Column="2" Text="{Binding CountLabel}"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource TextCaption}" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Lines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:PaletteLineViewModel">
                                                            <Button Classes="palette-row"
                                                                    Click="OnPaletteTextLineClicked"
                                                                    Tag="{Binding}" ToolTip.Tip="插入文件引用">
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                    <TextBlock Text="{Binding LineLabel}"
                                                                               FontSize="11" Width="34"
                                                                               TextAlignment="Right"
                                                                               FontFamily="Cascadia Mono, Consolas"
                                                                               Foreground="{StaticResource TextCaption}"
                                                                               VerticalAlignment="Center" />
                                                                    <controls:HighlightTextBlock Grid.Column="1"
                                                                               Text="{Binding Text}"
                                                                               HighlightQuery="{Binding Query}"
                                                                               FontSize="12"
                                                                               FontFamily="Cascadia Mono, Consolas"
                                                                               Foreground="{StaticResource TextSecondary}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               TextWrapping="NoWrap"
                                                                               VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="{Binding PaletteEmptyText}" IsVisible="{Binding ShowPaletteEmpty}"
                                       FontSize="12.5" Foreground="{StaticResource TextTertiary}"
                                       Margin="8,16,0,20" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="3" Background="#111011" BorderBrush="#1E1E20" BorderThickness="0,1,0,0">
                    <Grid Height="42" ColumnDefinitions="Auto,*" Margin="14,0,14,0">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="filter" Classes.active="{Binding IsPaletteFilterAll}"
                                    Click="OnPaletteFilterClicked" Tag="all" Content="All" />
                            <Button Classes="filter" Classes.active="{Binding IsPaletteFilterActions}"
                                    Click="OnPaletteFilterClicked" Tag="actions" Content="Actions" />
                            <Button Classes="filter" Classes.active="{Binding IsPaletteFilterChats}"
                                    Click="OnPaletteFilterClicked" Tag="chats" Content="Chats" />
                            <Button Classes="filter" Classes.active="{Binding IsPaletteFilterFiles}"
                                    Click="OnPaletteFilterClicked" Tag="files" Content="Files" />
                            <Button Classes="filter" Classes.active="{Binding IsPaletteFilterText}"
                                    Click="OnPaletteFilterClicked" Tag="text" Content="Text" />
                        </StackPanel>
                    </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Approval overlay ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsApprovalOpen}" Background="#99000000" ZIndex="60">
            <Border MinWidth="420" MaxWidth="560" Margin="24,0"
                    Background="{StaticResource CardFill}" BorderBrush="{StaticResource LineStrong}"
                    BorderThickness="1" CornerRadius="16" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="工具调用审批" FontSize="12" Foreground="{StaticResource TextCaption}" />
                        <TextBlock Text="{Binding ApprovalTitle}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Text="动作" FontSize="12" Foreground="{StaticResource TextTertiary}" />
                        <TextBlock Grid.Column="1" Text="{Binding ApprovalAction}" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="资源" FontSize="12"
                                   Foreground="{StaticResource TextTertiary}" />
                        <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ApprovalResource}"
                                             FontSize="12" Foreground="{StaticResource TextSecondary}"
                                             TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="原因" FontSize="12"
                                   Foreground="{StaticResource TextTertiary}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ApprovalReason}" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                    </Grid>
                    <StackPanel Spacing="6" IsVisible="{Binding HasApprovalArgs}">
                        <TextBlock Text="参数" FontSize="12" Foreground="{StaticResource TextTertiary}" />
                        <Border Background="{StaticResource ToolCardFill}" CornerRadius="8" Padding="10,8"
                                MaxHeight="170">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <SelectableTextBlock Text="{Binding ApprovalArgs}" FontSize="11"
                                                     Foreground="{StaticResource TextSecondary}"
                                                     TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button x:Name="ApprovalDenyButton" Classes="subtle" Click="OnApprovalDenyClicked"
                                Content="拒绝" />
                        <Button x:Name="ApprovalSessionAllowButton" Classes="secondary"
                                Click="OnApprovalAllowSessionClicked" Content="本会话允许" />
                        <Button x:Name="ApprovalAllowButton" Classes="primary" Click="OnApprovalAllowClicked"
                                Content="允许一次" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Rename / edit project dialog ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsRenameDialogOpen}" Background="#99000000" ZIndex="60">
            <Border Width="508" Classes="overlay-card" Classes.open="{Binding IsRenameDialogOpen}"
                    Background="#1F1F21"
                    BorderBrush="#2E2E31" BorderThickness="1"
                    CornerRadius="16" Padding="24"
                    BoxShadow="0 24 60 0 #A0000000"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding RenameDialogTitle}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#E3E4E6" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Width="28" Height="28"
                                Click="OnCloseDialogClicked">
                            <Path Width="12" Height="12" Data="{StaticResource CloseIcon}"
                                  Stretch="Uniform" Stroke="#7E7F82" StrokeThickness="1.4" />
                        </Button>
                    </Grid>
                    <Border Background="#141416" BorderBrush="#34343A" BorderThickness="1"
                            CornerRadius="8" Height="42" Padding="10,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Path Width="16" Height="16" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                  Stroke="#7E7F82" StrokeThickness="1.3" StrokeLineCap="Round"
                                  StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center" />
                            <TextBox x:Name="RenameBox" Grid.Column="1" Classes="dialog-plain"
                                     Text="{Binding RenameTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnRenameKeyDown" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Spacing="8" IsVisible="{Binding IsEditingWorkspace}">
                        <TextBlock Text="源文件夹" FontSize="12.5" Foreground="#7E7F82" />
                        <Border Background="#17171A" BorderBrush="#2E2E31" BorderThickness="1"
                                CornerRadius="10" Padding="6">
                            <StackPanel>
                                <Grid Height="34" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                      Margin="6,0">
                                    <Path Width="14" Height="14" Data="{StaticResource FolderIcon}"
                                          Stretch="Uniform" Stroke="#C6C7C9" StrokeThickness="1.3"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                          VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding RenameSourcePath}" FontSize="13"
                                               Foreground="#C6C7C9" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <Border Grid.Column="2" Background="#2E2E31" CornerRadius="6"
                                            Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock Text="主要" FontSize="11" Foreground="#C6C7C9" />
                                    </Border>
                                </Grid>
                                <Button Classes="more-menu-item" Height="34" Click="OnEditProjectAddFolderClicked">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="6,0">
                                        <Path Width="14" Height="14" Data="{StaticResource FolderIcon}"
                                              Stretch="Uniform" Stroke="#7E7F82" StrokeThickness="1.3"
                                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                              VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="添加文件夹" FontSize="13"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Button Classes="danger" HorizontalAlignment="Left"
                                IsVisible="{Binding IsEditingWorkspace}"
                                Click="OnRemoveWorkspaceFromDialogClicked"
                                Content="移除本地项目" />
                        <Button Grid.Column="1" Classes="subtle" Click="OnCloseDialogClicked"
                                Content="取消" />
                        <Button Grid.Column="2" Classes="save-light" Click="OnConfirmRenameClicked"
                                Content="保存" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Create project dialog ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsCreateProjectDialogOpen}" Background="#80000000"
              ZIndex="60">
            <Border Width="508" Classes="overlay-card" Classes.open="{Binding IsCreateProjectDialogOpen}"
                    Background="#1F1F21"
                    BorderBrush="#2E2E31" BorderThickness="1"
                    CornerRadius="16" Padding="24"
                    BoxShadow="0 24 60 0 #A0000000"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="创建项目" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#E3E4E6" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Width="28" Height="28"
                                Click="OnCreateProjectCancelClicked">
                            <Path Width="12" Height="12" Data="{StaticResource CloseIcon}"
                                  Stretch="Uniform" Stroke="#7E7F82" StrokeThickness="1.4" />
                        </Button>
                    </Grid>
                    <Border Background="#141416" BorderBrush="#34343A" BorderThickness="1"
                            CornerRadius="8" Height="42" Padding="10,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Path Width="16" Height="16" Data="{StaticResource FolderIcon}" Stretch="Uniform"
                                  Stroke="#7E7F82" StrokeThickness="1.3" StrokeLineCap="Round"
                                  StrokeJoin="Round" Fill="Transparent" VerticalAlignment="Center" />
                            <TextBox x:Name="ProjectNameBox" Grid.Column="1" Classes="dialog-plain"
                                     Text="{Binding ProjectNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="项目名称" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Spacing="8">
                        <TextBlock Text="源文件夹" FontSize="12.5" Foreground="#7E7F82" />
                        <Border Background="#17171A" BorderBrush="#2E2E31" BorderThickness="1"
                                CornerRadius="10" Height="104">
                            <StackPanel Spacing="10" VerticalAlignment="Center">
                                <Button Classes="subtle" Padding="10,4"
                                        HorizontalAlignment="Center" Click="OnCreateProjectBrowseClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="在此电脑上添加文件夹" FontSize="13.5"
                                                   Foreground="#C6C7C9" VerticalAlignment="Center" />
                                        <Path Width="10" Height="10" Data="{StaticResource ChevronDownIcon}"
                                              Stretch="Uniform" Stroke="#7E7F82" StrokeThickness="1.4"
                                              VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="secondary" Height="30" Padding="12,0"
                                        HorizontalAlignment="Center" Click="OnCreateProjectBrowseClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Width="13" Height="13" Data="{StaticResource FolderIcon}"
                                              Stretch="Uniform" Stroke="#C6C7C9" StrokeThickness="1.3"
                                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="添加" FontSize="12.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding ProjectSourcePath}"
                                   IsVisible="{Binding HasProjectSourcePath}"
                                   FontSize="11.5" Foreground="#7E7F82"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="subtle" Content="取消" Click="OnCreateProjectCancelClicked" />
                        <Button Classes="primary" Content="创建项目"
                                IsEnabled="{Binding CanCreateProject}"
                                Click="OnCreateProjectConfirmClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Automation dialog ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsAutomationDialogOpen}" Background="#99000000"
              ZIndex="60">
            <Border Width="520" Classes="overlay-card" Classes.open="{Binding IsAutomationDialogOpen}"
                    Background="{StaticResource CardFill}"
                    BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="16" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding AutomationDialogTitle}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="任务名称" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBox x:Name="AutomationNameBox" Classes="field"
                                 Text="{Binding AutomationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="例如：每日项目摘要" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="发送给模型的指令" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBox Classes="field" MinHeight="130" MaxHeight="220"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Text="{Binding AutomationPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="检查当前工作区并总结今天需要处理的事项。" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="运行间隔" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" />
                        <ComboBox Classes="field" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding AutomationIntervals}"
                                  SelectedItem="{Binding SelectedAutomationInterval, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AutomationDialogStatus}" FontSize="11" Foreground="#E6A0A0"
                               IsVisible="{Binding HasAutomationDialogStatus}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="subtle" Click="OnCloseDialogClicked" Content="取消" />
                        <Button Classes="primary" Click="OnSaveAutomationClicked" Content="保存任务" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Automation delete dialog ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsAutomationDeleteDialogOpen}" Background="#99000000"
              ZIndex="60">
            <Border Width="420" Classes="overlay-card" Classes.open="{Binding IsAutomationDeleteDialogOpen}"
                    Background="{StaticResource CardFill}"
                    BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="16" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="7">
                        <TextBlock Text="删除自动化任务" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="{Binding AutomationDeletePrompt}" FontSize="12"
                                   Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="subtle" Click="OnCloseDialogClicked" Content="取消" />
                        <Button Classes="danger" Click="OnConfirmDeleteAutomationClicked" Content="删除" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Cleanup old chats dialog ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsCleanupDialogOpen}" Background="#99000000" ZIndex="60">
            <Border Width="560" MaxHeight="560" Background="{StaticResource CardFill}"
                    BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="16" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="7">
                        <TextBlock Text="清理旧聊天" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="30 天前没有活动的聊天。删除后无法恢复。"
                                   FontSize="12" Foreground="{StaticResource TextTertiary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CleanupSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SessionItemViewModel">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding UpdatedLabel}" FontSize="11"
                                                       Foreground="{StaticResource TextCaption}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="danger" Content="删除"
                                                Click="OnCleanupDeleteClicked" Tag="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="没有 30 天前未活动的聊天"
                               IsVisible="{Binding !HasCleanupSessions}"
                               FontSize="12.5" Foreground="{StaticResource TextCaption}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="subtle" Click="OnCloseCleanupDialogClicked" Content="关闭" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Close window confirmation ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsCloseConfirmOpen}" Background="#99000000" ZIndex="60">
            <Border Width="420" Background="{StaticResource CardFill}"
                    BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="16" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="7">
                        <TextBlock Text="关闭 KL？" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="关闭窗口会停止正在运行的回合，并断开与 KL Core 的连接。"
                                   FontSize="12" Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="subtle" Click="OnCancelCloseClicked" Content="取消" />
                        <Button Classes="danger" Click="OnConfirmCloseClicked" Content="关闭" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Delete session dialog ===================== -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsDeleteDialogOpen}" Background="#99000000" ZIndex="60">
            <Border Width="420" Background="{StaticResource CardFill}"
                    BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="16" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="7">
                        <TextBlock Text="删除会话" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="{Binding DeletePrompt}" FontSize="12"
                                   Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="subtle" Click="OnCloseDialogClicked" Content="取消" />
                        <Button Classes="danger" Click="OnConfirmDeleteClicked" Content="删除" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- AGENTS.md editor -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsAgentsEditorOpen}" Background="#99000000" ZIndex="60">
            <Border Width="640" Background="{StaticResource CardFill}"
                    BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="16" Padding="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="AGENTS.md" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="{Binding AgentsEditorHint}"
                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox Classes="field" MinHeight="240" MaxHeight="360"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                             Text="{Binding AgentsDraft, Mode=TwoWay}" />
                    <TextBlock Text="{Binding AgentsPathText}" FontSize="11"
                               FontFamily="Cascadia Mono, Consolas"
                               Foreground="{StaticResource TextCaption}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AgentsStatus}" IsVisible="{Binding HasAgentsStatus}"
                               FontSize="12" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="subtle" Click="OnCloseAgentsEditorClicked" Content="取消" />
                        <Button Classes="primary" Click="OnSaveAgentsClicked" Content="保存" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- settings detail sheet for UI-only rows -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsSettingsDetailOpen}" Background="#99000000" ZIndex="60" PointerPressed="OnSettingsDetailBackdropPressed">
            <Border Width="520" Classes="overlay-card" Classes.open="{Binding IsSettingsDetailOpen}"
                    Background="{StaticResource CardFill}" BorderBrush="{StaticResource LineStrong}"
                    BorderThickness="1" CornerRadius="16" Padding="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding SettingsDetailTitle}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SettingsDetailBody}" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                   LineHeight="19" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="primary" Click="OnCloseSettingsDetailClicked" Content="关闭" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
