{
  "id": "wasm-tool",
  "version": "0.1.0",
  "api": 1,
  "kind": "tool",
  "entrypoint": "tool.wat",
  "runtime": "wasm",
  "capabilities": ["tool"],
  "permissions": {
    "network": [],
    "env": [],
    "fs_read": [],
